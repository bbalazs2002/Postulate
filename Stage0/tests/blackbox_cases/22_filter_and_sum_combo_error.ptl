PROGRAM
function sum_positives(arr: int32[5]) : int32 {
  mut buf: int32[5] := {0, 0, 0, 0, 0;
  mut count: int32 := 0;
  mut i: int32 := 0;
  mut total: int32 := 0;
  mut j: int32 := 0;
  while (i < 5) {
    if (arr[i] > 0) {
      buf[count] := arr[i];
      count := count + 1;
    }
    i := i + 1;
  }
  while (j < count) {
    total := total + buf[j];
    j := j + 1;
  }
  return total;
}
