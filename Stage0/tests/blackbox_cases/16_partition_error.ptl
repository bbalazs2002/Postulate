PROGRAM
function partition_by_sign(arr: int32[6], pos: *(int32[6]), pos_count: *int32, neg: *(int32[6]), neg_count: *int32) : void {
  mut i: int32 := 0;
  mut p: int32 := 0;
  mut n: int32 := 0;
  while (i < 6) {
    if (arr[i] > 0) {
      *pos)[p] := arr[i];
      p := p + 1;
    } else {
      (*neg)[n] := arr[i];
      n := n + 1;
    }
    i := i + 1;
  }
  *pos_count := p;
  *neg_count := n;
}
