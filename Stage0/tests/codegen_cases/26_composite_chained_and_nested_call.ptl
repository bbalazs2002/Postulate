struct Pair { a: int32; b: int32; }

function make_pair(x: int32, y: int32) : Pair {
  return Pair { a := x, b := y };
}

function sum_pair(p: Pair) : int32 {
  return p.a + p.b;
}

function main() : int32 {
  mut direct: int32 := make_pair(3, 4).a;
  mut nested: int32 := sum_pair(make_pair(10, 20));
  return direct + nested;
}
