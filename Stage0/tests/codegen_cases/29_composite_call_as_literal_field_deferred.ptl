struct Point { x: int32; y: int32; }
struct Line { start: Point; end: Point; }

function make_point(x: int32, y: int32) : Point {
  return Point { x := x, y := y };
}

function main() : int32 {
  mut l: Line := Line { start := make_point(1, 2), end := Point { x := 3, y := 4 } };
  return l.start.x;
}
