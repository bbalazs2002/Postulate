{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "postulate",
      "camelcase": "Postulate",
      "title": "Postulate",
      "scope": "source.postulate",
      "file-types": [
        "ptl"
      ],
      "injection-regex": "^postulate$",
      "class-name": "TreeSitterPostulate"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Postulate programming language",
    "authors": [
      {
        "name": "Balthes Balazs",
        "email": "balthes.balazs@gmail.com",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/bbalazs2002/Postulate/tree/main/tree-sitter",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}