#!/usr/bin/env bash
# The Edsger compiler CLI -- the v1 analogue of Hoare/hoare: one command
# instead of the manual pipeline (build/codegen -> llc -> ld) scripts/
# run_codegen_tests.sh drives internally. Parses, checks, and generates
# LLVM IR from a single `.ptl` file, assembles it with `llc`, and links
# it with `ld` into a runnable ELF binary -- gen_start/gen_syscall_
# extern (codegen.ptl) emit a real `_start` entry point and working
# syscall wrappers for the twelve whitelisted `extern function`s
# (postulate_v1_language_reference.md SS5.2), exactly the piece an
# earlier version of this script had to leave out (docs/postulate_
# stage1_bootstrap_plan.md's own "Tracked checkpoint: extern/syscall
# calls and `_start`" covers the technique in full, now implemented).
#
# Requires `llc` and `ld` on PATH (Ubuntu's `llvm`/`binutils` packages,
# same as Edsger/Dockerfile already installs) and build/codegen already
# built (see scripts/build.sh) -- same requirement shape as every other
# script in this repository. Run this from inside the Docker image (or
# an equivalent Linux toolchain), not directly on a Windows host.
set -uo pipefail

# readlink -f resolves through a symlink (e.g. /usr/local/bin/edsger ->
# /opt/edsger/edsger in the release image, see Dockerfile.release) to
# the real script path, so build/codegen is still found relative to
# where this file actually lives, not wherever it was invoked from --
# same reasoning as hoare's own SCRIPT_PATH/SCRIPT_DIR lines.
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
CODEGEN="$SCRIPT_DIR/build/codegen"

usage() {
    echo "usage: $(basename "$0") <file.ptl> [-o <output>] [--emit-llvm | -c]" >&2
    echo "  -o <output>     output path (default: <file> with .ptl stripped)" >&2
    echo "  --emit-llvm     stop after codegen and write the emitted LLVM IR text itself (output defaults to .ll)" >&2
    echo "  -c              stop after assembling to a native object file, don't link (output defaults to .o)" >&2
}

input=""
output=""
emit_llvm=0
obj_only=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --emit-llvm)
            emit_llvm=1
            shift
            ;;
        -c)
            obj_only=1
            shift
            ;;
        -o)
            if [[ $# -lt 2 ]]; then
                echo "edsger: -o requires an argument" >&2
                usage
                exit 64
            fi
            output="$2"
            shift 2
            ;;
        -*)
            echo "edsger: unrecognized option '$1'" >&2
            usage
            exit 64
            ;;
        *)
            if [[ -n "$input" ]]; then
                echo "edsger: only one input file may be given (already have '$input', got '$1')" >&2
                usage
                exit 64
            fi
            input="$1"
            shift
            ;;
    esac
done

if [[ -z "$input" ]]; then
    echo "edsger: no input file given" >&2
    usage
    exit 64
fi
if [[ ! -f "$input" ]]; then
    echo "edsger: no such file: $input" >&2
    exit 64
fi
if [[ "$emit_llvm" -eq 1 && "$obj_only" -eq 1 ]]; then
    echo "edsger: --emit-llvm and -c are mutually exclusive" >&2
    usage
    exit 64
fi
if [[ ! -x "$CODEGEN" ]]; then
    echo "edsger: $CODEGEN not found -- build it first (see scripts/build.sh)" >&2
    exit 64
fi

if [[ -z "$output" ]]; then
    base=$(basename -- "$input")
    if [[ "$base" == *.ptl ]]; then
        base="${base%.ptl}"
    fi
    if [[ "$emit_llvm" -eq 1 ]]; then
        output="${base}.ll"
    elif [[ "$obj_only" -eq 1 ]]; then
        output="${base}.o"
    else
        output="$base"
    fi
fi

workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT

"$CODEGEN" < "$input" > "$workdir/out.ll" 2> "$workdir/codegen.err"
codegen_code=$?
if [[ "$codegen_code" -ne 0 ]]; then
    cat "$workdir/codegen.err" >&2
    exit "$codegen_code"
fi

if [[ "$emit_llvm" -eq 1 ]]; then
    cp "$workdir/out.ll" "$output"
    exit 0
fi

# -mtriple given explicitly, not baked into the emitted `.ll`, so the
# emitted text itself stays independent of whichever LLVM version's own
# default datalayout string happens to be current (postulate_stage1_
# bootstrap_plan.md's own "Tracked checkpoint" section explains this
# choice in full).
if ! llc -filetype=obj -mtriple=x86_64-unknown-linux-gnu -o "$workdir/out.o" "$workdir/out.ll" 2> "$workdir/llc.err"; then
    echo "edsger: internal error -- llc rejected the generated LLVM IR (this is an Edsger bug, please report it):" >&2
    cat "$workdir/llc.err" >&2
    exit 5
fi

if [[ "$obj_only" -eq 1 ]]; then
    cp "$workdir/out.o" "$output"
    exit 0
fi

if ! ld -static -no-pie -e _start -o "$output" "$workdir/out.o" 2> "$workdir/ld.err"; then
    echo "edsger: ld failed to link the generated object:" >&2
    cat "$workdir/ld.err" >&2
    echo "edsger: note -- linking needs a \`main\` function somewhere in the compiled program (gen_start only emits \`_start\` for the file that declares it); a library-only \`.ptl\` with no \`main\` should be compiled with -c instead" >&2
    exit 6
fi

chmod +x "$output"
