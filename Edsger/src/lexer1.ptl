                } else {
                 if (lo.tok.kind == 247) {
                   err_pos := append_str_e(&err_buf, err_pos, &err_unterm_str, 47);
                   err_pos := append_str_e(&err_buf, err_pos, &err_at_line_bare, 9);
                 } else {
                  err_pos := append_str_e(&err_buf, err_pos, &err1_a, 33);
                  err_pos := append_byte_e(&err_buf, err_pos, err_byte);
                  err_pos := append_str_e(&err_buf, err_pos, &err1_c, 5);
                  err_pos := append_hex_byte_e(&err_buf, err_pos, err_byte);
                  err_pos := append_str_e(&err_buf, err_pos, &err_at_line, 10);
                 }
                }
              }
            }
          }
        }
      }
      err_pos := append_uint_e(&err_buf, err_pos, lc.line);
      err_pos := append_str_e(&err_buf, err_pos, &err_col, 6);
      err_pos := append_uint_e(&err_buf, err_pos, lc.col);
      err_pos := append_str_e(&err_buf, err_pos, &err_byteoff, 14);
      err_pos := append_uint_e(&err_buf, err_pos, lo.tok.offset);
      err_pos := append_str_e(&err_buf, err_pos, &err_close_nl, 2);
      wrote_ok := write_all_small(2, &err_buf, err_pos);
    }
  }

  sys_exit(exit_code);
  return 0;
}
