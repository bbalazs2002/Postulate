// Edsger -- lexer module, v1.0.6 (see docs/postulate_stage1_bootstrap_plan.md
// and docs/postulate_stage1_v1_0_6_edsger_design.md, "Module 1: Lexer").
// Written in Postulate v0 (plus this step's own additions: `char`
// literals/escapes and the `as`/`use`/`namespace`/`verified`/
// `unverified`/`@autoload` keywords), compiled by Hoare (Stage 0).
//
// This is a clean module, not an edit of Stage1/src/lexer.ptl (the
// retired proof of concept): it drops that file's entire `#include`
// resolution machinery (FileTable/ResolveState/discover-order-emit) --
// namespace/`use`/`@autoload` resolution is Module 3's job now
// (postulate_v1_language_reference.md §6.2c), never the lexer's, so
// this module tokenizes exactly **one** buffer of source text, read
// whole from stdin, with no file-opening of its own at all. Multi-file
// orchestration (lexing each `use`d file in turn) is the semantic
// analyzer's responsibility, calling this module once per file.
//
// I/O model: reads the whole program from stdin, writes one line per
// token to stdout (dump format below), and on a lexical error writes a
// diagnostic to stderr and exits 1 -- same shape the proof of concept
// used for its own single-file case, since that's now the *only* case
// this module ever handles.
//
// Token-kind numbering is this file's own -- there is no requirement to
// match Stage1/src/lexer.ptl's numbers (that scheme existed to mirror
// Hoare's own tokens.inc for cross-validation, which doesn't apply to
// genuinely new tokens Hoare has never seen). The dump format prints
// text labels, never raw kind numbers, so the numbers below are purely
// internal:
//   0-4     special/literals: EOF, IDENT, INT, CHAR, STRING (the last is
//           `pure_string_literal`, the quoted `pattern_string`/
//           `path_string` operands `@autoload` takes, reference
//           §1.5/§6.2b/§9 -- raw content, no escape processing at all;
//           the reference also names a second, escape-carrying
//           `string_literal` for a future general string type, but
//           nothing accepts one yet, so this lexer never needs to look
//           for one)
//   10-40   keywords (the 24 v0 keywords, unchanged in spirit, plus six
//           new ones this step adds: as, use, char, verified,
//           unverified, namespace -- and `@autoload`, lexed as a single
//           keyword-like token, matching the language reference's own
//           grammar, which spells it `"@autoload"` as one terminal)
//   50-60   punctuation (the 10 v0 punctuation marks, plus `\`, the
//           namespace/`use` path separator, postulate_v1_language_
//           reference.md §1.6/§6.2)
//   70-89   operators (all 20 already exist in v0; pointer arithmetic,
//           §2.5 of the reference, needs no new operator token, only new
//           type rules the semantic analyzer enforces)
//   247-254 errors, one kind per distinct cause (see main()'s dispatch)
//
// Buffer sizes: stack-local only (v0 has no static/global storage) --
// 64 KiB source is generous for one file at this bootstrap stage (this
// module never sees a whole merged multi-file program the way the
// retired proof of concept's `#include` splice did); 128 KiB output.

extern function sys_read(fd: int64, buf: *uint8, count: uint64) : int64;
extern function sys_write(fd: int64, buf: *uint8, count: uint64) : int64;
extern function sys_exit(code: int64) : void;

struct Token {
  kind : int32;
  offset : uint64;
  length : uint64;
}

struct TriviaResult {
  cursor : uint64;
  had_error : bool;
  comment_start : uint64;
}

struct NumberResult {
  cursor : uint64;
  had_error : bool;
  error_at : uint64;
}

// err_kind: 1 unterminated, 2 empty (''), 3 unknown escape, 4 more than
// one character before the closing quote.
struct CharLitResult {
  cursor : uint64;
  had_error : bool;
  err_kind : int32;
  error_at : uint64;
}

struct StringLitResult {
  cursor : uint64;
  had_error : bool;
}

struct LexOutcome {
  tok : Token;
  cursor : uint64;
}

struct LineCol {
  line : uint64;
  col : uint64;
}

// ---------------------------------------------------------------------
// Byte classification
// ---------------------------------------------------------------------

function is_digit(b: uint8) : bool {
  return b >= 48 && b <= 57;
}

function is_hex_digit(b: uint8) : bool {
  return (b >= 48 && b <= 57) || (b >= 97 && b <= 102) || (b >= 65 && b <= 70);
}

function is_alpha(b: uint8) : bool {
  return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95;
}

function is_alnum(b: uint8) : bool {
  return is_alpha(b) || is_digit(b);
}

function is_ws(b: uint8) : bool {
  return b == 32 || b == 9 || b == 13 || b == 10;
}

// ---------------------------------------------------------------------
// Trivia: whitespace + line/block comments -- unchanged from the proof
// of concept, since comment syntax itself doesn't change in v1.0.6.
// ---------------------------------------------------------------------

function skip_trivia(src: *(uint8[65536]), start: uint64, len: uint64) : TriviaResult {
  mut cursor : uint64 := start;
  mut looping : bool := true;
  mut had_error : bool := false;
  mut comment_start : uint64 := 0;
  mut b : uint8 := 0;
  mut b2 : uint8 := 0;
  mut inner_looping : bool := true;
  mut terminated : bool := false;

  while (looping) {
    if (cursor >= len) {
      looping := false;
    } else {
      b := (*src)[cursor];
      if (is_ws(b)) {
        cursor := cursor + 1;
      } else {
        if (b == 47) { // 47 = '/'
          if (cursor + 1 >= len) {
            looping := false;
          } else {
            b2 := (*src)[cursor + 1];
            if (b2 == 47) {
              cursor := cursor + 2;
              inner_looping := true;
              while (inner_looping) {
                if (cursor >= len) {
                  inner_looping := false;
                } else {
                  if ((*src)[cursor] == 10) { // 10 = '\n'
                    cursor := cursor + 1;
                    inner_looping := false;
                  } else {
                    cursor := cursor + 1;
                  }
                }
              }
            } else {
              if (b2 == 42) {
                comment_start := cursor;
                cursor := cursor + 2;
                terminated := false;
                inner_looping := true;
                while (inner_looping) {
                  if (cursor + 1 >= len) {
                    inner_looping := false;
                  } else {
                    if ((*src)[cursor] == 42 && (*src)[cursor + 1] == 47) {
                      cursor := cursor + 2;
                      terminated := true;
                      inner_looping := false;
                    } else {
                      cursor := cursor + 1;
                    }
                  }
                }
                if (!terminated) {
                  had_error := true;
                  looping := false;
                }
              } else {
                looping := false;
              }
            }
          }
        } else {
          looping := false;
        }
      }
    }
  }

  return TriviaResult { cursor := cursor, had_error := had_error, comment_start := comment_start };
}

// ---------------------------------------------------------------------
// Identifier / keyword span scanning
// ---------------------------------------------------------------------

function scan_ident_end(src: *(uint8[65536]), start: uint64, len: uint64) : uint64 {
  mut cursor : uint64 := start;
  mut looping : bool := true;

  while (looping) {
    if (cursor >= len) {
      looping := false;
    } else {
      if (is_alnum((*src)[cursor])) {
        cursor := cursor + 1;
      } else {
        looping := false;
      }
    }
  }

  return cursor;
}

// The 24 v0 keywords (unchanged) plus six new ones this step adds --
// `as`, `use`, `char`, `verified`, `unverified`, `namespace` -- matched
// the same way as the proof of concept: flat, unconditional byte
// comparison per keyword, bucketed by length, not a hand-rolled trie.
// `@autoload` is not handled here -- it starts with `@`, never a letter,
// so it can't reach an identifier scan at all; see lex_next.
function classify_word(src: *(uint8[65536]), off: uint64, len: uint64) : int32 {
  mut result : int32 := 1;

  if (len == 2) {
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 102) { result := 15; }              // if
    if ((*src)[off + 0] == 97 && (*src)[off + 1] == 115) { result := 34; }               // as
  }
  if (len == 3) {
    if ((*src)[off + 0] == 109 && (*src)[off + 1] == 117 && (*src)[off + 2] == 116) { result := 13; }  // mut
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 116) { result := 24; }  // int
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 115 && (*src)[off + 2] == 101) { result := 35; }  // use
  }
  if (len == 4) {
    if ((*src)[off + 0] == 101 && (*src)[off + 1] == 108 && (*src)[off + 2] == 115 && (*src)[off + 3] == 101) { result := 16; }  // else
    if ((*src)[off + 0] == 116 && (*src)[off + 1] == 114 && (*src)[off + 2] == 117 && (*src)[off + 3] == 101) { result := 19; }  // true
    if ((*src)[off + 0] == 110 && (*src)[off + 1] == 117 && (*src)[off + 2] == 108 && (*src)[off + 3] == 108) { result := 21; }  // null
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 116 && (*src)[off + 3] == 56) { result := 22; }   // int8
    if ((*src)[off + 0] == 98 && (*src)[off + 1] == 111 && (*src)[off + 2] == 111 && (*src)[off + 3] == 108) { result := 32; }   // bool
    if ((*src)[off + 0] == 118 && (*src)[off + 1] == 111 && (*src)[off + 2] == 105 && (*src)[off + 3] == 100) { result := 33; }  // void
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 105 && (*src)[off + 2] == 110 && (*src)[off + 3] == 116) { result := 29; }  // uint
    if ((*src)[off + 0] == 99 && (*src)[off + 1] == 104 && (*src)[off + 2] == 97 && (*src)[off + 3] == 114) { result := 36; }    // char
  }
  if (len == 5) {
    if ((*src)[off + 0] == 99 && (*src)[off + 1] == 111 && (*src)[off + 2] == 110 && (*src)[off + 3] == 115 && (*src)[off + 4] == 116) { result := 14; }  // const
    if ((*src)[off + 0] == 119 && (*src)[off + 1] == 104 && (*src)[off + 2] == 105 && (*src)[off + 3] == 108 && (*src)[off + 4] == 101) { result := 17; } // while
    if ((*src)[off + 0] == 102 && (*src)[off + 1] == 97 && (*src)[off + 2] == 108 && (*src)[off + 3] == 115 && (*src)[off + 4] == 101) { result := 20; }  // false
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 116 && (*src)[off + 3] == 49 && (*src)[off + 4] == 54) { result := 23; }   // int16
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 116 && (*src)[off + 3] == 51 && (*src)[off + 4] == 50) { result := 25; }   // int32
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 116 && (*src)[off + 3] == 54 && (*src)[off + 4] == 52) { result := 26; }   // int64
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 105 && (*src)[off + 2] == 110 && (*src)[off + 3] == 116 && (*src)[off + 4] == 56) { result := 27; }  // uint8
  }
  if (len == 6) {
    if ((*src)[off + 0] == 115 && (*src)[off + 1] == 116 && (*src)[off + 2] == 114 && (*src)[off + 3] == 117 && (*src)[off + 4] == 99 && (*src)[off + 5] == 116) { result := 11; }  // struct
    if ((*src)[off + 0] == 101 && (*src)[off + 1] == 120 && (*src)[off + 2] == 116 && (*src)[off + 3] == 101 && (*src)[off + 4] == 114 && (*src)[off + 5] == 110) { result := 12; } // extern
    if ((*src)[off + 0] == 114 && (*src)[off + 1] == 101 && (*src)[off + 2] == 116 && (*src)[off + 3] == 117 && (*src)[off + 4] == 114 && (*src)[off + 5] == 110) { result := 18; } // return
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 105 && (*src)[off + 2] == 110 && (*src)[off + 3] == 116 && (*src)[off + 4] == 49 && (*src)[off + 5] == 54) { result := 28; }   // uint16
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 105 && (*src)[off + 2] == 110 && (*src)[off + 3] == 116 && (*src)[off + 4] == 51 && (*src)[off + 5] == 50) { result := 30; }   // uint32
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 105 && (*src)[off + 2] == 110 && (*src)[off + 3] == 116 && (*src)[off + 4] == 54 && (*src)[off + 5] == 52) { result := 31; }   // uint64
  }
  if (len == 8) {
    if ((*src)[off + 0] == 102 && (*src)[off + 1] == 117 && (*src)[off + 2] == 110 && (*src)[off + 3] == 99 && (*src)[off + 4] == 116 && (*src)[off + 5] == 105 && (*src)[off + 6] == 111 && (*src)[off + 7] == 110) { result := 10; }  // function
    if ((*src)[off + 0] == 118 && (*src)[off + 1] == 101 && (*src)[off + 2] == 114 && (*src)[off + 3] == 105 && (*src)[off + 4] == 102 && (*src)[off + 5] == 105 && (*src)[off + 6] == 101 && (*src)[off + 7] == 100) { result := 37; }  // verified
  }
  if (len == 9) {
    if ((*src)[off + 0] == 110 && (*src)[off + 1] == 97 && (*src)[off + 2] == 109 && (*src)[off + 3] == 101 && (*src)[off + 4] == 115 && (*src)[off + 5] == 112 && (*src)[off + 6] == 97 && (*src)[off + 7] == 99 && (*src)[off + 8] == 101) { result := 39; }  // namespace
  }
  if (len == 10) {
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 110 && (*src)[off + 2] == 118 && (*src)[off + 3] == 101 && (*src)[off + 4] == 114 && (*src)[off + 5] == 105 && (*src)[off + 6] == 102 && (*src)[off + 7] == 105 && (*src)[off + 8] == 101 && (*src)[off + 9] == 100) { result := 38; }  // unverified
  }

  return result;
}

// ---------------------------------------------------------------------
// Number literal span scanning -- unchanged from the proof of concept.
// ---------------------------------------------------------------------

function scan_number(src: *(uint8[65536]), start: uint64, len: uint64) : NumberResult {
  mut cursor : uint64 := start;
  mut looping : bool := true;
  mut had_error : bool := false;
  mut error_at : uint64 := 0;
  mut n_pos : uint64 := 0;
  mut has_value_digit : bool := false;

  while (looping) {
    if (cursor >= len) {
      looping := false;
    } else {
      if (is_digit((*src)[cursor])) {
        cursor := cursor + 1;
      } else {
        looping := false;
      }
    }
  }

  if (cursor < len) {
    if ((*src)[cursor] == 110) {
      n_pos := cursor;
      cursor := cursor + 1;
      has_value_digit := false;
      looping := true;
      while (looping) {
        if (cursor >= len) {
          looping := false;
        } else {
          if (is_hex_digit((*src)[cursor])) {
            has_value_digit := true;
            cursor := cursor + 1;
          } else {
            looping := false;
          }
        }
      }
      if (!has_value_digit) {
        had_error := true;
        error_at := n_pos + 1;
      }
    }
  }

  return NumberResult { cursor := cursor, had_error := had_error, error_at := error_at };
}

// ---------------------------------------------------------------------
// Char literal scanning -- new in v1.0.6 (reference §1.5):
// char_literal ::= "'" (char_body | escape_seq) "'"
// escape_seq   ::= "\" ("n" | "t" | "r" | "0" | "\" | "'")
// `start` is the offset of the opening `'` itself.
// ---------------------------------------------------------------------

function scan_char_literal(src: *(uint8[65536]), start: uint64, len: uint64) : CharLitResult {
  mut cursor : uint64 := start + 1;
  mut had_error : bool := false;
  mut err_kind : int32 := 0;
  mut error_at : uint64 := start;
  mut b : uint8 := 0;
  mut b2 : uint8 := 0;
  mut body_ok : bool := false;
  mut scanning : bool := false;

  if (cursor >= len) {
    had_error := true;
    err_kind := 1;
  } else {
    b := (*src)[cursor];
    if (b == 39) {
      had_error := true;
      err_kind := 2;
      cursor := cursor + 1;
    } else {
      if (b == 10 || b == 13) {
        had_error := true;
        err_kind := 1;
      } else {
        if (b == 92) {
          if (cursor + 1 >= len) {
            had_error := true;
            err_kind := 1;
          } else {
            b2 := (*src)[cursor + 1];
            if (b2 == 110 || b2 == 116 || b2 == 114 || b2 == 48 || b2 == 92 || b2 == 39) {
              cursor := cursor + 2;
              body_ok := true;
            } else {
              had_error := true;
              err_kind := 3;
              error_at := cursor;
              cursor := cursor + 2;
            }
          }
        } else {
          cursor := cursor + 1;
          body_ok := true;
        }
      }
    }

    if (!had_error && body_ok) {
      if (cursor >= len) {
        had_error := true;
        err_kind := 1;
      } else {
        if ((*src)[cursor] == 39) {
          cursor := cursor + 1;
        } else {
          if ((*src)[cursor] == 10) {
            had_error := true;
            err_kind := 1;
          } else {
            had_error := true;
            err_kind := 4;
            scanning := true;
            while (scanning) {
              if (cursor >= len) {
                scanning := false;
              } else {
                if ((*src)[cursor] == 39) {
                  cursor := cursor + 1;
                  scanning := false;
                } else {
                  if ((*src)[cursor] == 10) {
                    scanning := false;
                  } else {
                    cursor := cursor + 1;
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  return CharLitResult { cursor := cursor, had_error := had_error, err_kind := err_kind, error_at := error_at };
}

// ---------------------------------------------------------------------
// String literal scanning -- new in v1.0.6, but *not* a general string
// type: this exists only for `@autoload`'s own quoted `pattern_string`/
// `path_string` operands (reference §1.5/§6.2b/§9), which are always
// `pure_string_literal`s, never the escape-carrying `string_literal`
// the reference also names but nothing in v1 actually accepts yet
// (§1.5's own note on why the two are kept separate). **No escape
// processing at all**: `\` is an ordinary byte here, copied straight
// through -- a filesystem path never needs a tab or a newline spelled
// via escape, and making `\` special would only get in the way of the
// namespace-path separator every pattern/path string is full of. The
// only failure mode is running off the end of the buffer or hitting a
// raw newline before the closing `"`. `start` is the offset of the
// opening `"` itself.
// ---------------------------------------------------------------------

function scan_string_literal(src: *(uint8[65536]), start: uint64, len: uint64) : StringLitResult {
  mut cursor : uint64 := start + 1;
  mut had_error : bool := false;
  mut looping : bool := true;
  mut b : uint8 := 0;

  while (looping) {
    if (cursor >= len) {
      had_error := true;
      looping := false;
    } else {
      b := (*src)[cursor];
      if (b == 34) {
        cursor := cursor + 1;
        looping := false;
      } else {
        if (b == 10 || b == 13) {
          had_error := true;
          looping := false;
        } else {
          cursor := cursor + 1;
        }
      }
    }
  }

  return StringLitResult { cursor := cursor, had_error := had_error };
}

// ---------------------------------------------------------------------
// lex_next -- one token, matching the proof of concept's own signature.
// ---------------------------------------------------------------------

function lex_next(src: *(uint8[65536]), start: uint64, len: uint64) : LexOutcome {
  mut trivia : TriviaResult := skip_trivia(src, start, len);
  mut cursor : uint64 := trivia.cursor;
  mut kind : int32 := 0;
  mut tok_offset : uint64 := cursor;
  mut tok_length : uint64 := 0;
  mut b : uint8 := 0;
  mut end_pos : uint64 := 0;
  mut num : NumberResult := NumberResult { cursor := 0, had_error := false, error_at := 0 };
  mut cl : CharLitResult := CharLitResult { cursor := 0, had_error := false, err_kind := 0, error_at := 0 };
  mut sl : StringLitResult := StringLitResult { cursor := 0, had_error := false };
  mut is_autoload : bool := false;

  if (trivia.had_error) {
    kind := 253;
    tok_offset := trivia.comment_start;
    tok_length := 0;
  } else {
    if (cursor >= len) {
      kind := 0;
      tok_offset := len;
      tok_length := 0;
    } else {
      b := (*src)[cursor];

      if (is_alpha(b)) {
        end_pos := scan_ident_end(src, cursor, len);
        tok_offset := cursor;
        tok_length := end_pos - cursor;
        kind := classify_word(src, cursor, tok_length);
        cursor := end_pos;
      } else {
        if (is_digit(b)) {
          num := scan_number(src, cursor, len);
          tok_offset := cursor;
          if (num.had_error) {
            kind := 252;
            tok_offset := num.error_at;
            tok_length := 0;
            cursor := num.cursor;
          } else {
            tok_length := num.cursor - cursor;
            kind := 2;
            cursor := num.cursor;
          }
        } else {
          if (b == 39) {
            cl := scan_char_literal(src, cursor, len);
            tok_offset := cursor;
            if (cl.had_error) {
              if (cl.err_kind == 1) { kind := 251; }
              else {
                if (cl.err_kind == 2) { kind := 250; }
                else {
                  if (cl.err_kind == 3) { kind := 249; tok_offset := cl.error_at; }
                  else { kind := 248; }
                }
              }
              tok_length := 0;
              cursor := cl.cursor;
            } else {
              tok_length := cl.cursor - cursor;
              kind := 3;
              cursor := cl.cursor;
            }
          } else {
           if (b == 34) {
             sl := scan_string_literal(src, cursor, len);
             tok_offset := cursor;
             if (sl.had_error) {
               kind := 247;
               tok_length := 0;
             } else {
               tok_length := sl.cursor - cursor;
               kind := 4;
             }
             cursor := sl.cursor;
           } else {
            if (b == 64) {
              is_autoload := false;
              if (cursor + 9 <= len) {
                if ((*src)[cursor+1] == 97 && (*src)[cursor+2] == 117 && (*src)[cursor+3] == 116 && (*src)[cursor+4] == 111 && (*src)[cursor+5] == 108 && (*src)[cursor+6] == 111 && (*src)[cursor+7] == 97 && (*src)[cursor+8] == 100) {
                  if (!(cursor + 9 < len && is_alnum((*src)[cursor + 9]))) {
                    is_autoload := true;
                  }
                }
              }
              if (is_autoload) {
                kind := 40; tok_length := 9; cursor := cursor + 9;
              } else {
                kind := 254; tok_length := 1; cursor := cursor + 1;
              }
            } else {
              if (b == 92) {
                kind := 60; tok_length := 1; cursor := cursor + 1;
              } else {
                if (b == 58) {
                  if (cursor + 1 < len && (*src)[cursor + 1] == 61) {
                    kind := 70; tok_length := 2; cursor := cursor + 2;
                  } else {
                    kind := 50; tok_length := 1; cursor := cursor + 1;
                  }
                } else {
                  if (b == 61) {
                    if (cursor + 1 < len && (*src)[cursor + 1] == 61) {
                      kind := 71; tok_length := 2; cursor := cursor + 2;
                    } else {
                      kind := 254; tok_length := 1; cursor := cursor + 1;
                    }
                  } else {
                    if (b == 33) {
                      if (cursor + 1 < len && (*src)[cursor + 1] == 61) {
                        kind := 72; tok_length := 2; cursor := cursor + 2;
                      } else {
                        kind := 79; tok_length := 1; cursor := cursor + 1;
                      }
                    } else {
                      if (b == 60) {
                        if (cursor + 1 < len && (*src)[cursor + 1] == 61) {
                          kind := 73; tok_length := 2; cursor := cursor + 2;
                        } else {
                          if (cursor + 1 < len && (*src)[cursor + 1] == 60) {
                            kind := 75; tok_length := 2; cursor := cursor + 2;
                          } else {
                            kind := 86; tok_length := 1; cursor := cursor + 1;
                          }
                        }
                      } else {
                        if (b == 62) {
                          if (cursor + 1 < len && (*src)[cursor + 1] == 61) {
                            kind := 74; tok_length := 2; cursor := cursor + 2;
                          } else {
                            if (cursor + 1 < len && (*src)[cursor + 1] == 62) {
                              kind := 76; tok_length := 2; cursor := cursor + 2;
                            } else {
                              kind := 87; tok_length := 1; cursor := cursor + 1;
                            }
                          }
                        } else {
                          if (b == 38) {
                            if (cursor + 1 < len && (*src)[cursor + 1] == 38) {
                              kind := 77; tok_length := 2; cursor := cursor + 2;
                            } else {
                              kind := 82; tok_length := 1; cursor := cursor + 1;
                            }
                          } else {
                            if (b == 124) {
                              if (cursor + 1 < len && (*src)[cursor + 1] == 124) {
                                kind := 78; tok_length := 2; cursor := cursor + 2;
                              } else {
                                kind := 89; tok_length := 1; cursor := cursor + 1;
                              }
                            } else {
                              if (b == 59) { kind := 51; tok_length := 1; cursor := cursor + 1; }
                              else {
                              if (b == 44) { kind := 52; tok_length := 1; cursor := cursor + 1; }
                              else {
                              if (b == 46) { kind := 53; tok_length := 1; cursor := cursor + 1; }
                              else {
                              if (b == 40) { kind := 54; tok_length := 1; cursor := cursor + 1; }
                              else {
                              if (b == 41) { kind := 55; tok_length := 1; cursor := cursor + 1; }
                              else {
                              if (b == 123) { kind := 56; tok_length := 1; cursor := cursor + 1; }
                              else {
                              if (b == 125) { kind := 57; tok_length := 1; cursor := cursor + 1; }
                              else {
                              if (b == 91) { kind := 58; tok_length := 1; cursor := cursor + 1; }
                              else {
                              if (b == 93) { kind := 59; tok_length := 1; cursor := cursor + 1; }
                              else {
                              if (b == 45) { kind := 80; tok_length := 1; cursor := cursor + 1; }
                              else {
                              if (b == 42) { kind := 81; tok_length := 1; cursor := cursor + 1; }
                              else {
                              if (b == 47) { kind := 83; tok_length := 1; cursor := cursor + 1; }
                              else {
                              if (b == 37) { kind := 84; tok_length := 1; cursor := cursor + 1; }
                              else {
                              if (b == 43) { kind := 85; tok_length := 1; cursor := cursor + 1; }
                              else {
                              if (b == 94) { kind := 88; tok_length := 1; cursor := cursor + 1; }
                              else {
                                kind := 254; tok_length := 1; cursor := cursor + 1;
                              }}}}}}}}}}}}}}}
                            }
                          }
                        }
                      }
                    }
                  }
                }
                tok_offset := cursor - tok_length;
              }
            }
          }
         }
        }
      }
    }
  }

  return LexOutcome { tok := Token { kind := kind, offset := tok_offset, length := tok_length }, cursor := cursor };
}

// ---------------------------------------------------------------------
// I/O and formatting helpers used only by main() below.
// ---------------------------------------------------------------------

// Bridges an int64 syscall return value into uint64 -- v0 has no cast
// operator, see postulate_v0_language_reference.md §2.8.
function int64_to_uint64(n: int64) : uint64 {
  mut result : uint64 := 0;
  mut steps : int64 := n;
  while (steps > 0) {
    result := result + 1;
    steps := steps - 1;
  }
  return result;
}

function digit_to_ascii(d: uint64) : uint8 {
  mut result : uint8 := 48;
  if (d == 1) { result := 49; }
  if (d == 2) { result := 50; }
  if (d == 3) { result := 51; }
  if (d == 4) { result := 52; }
  if (d == 5) { result := 53; }
  if (d == 6) { result := 54; }
  if (d == 7) { result := 55; }
  if (d == 8) { result := 56; }
  if (d == 9) { result := 57; }
  return result;
}

function nibble_to_hex(n: uint8) : uint8 {
  mut result : uint8 := 48;
  if (n == 1) { result := 49; }
  if (n == 2) { result := 50; }
  if (n == 3) { result := 51; }
  if (n == 4) { result := 52; }
  if (n == 5) { result := 53; }
  if (n == 6) { result := 54; }
  if (n == 7) { result := 55; }
  if (n == 8) { result := 56; }
  if (n == 9) { result := 57; }
  if (n == 10) { result := 97; }
  if (n == 11) { result := 98; }
  if (n == 12) { result := 99; }
  if (n == 13) { result := 100; }
  if (n == 14) { result := 101; }
  if (n == 15) { result := 102; }
  return result;
}

function append_str(out: *(uint8[131072]), pos: uint64, s: *(uint8[80]), s_len: uint64) : uint64 {
  mut i : uint64 := 0;
  mut new_pos : uint64 := pos;
  while (i < s_len) {
    (*out)[new_pos] := (*s)[i];
    new_pos := new_pos + 1;
    i := i + 1;
  }
  return new_pos;
}

function append_slice(out: *(uint8[131072]), pos: uint64, src: *(uint8[65536]), off: uint64, ln: uint64) : uint64 {
  mut i : uint64 := 0;
  mut new_pos : uint64 := pos;
  while (i < ln) {
    (*out)[new_pos] := (*src)[off + i];
    new_pos := new_pos + 1;
    i := i + 1;
  }
  return new_pos;
}

function append_byte(out: *(uint8[131072]), pos: uint64, b: uint8) : uint64 {
  (*out)[pos] := b;
  return pos + 1;
}

function append_uint(out: *(uint8[131072]), pos: uint64, value: uint64) : uint64 {
  mut digits : uint8[24] := 0;
  mut count : uint64 := 0;
  mut v : uint64 := value;
  mut new_pos : uint64 := pos;
  mut d : uint64 := 0;
  mut i : uint64 := 0;

  if (v == 0) {
    digits[0] := 48;
    count := 1;
  } else {
    while (v > 0) {
      d := v % 10;
      digits[count] := digit_to_ascii(d);
      count := count + 1;
      v := v / 10;
    }
  }

  i := 0;
  while (i < count) {
    new_pos := append_byte(out, new_pos, digits[(count - 1) - i]);
    i := i + 1;
  }
  return new_pos;
}

function append_hex_byte(out: *(uint8[131072]), pos: uint64, b: uint8) : uint64 {
  mut hi : uint8 := b / 16;
  mut lo : uint8 := b % 16;
  mut new_pos : uint64 := pos;
  new_pos := append_byte(out, new_pos, nibble_to_hex(hi));
  new_pos := append_byte(out, new_pos, nibble_to_hex(lo));
  return new_pos;
}

// 1-based line/col of a byte offset, counting newlines from the start
// of the buffer -- not on lex_next's own hot path, runs once, only when
// a program is about to report an error and exit anyway.
function compute_line_col(src: *(uint8[65536]), src_len: uint64, target: uint64) : LineCol {
  mut i : uint64 := 0;
  mut line : uint64 := 1;
  mut last_line_start : uint64 := 0;
  mut limit : uint64 := target;
  mut col : uint64 := 0;

  if (limit > src_len) {
    limit := src_len;
  }
  while (i < limit) {
    if ((*src)[i] == 10) {
      line := line + 1;
      last_line_start := i + 1;
    }
    i := i + 1;
  }
  col := (target - last_line_start) + 1;

  return LineCol { line := line, col := col };
}

// Retries sys_write until `total` bytes are sent or an error occurs.
function write_all(fd: int64, buf: *(uint8[131072]), total: uint64) : bool {
  mut pos : uint64 := 0;
  mut n : int64 := 0;
  mut ok : bool := true;
  mut looping : bool := true;

  while (looping) {
    if (pos >= total) {
      looping := false;
    } else {
      n := sys_write(fd, &(*buf)[pos], total - pos);
      if (n < 0) {
        ok := false;
        looping := false;
      } else {
        pos := pos + int64_to_uint64(n);
      }
    }
  }
  return ok;
}

function append_str_e(out: *(uint8[256]), pos: uint64, s: *(uint8[80]), s_len: uint64) : uint64 {
  mut i : uint64 := 0;
  mut new_pos : uint64 := pos;
  while (i < s_len) {
    (*out)[new_pos] := (*s)[i];
    new_pos := new_pos + 1;
    i := i + 1;
  }
  return new_pos;
}

function append_byte_e(out: *(uint8[256]), pos: uint64, b: uint8) : uint64 {
  (*out)[pos] := b;
  return pos + 1;
}

function append_uint_e(out: *(uint8[256]), pos: uint64, value: uint64) : uint64 {
  mut digits : uint8[24] := 0;
  mut count : uint64 := 0;
  mut v : uint64 := value;
  mut new_pos : uint64 := pos;
  mut d : uint64 := 0;
  mut i : uint64 := 0;

  if (v == 0) {
    digits[0] := 48;
    count := 1;
  } else {
    while (v > 0) {
      d := v % 10;
      digits[count] := digit_to_ascii(d);
      count := count + 1;
      v := v / 10;
    }
  }

  i := 0;
  while (i < count) {
    new_pos := append_byte_e(out, new_pos, digits[(count - 1) - i]);
    i := i + 1;
  }
  return new_pos;
}

function append_hex_byte_e(out: *(uint8[256]), pos: uint64, b: uint8) : uint64 {
  mut hi : uint8 := b / 16;
  mut lo : uint8 := b % 16;
  mut new_pos : uint64 := pos;
  new_pos := append_byte_e(out, new_pos, nibble_to_hex(hi));
  new_pos := append_byte_e(out, new_pos, nibble_to_hex(lo));
  return new_pos;
}

function write_all_small(fd: int64, buf: *(uint8[256]), total: uint64) : bool {
  mut pos : uint64 := 0;
  mut n : int64 := 0;
  mut ok : bool := true;
  mut looping : bool := true;

  while (looping) {
    if (pos >= total) {
      looping := false;
    } else {
      n := sys_write(fd, &(*buf)[pos], total - pos);
      if (n < 0) {
        ok := false;
        looping := false;
      } else {
        pos := pos + int64_to_uint64(n);
      }
    }
  }
  return ok;
}

