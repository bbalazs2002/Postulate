      err_pos := append_str_e(&err_buf, err_pos, &err_col, 6);
      err_pos := append_uint_e(&err_buf, err_pos, lc.col);
      err_pos := append_str_e(&err_buf, err_pos, &err_byteoff, 14);
      err_pos := append_uint_e(&err_buf, err_pos, tok.offset);
      err_pos := append_str_e(&err_buf, err_pos, &err_close_nl, 2);
      wrote_ok := write_all_small(2, &err_buf, err_pos);
    }
  }

  sys_exit(exit_code);
  return 0;
}
