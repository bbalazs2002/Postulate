    } else {
      n := sys_read(0, &src_buf[src_len], 65536 - src_len);
      if (n < 0) {
        reading := false;
      } else {
        if (n == 0) {
          reading := false;
        } else {
          src_len := src_len + int64_to_uint64(n);
        }
      }
    }
  }
  reader.length := src_len;

