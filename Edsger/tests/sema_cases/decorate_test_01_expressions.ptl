namespace \Main;

struct Point {
  x : int32;
  y : int32;
}

function add(a: int32, b: int32) : int32 {
  return a + b;
}

function main() : int32 {
  mut p : Point;
  mut q : *Point;
  mut sum : int32;
  mut ok : bool;

  p.x := 1;
  p.y := 2;
  q := &p;
  sum := add(p.x, (*q).y);
  ok := sum == 3;
  if (ok) {
    return 0;
  }
  return 1;
}
