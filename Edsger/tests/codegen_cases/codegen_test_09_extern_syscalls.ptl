namespace \Main;

extern function sys_write(fd: int64, buf: *uint8, count: uint64) : int64;
extern function sys_mmap(addr: uint64, length: uint64, prot: int64, flags: int64, fd: int64, offset: int64) : *void;
extern function sys_munmap(addr: uint64, length: uint64) : int64;
extern function sys_gettid() : int64;

function writeGreeting() : int64 {
  mut msg : uint8[6];
  msg[0] := 72;
  msg[1] := 101;
  msg[2] := 108;
  msg[3] := 108;
  msg[4] := 111;
  msg[5] := 10;
  return sys_write(1, &msg[0], 6);
}

function roundTripMmap() : int32 {
  mut p : *void := sys_mmap(0, 4096, 3, 34, 0, 0);
  mut ok : int32 := 0;
  if (p != null) {
    ok := 1;
  }
  sys_munmap(p as uintptr, 4096);
  return ok;
}

function main() : int32 {
  mut n : int64 := writeGreeting();
  mut mmap_ok : int32 := roundTripMmap();
  mut t : int64 := sys_gettid();
  if (n == 6 && mmap_ok == 1 && t > 0) {
    return 1;
  }
  return 0;
}
