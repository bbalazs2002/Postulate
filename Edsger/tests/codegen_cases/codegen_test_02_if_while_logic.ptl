namespace \Main;

function classify(x: int32) : int32 {
  if (x < 0) {
    return -1;
  } else {
    if (x == 0) {
      return 0;
    } else {
      return 1;
    }
  }
}

function sumTo(n: int32) : int32 {
  mut total : int32 := 0;
  mut i : int32 := 0;
  while (i < n) {
    total := total + i;
    i := i + 1;
  }
  return total;
}

function logic(a: bool, b: int32) : bool {
  return a && b > 0;
}

function main() : int32 {
  mut r : int32 := classify(5);
  mut s : int32 := sumTo(10);
  return r + s;
}
