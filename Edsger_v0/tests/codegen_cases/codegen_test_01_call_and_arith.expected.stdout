  %r6 = alloca i32
  store i32 5, ptr %r5
  store i32 3, ptr %r6
  %r7 = load i32, ptr %r5
  %r8 = load i32, ptr %r6
  %r9 = call i32 @add(i32 %r7, i32 %r8)
  ret i32 %r9
}

define void @_start() {
entry:
