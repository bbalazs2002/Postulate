  br label %L7
L7:
  %r46 = load i1, ptr %r41
  br i1 %r46, label %L2, label %L3
L2:
  %r47 = load i64, ptr %r36
  %r48 = icmp sgt i64 %r47, 0
  store i1 %r48, ptr %r40
  br label %L4
L3:
  store i1 0, ptr %r40
  br label %L4
L4:
  %r49 = load i1, ptr %r40
  br i1 %r49, label %L8, label %L9
L8:
  ret i32 1
L9:
  ret i32 0
}

define void @_start() {
entry:
  %r50 = call i32 @main()
  %r51 = zext i32 %r50 to i64
