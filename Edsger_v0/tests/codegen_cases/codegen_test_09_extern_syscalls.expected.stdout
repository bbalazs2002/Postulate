define i64 @sys_gettid() {
entry:
  %r15 = call i64 asm sideeffect "syscall", "={rax},{rax},~{rcx},~{r11},~{memory}"(i64 186)
  ret i64 %r15
}

define i64 @writeGreeting() {
entry:
  %r16 = alloca [6 x i8]
  %r17 = getelementptr [6 x i8], ptr %r16, i32 0, i32 0
  store i8 72, ptr %r17
  %r18 = getelementptr [6 x i8], ptr %r16, i32 0, i32 1
  store i8 101, ptr %r18
  %r19 = getelementptr [6 x i8], ptr %r16, i32 0, i32 2
  store i8 108, ptr %r19
  %r20 = getelementptr [6 x i8], ptr %r16, i32 0, i32 3
  store i8 108, ptr %r20
  %r21 = getelementptr [6 x i8], ptr %r16, i32 0, i32 4
  store i8 111, ptr %r21
  %r22 = getelementptr [6 x i8], ptr %r16, i32 0, i32 5
  store i8 10, ptr %r22
  %r23 = getelementptr [6 x i8], ptr %r16, i32 0, i32 0
  %r24 = call i64 @sys_write(i64 1, ptr %r23, i64 6)
  ret i64 %r24
}

define i32 @roundTripMmap() {
entry:
  %r25 = alloca ptr
  %r26 = alloca i32
  %r27 = call ptr @sys_mmap(i64 0, i64 4096, i64 3, i64 34, i64 0, i64 0)
  store ptr %r27, ptr %r25
  store i32 0, ptr %r26
  %r28 = load ptr, ptr %r25
  %r29 = icmp ne ptr %r28, null
  br i1 %r29, label %L0, label %L1
L0:
  store i32 1, ptr %r26
  br label %L1
L1:
  %r30 = load ptr, ptr %r25
  %r31 = ptrtoint ptr %r30 to i64
  %r32 = call i64 @sys_munmap(i64 %r31, i64 4096)
  %r33 = load i32, ptr %r26
  ret i32 %r33
}

define i32 @main() {
entry:
  %r34 = alloca i64
  %r35 = alloca i32
  %r36 = alloca i64
  %r37 = call i64 @writeGreeting()
  store i64 %r37, ptr %r34
  %r38 = call i32 @roundTripMmap()
  store i32 %r38, ptr %r35
  %r39 = call i64 @sys_gettid()
  store i64 %r39, ptr %r36
  %r40 = alloca i1
  %r41 = alloca i1
  %r42 = load i64, ptr %r34
  %r43 = icmp eq i64 %r42, 6
