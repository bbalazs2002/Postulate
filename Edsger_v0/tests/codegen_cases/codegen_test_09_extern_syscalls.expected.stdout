  %r10 = call i64 asm sideeffect "syscall", "={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{memory}"(i64 9, i64 %r4, i64 %r5, i64 %r6, i64 %r7, i64 %r8, i64 %r9)
  %r11 = inttoptr i64 %r10 to ptr
  ret ptr %r11
}

define i64 @sys_munmap(i64 %p0, i64 %p1) {
entry:
