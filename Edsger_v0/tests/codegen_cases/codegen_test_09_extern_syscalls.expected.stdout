define i64 @sys_write(i64 %p0, ptr %p1, i64 %p2) {
entry:
  %r0 = add i64 %p0, 0
  %r1 = ptrtoint ptr %p1 to i64
  %r2 = add i64 %p2, 0
  %r3 = call i64 asm sideeffect "syscall", "={rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}"(i64 1, i64 %r0, i64 %r1, i64 %r2)
  ret i64 %r3
}

define ptr @sys_mmap(i64 %p0, i64 %p1, i64 %p2, i64 %p3, i64 %p4, i64 %p5) {
entry:
