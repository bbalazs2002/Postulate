namespace \Main;

struct Point {
  x : int32;
  y : int32;
}

function combine(a : int32, b : int32, p : *Point, arr : *int32[4]) : int32 {
  mut r : int32 := 0;
  mut c : char := 'x';
  mut s : *(uint8[4]) := 0;
  mut vp : *void := 0;
  mut up : uintptr := 0;
  mut pt : Point := Point { x := 1, y := 2 };
  mut list : int32[3] := {1, 2, 3};

  r := a + b * 2 - b / 2 % 2;
  r := r << 1 >> 1;
  r := r & 1 | 2 ^ 3;
  r := (a == b) as int32;
  r := (a != b || a < b) as int32;
  r := !(a > b) as int32;
  r := -a + (a as int32);
  r := (*p).x + arr[0];
  r := list[1] + pt.y;
  r := sizeof(Point) as int32 + sizeof(a) as int32;
  r := lengthof(list) as int32 + lengthof(arr) as int32;

  return r;
}

function main() : int32 {
  return 0;
}
