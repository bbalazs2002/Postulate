# Postulate Edsger -- release image: just the compiler binary, the
# language reference, and the tools `./edsger` needs at runtime (llc,
# ld, bash) -- nothing from the dev/test toolchain (the `.ptl` sources,
# the tests/ fixtures, Hoare itself). Meant for other developers who
# just want to compile Postulate v1 programs, not work on Edsger itself.
#
# Built FROM the already fully-tested dev image (see Edsger/Dockerfile)
# -- this image adds no new logic of its own beyond building Edsger's
# own `build/codegen` (the dev image never bakes Edsger's source in,
# only Hoare's -- see that Dockerfile's own header comment -- so that
# one build step has to happen here instead), and otherwise only
# re-packages verified artifacts (docker build -t postulate-edsger
# -f Edsger/Dockerfile . must succeed first).
#
# Build (from the repository ROOT, so the build context includes both
# Edsger/ and docs/):
#   docker build -f Edsger/Dockerfile.release -t postulate-edsger-release .
#
# Use:
#   docker run --rm -v ${PWD}:/work postulate-edsger-release file.ptl
#
# Produces a real, runnable ELF binary by default -- gen_start/gen_
# syscall_extern (codegen.ptl) emit a real `_start` entry point and
# working syscall wrappers for the twelve whitelisted `extern function`s
# (postulate_v1_language_reference.md SS5.2); see ./edsger's own header
# comment for the `--emit-llvm`/`-c` flags that stop short of linking.

FROM postulate-edsger:latest AS builder

COPY ./Edsger .
RUN chmod +x edsger scripts/build.sh && ./scripts/build.sh

FROM ubuntu:24.04

RUN apt-get update \
 && apt-get install -y --no-install-recommends llvm binutils bash \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/edsger
COPY --from=builder /workspace/Edsger/edsger ./edsger
COPY --from=builder /workspace/Edsger/build/codegen ./build/codegen
COPY docs/postulate_v1_language_reference.md ./docs/postulate_v1_language_reference.md

RUN ln -s /opt/edsger/edsger /usr/local/bin/edsger

WORKDIR /work
ENTRYPOINT ["edsger"]
