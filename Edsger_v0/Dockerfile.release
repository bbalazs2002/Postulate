# Postulate Edsger -- release image: just the compiler binary, the
# language reference, and the tools `./edsger` needs at runtime (llc,
# ld, bash) -- nothing from the dev/test toolchain (the `.ptl` sources,
# the tests/ fixtures, Hoare itself). Meant for other developers who
# just want to compile Postulate v1.0 programs, not work on Edsger
# itself.
#
# Built FROM the already fully-tested dev image (see Edsger_v0/Dockerfile)
# -- this image adds no new logic of its own beyond building Edsger's
# own `build/codegen` from its real source (`src/modular/`, via the
# two-stage bootstrap `scripts/build.sh` documents in full -- the dev
# image never bakes Edsger's own source in, only Hoare's, so that build
# step has to happen here instead), and otherwise only re-packages
# verified artifacts (docker build -t postulate-edsger
# -f Edsger_v0/Dockerfile . must succeed first).
#
# Build (from the repository ROOT, so the build context includes both
# Edsger_v0/ and docs/):
#   docker build -f Edsger_v0/Dockerfile.release -t postulate-edsger-release .
#
# Use:
#   docker run --rm -v ${PWD}:/work postulate-edsger-release file.ptl
#
# Produces a real, runnable ELF binary by default -- gen_start/gen_
# syscall_extern (src/modular/Edsger/Codegen.ptl) emit a real `_start`
# entry point and working syscall wrappers for the twelve whitelisted
# `extern function`s (postulate_v1_0_language_reference.md SS5.3); see
# ./edsger's own header comment for the `--emit-llvm`/`-c` flags that
# stop short of linking.

FROM postulate-edsger:latest AS builder

COPY ./Edsger_v0 .
RUN chmod +x edsger scripts/build.sh && ./scripts/build.sh

FROM ubuntu:24.04

RUN apt-get update \
 && apt-get install -y --no-install-recommends llvm binutils bash \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/edsger
COPY --from=builder /workspace/Edsger/edsger ./edsger
COPY --from=builder /workspace/Edsger/build/codegen ./build/codegen
COPY docs/postulate_v1_0_language_reference.md ./docs/postulate_v1_0_language_reference.md

RUN ln -s /opt/edsger/edsger /usr/local/bin/edsger

WORKDIR /work
ENTRYPOINT ["edsger"]
