# Postulate Hoare -- release image: just the compiler binary, the
# language reference, and the tools ./hoare needs at runtime (nasm, ld,
# bash) -- nothing from the dev/test toolchain (build/lexer, build/
# parser, build/checker, the *.asm sources, the tests/ fixtures). Meant
# for other developers who just want to compile Postulate programs, not
# work on Hoare itself.
#
# Built FROM the already fully-tested dev image (see Hoare/Dockerfile) --
# this image adds no new logic of its own, it only re-packages verified
# artifacts (docker build -t postulate-hoare Hoare must succeed first).
#
# Build context is Hoare/ itself, self-contained (the language
# reference it packages is vendored in at vendor/docs/, not reached
# from the repository root):
#   docker build -f Hoare/Dockerfile.release -t postulate-hoare-release Hoare
#
# Use:
#   docker run --rm -v ${PWD}:/work postulate-hoare-release file.ptl

FROM postulate-hoare:latest AS builder

FROM ubuntu:24.04

RUN apt-get update \
 && apt-get install -y --no-install-recommends nasm binutils bash \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/hoare
COPY --from=builder /workspace/hoare ./hoare
COPY --from=builder /workspace/build/codegen ./build/codegen
COPY vendor/docs/postulate_v0_language_reference.md ./docs/postulate_v0_language_reference.md

RUN ln -s /opt/hoare/hoare /usr/local/bin/hoare

WORKDIR /work
ENTRYPOINT ["hoare"]
