// Same "9b" bug, exercised with TWO composite arguments in non-last
// position simultaneously: one literal-sourced, one call-sourced.
struct Pt { x: int32; y: int32; }
struct Res { a: int32; b: int32; c: int32; d: int32; }

function combine(p1: Pt, tag: int32, p2: Pt, scale: int32) : Res {
  return Res { a := p1.x * scale, b := p1.y * scale, c := p2.x + tag, d := p2.y + tag };
}
function make_pt(x: int32, y: int32) : Pt {
  return Pt { x := x, y := y };
}
function main() : int32 {
  mut r: Res := combine(Pt { x := 2, y := 3 }, 100, make_pt(5, 6), 10);
  mut ok: bool := true;
  if (r.a != 20) { ok := false; }
  if (r.b != 30) { ok := false; }
  if (r.c != 105) { ok := false; }
  if (r.d != 106) { ok := false; }
  if (!ok) { return 1; }
  return 88;
}
