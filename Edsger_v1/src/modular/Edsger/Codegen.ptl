  if (piece == 30) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p30, lens[30]); return; }
  if (piece == 31) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p31, lens[31]); return; }
  if (piece == 32) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p32, lens[32]); return; }
  if (piece == 33) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p33, lens[33]); return; }
  if (piece == 34) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p34, lens[34]); return; }
  if (piece == 35) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p35, lens[35]); return; }
  if (piece == 36) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p36, lens[36]); return; }
  if (piece == 37) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p37, lens[37]); return; }
  if (piece == 38) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p38, lens[38]); return; }
  if (piece == 39) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p39, lens[39]); return; }
  if (piece == 40) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p40, lens[40]); return; }
  if (piece == 41) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p41, lens[41]); return; }
  if (piece == 42) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p42, lens[42]); return; }
  if (piece == 43) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p43, lens[43]); return; }
  if (piece == 44) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p44, lens[44]); return; }
  if (piece == 45) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p45, lens[45]); return; }
  if (piece == 46) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p46, lens[46]); return; }
  if (piece == 47) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p47, lens[47]); return; }
  if (piece == 48) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p48, lens[48]); return; }
  if (piece == 49) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p49, lens[49]); return; }
  if (piece == 50) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p50, lens[50]); return; }
  if (piece == 51) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p51, lens[51]); return; }
  if (piece == 52) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p52, lens[52]); return; }
  if (piece == 53) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p53, lens[53]); return; }
  if (piece == 54) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p54, lens[54]); return; }
  if (piece == 55) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p55, lens[55]); return; }
  if (piece == 56) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p56, lens[56]); return; }
  if (piece == 57) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p57, lens[57]); return; }
  if (piece == 58) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p58, lens[58]); return; }
  if (piece == 59) { (*cg).pos := append_str((*cg).out, (*cg).pos, &p59, lens[59]); return; }
  (*cg).pos := append_str((*cg).out, (*cg).pos, &p60, lens[60]);
}

function cg_byte(cg: *Codegen, b: uint8) : void {
  (*cg).pos := append_byte((*cg).out, (*cg).pos, b);
}

function cg_uint(cg: *Codegen, v: uint64) : void {
  (*cg).pos := append_uint((*cg).out, (*cg).pos, v);
}

function cg_slice(cg: *Codegen, src: *DynBytes, off: uint64, ln: uint64) : void {
  (*cg).pos := append_slice((*cg).out, (*cg).pos, src, off, ln);
}

function cg_hex_digit(cg: *Codegen, nibble: uint64) : void {
  mut d : uint8 := nibble as uint8;
  if (d < 10) {
    cg_byte(cg, 48 + d);
  } else {
    cg_byte(cg, 55 + d);
  }
}

// LLVM hex float constant: `0x` + 16 hex digits of the value's own
// IEEE-754 binary64 bit pattern -- used regardless of whether the
// eventual typed use is `float` or `double` (LLVM's own documented
// behavior: a hex float constant is always given in double-precision
// encoding, then converted/rounded to the target type by the
// assembler).
function cg_hex64(cg: *Codegen, v: uint64) : void {
  mut shift : uint64 := 60;
  mut looping : bool := true;
  cg_byte(cg, 48); cg_byte(cg, 120);
  while (looping) {
    cg_hex_digit(cg, (v >> shift) & 15);
    if (shift == 0) { looping := false; } else { shift := shift - 4; }
  }
}

function new_reg(cg: *Codegen) : uint64 {
  mut r : uint64 := (*cg).reg;
  (*cg).reg := (*cg).reg + 1;
  return r;
}

function new_label(cg: *Codegen) : uint64 {
  mut l : uint64 := (*cg).label;
  (*cg).label := (*cg).label + 1;
  return l;
}

function cg_reg_ref(cg: *Codegen, r: uint64) : void {
  cg_byte(cg, 37);
  cg_byte(cg, 114);
  cg_uint(cg, r);
}

function cg_param_ref(cg: *Codegen, n: uint64) : void {
  cg_byte(cg, 37);
  cg_byte(cg, 112);
  cg_uint(cg, n);
}

function cg_label_def(cg: *Codegen, l: uint64) : void {
  cg_byte(cg, 76);
  cg_uint(cg, l);
  cg_piece(cg, 19);
}

function cg_label_target(cg: *Codegen, l: uint64) : void {
  cg_byte(cg, 37);
  cg_byte(cg, 76);
  cg_uint(cg, l);
}

function cg_operand(cg: *Codegen, op: Operand) : void {
  if (op.is_null) {
    cg_piece(cg, 50);
    return;
  }
  if (op.is_float_imm) {
    cg_hex64(cg, op.float_bits);
    return;
  }
  if (op.is_reg) {
    cg_reg_ref(cg, op.reg);
    return;
  }
  cg_uint(cg, int64_to_uint64(op.imm));
}

// `bool` is `i1`; every other scalar type here is `i<8*bytewidth>`,
// reusing base_type_size (Module 3's own byte-width table) directly --
// codegen never needs its own copy of that table.
// 2026-08-31: was a bounded (<=255 iterations, never actually a
// performance problem the way int64_to_uint64's own unbounded version
// was) but equally unnecessary counting loop, from the same Hoare-era
// lineage (postulate_v0_language_reference.md SS2.8 predates `as`
// entirely -- Hoare, the only tool that ever compiled code needing
// this specific workaround, still has no cast operator; this file
// isn't compiled by Hoare, so it never needed the workaround at all).
// Plain widening `as` (uint8 -> uint64, an ordinary `zext`) already
// works in this dialect -- see Lexer.ptl's own `reader_peek(r) as
// uint64` for existing, working proof.
function byte_to_uint64(b: uint8) : uint64 {
  return b as uint64;
}

// CHAR_LIT's own tok spans the source text quotes-inclusive (`'a'` or
// `'\n'`) -- unlike INT_LIT, the parser never precomputes its value
// into int_val, so codegen decodes it directly here, the same handful
// of escapes postulate_v1_language_reference.md SS1.5 lists (`\n \t \r
// \0 \\ \'`); anything else between the quotes is that one byte as-is.
function decode_char_literal(src: *DynBytes, tok_offset: uint64) : int64 {
  mut b : uint8 := (*src).ptr[tok_offset + 1];
  mut e : uint8 := 0;
  mut v : uint8 := 0;

  if (b == 92) {
    e := (*src).ptr[tok_offset + 2];
    if (e == 110) { v := 10; }
    if (e == 116) { v := 9; }
    if (e == 114) { v := 13; }
    if (e == 48) { v := 0; }
    if (e == 92) { v := 92; }
    if (e == 39) { v := 39; }
    return uint64_to_int64(byte_to_uint64(v));
  }
  return uint64_to_int64(byte_to_uint64(b));
}

// A multi-byte CHAR_LIT anchored to `rune` (Sema's own decorate_
// literal_with_expected k==142 case already confirmed this is legal
// and multi-byte, via char_literal_is_multibyte) -- decodes the actual
// UTF-8 sequence into its own Unicode codepoint VALUE (never reached
// for a single-byte literal, which always goes through decode_char_
// literal above instead, escapes included). Standard UTF-8: the
// leading byte's own low bits (masked by how many continuation bytes
// follow, from utf8_extra_bytes_sema) seed the value, each continuation
// byte's own low 6 bits then shift in from the right.
function decode_rune_literal(src: *DynBytes, tok_offset: uint64) : int64 {
  mut b0 : uint8 := (*src).ptr[tok_offset + 1];
  mut extra : uint64 := utf8_extra_bytes_sema(b0);
  mut mask : uint8 := 127;
  mut value : uint64 := 0;
  mut i : uint64 := 0;
  mut b : uint8 := 0;

  if (extra == 1) { mask := 31; }
  if (extra == 2) { mask := 15; }
  if (extra == 3) { mask := 7; }

  value := byte_to_uint64(b0 & mask);
  while (i < extra) {
    b := (*src).ptr[tok_offset + 2 + i];
    value := (value << 6) | byte_to_uint64(b & 63);
    i := i + 1;
  }
  return uint64_to_int64(value);
}

// One decoded byte of a string literal's own content, read starting at
// `pos` (an offset into the source buffer, already past the opening
// quote) -- `consumed` is how many RAW source bytes that was (1 for an
// ordinary byte, 2 for a backslash escape), so the caller can advance
// correctly. Same escape table as decode_char_literal above, just `\"`
// instead of `\'` (a string's own closing delimiter, never a bare `'`
// inside one) -- kept as a separate function rather than a shared one
// because that's the one byte where the two differ.
struct DecodedStringByte {
  value : uint8;
  consumed : uint64;
}

function decode_string_byte_at(src: *DynBytes, pos: uint64) : DecodedStringByte {
  mut b : uint8 := (*src).ptr[pos];
  mut e : uint8 := 0;
  mut v : uint8 := 0;

  if (b == 92) {
    e := (*src).ptr[pos + 1];
    if (e == 110) { v := 10; }
    if (e == 116) { v := 9; }
    if (e == 114) { v := 13; }
    if (e == 48) { v := 0; }
    if (e == 92) { v := 92; }
    if (e == 34) { v := 34; }
    return DecodedStringByte { value := v, consumed := 2 };
  }
  return DecodedStringByte { value := b, consumed := 1 };
}

// One decoded Unicode codepoint from a string literal's own content,
// read starting at `pos` -- `consumed` is how many raw UTF-8 bytes that
// was (1-4). Unlike decode_string_byte_at (char[N]'s own per-BYTE
// decoder), this never treats a backslash specially: Sema's own
// count_utf8_codepoints (the rune[N] anchor's length check) doesn't
// either, so staying escape-unaware here keeps the two in agreement,
// exactly like decode_string_byte_at/count_decoded_string_bytes already
// have to agree for char[N]. (Escape support inside a rune[N]-anchored
// literal would need both fixed together, same as that pair was --
// not attempted here, a real but separate follow-up.)
struct DecodedCodepoint {
  value : int64;
  consumed : uint64;
}

function decode_codepoint_at(src: *DynBytes, pos: uint64) : DecodedCodepoint {
  mut b0 : uint8 := (*src).ptr[pos];
  mut extra : uint64 := utf8_extra_bytes_sema(b0);
  mut mask : uint8 := 127;
  mut value : uint64 := 0;
  mut i : uint64 := 0;
  mut b : uint8 := 0;

  if (extra == 1) { mask := 31; }
  if (extra == 2) { mask := 15; }
  if (extra == 3) { mask := 7; }

  value := byte_to_uint64(b0 & mask);
  while (i < extra) {
    b := (*src).ptr[pos + 1 + i];
    value := (value << 6) | byte_to_uint64(b & 63);
    i := i + 1;
  }
  return DecodedCodepoint { value := uint64_to_int64(value), consumed := extra + 1 };
}

// A string literal anchored to a fixed `rune[N]` array -- built exactly
// like gen_string_char_array (a fresh alloca, one GEP+store per element
// in source order, then a whole-value load back out), just decoding
// per CODEPOINT (decode_codepoint_at, above) instead of per byte, and
// storing each one as its own element (`rune`'s own LLVM type, `i32`,
// via the ordinary cg_type dispatch -- rune is a real builtin now, no
// special-casing needed here beyond picking this decoder over char[N]'s).
function gen_string_rune_array(cg: *Codegen, s: *Sema, file_idx: uint64, e: *ASTNode) : Operand {
  mut src : *DynBytes := &(*(*s).buffers)[file_idx].bytes;
  mut content_off : uint64 := (*e).tok.offset + 1;
  mut content_len : uint64 := (*e).tok.length - 2;
  mut pos : uint64 := 0;
  mut idx : uint64 := 0;
  mut cp : DecodedCodepoint := DecodedCodepoint { value := 0, consumed := 0 };
  mut lit_slot : uint64 := new_reg(cg);
  mut elem_addr : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut val_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut r : uint64 := 0;

  cg_piece(cg, 1); cg_reg_ref(cg, lit_slot); cg_piece(cg, 2); cg_piece(cg, 6);
  cg_type(cg, s, file_idx, (*e).data_type);
  cg_piece(cg, 0);

  while (pos < content_len) {
    cp := decode_codepoint_at(src, content_off + pos);
    val_op := Operand { is_reg := false, reg := 0, imm := cp.value, is_null := false, is_float_imm := false, float_bits := 0 };
    elem_addr := gen_member_addr(cg, s, file_idx, (*e).data_type, Operand { is_reg := true, reg := lit_slot, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 }, idx);
    cg_piece(cg, 1); cg_piece(cg, 9);
    cg_type(cg, s, (*e).type_file_idx, (*(*e).data_type).left);
    cg_byte(cg, 32);
    cg_operand(cg, val_op);
    cg_piece(cg, 8); cg_operand(cg, elem_addr); cg_piece(cg, 0);
    pos := pos + cp.consumed;
    idx := idx + 1;
  }

  r := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 7);
  cg_type(cg, s, file_idx, (*e).data_type);
  cg_piece(cg, 8); cg_reg_ref(cg, lit_slot); cg_piece(cg, 0);
  return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

// A string literal anchored to a fixed `char[N]` array (Sema's own
// decorate_literal_with_expected k==143 case; `count_decoded_string_
// bytes` there already guarantees N exactly matches how many bytes this
// loop will produce) -- built exactly like an ordinary ARRAY_LIT (k==
// 153, above): a fresh alloca, one GEP+store per element in order, then
// a whole-value load back out. The only difference is where each
// element's VALUE comes from -- decoded literal bytes here, evaluated
// child expressions there.
function gen_string_char_array(cg: *Codegen, s: *Sema, file_idx: uint64, e: *ASTNode) : Operand {
  mut src : *DynBytes := &(*(*s).buffers)[file_idx].bytes;
  mut content_off : uint64 := (*e).tok.offset + 1;
  mut content_len : uint64 := (*e).tok.length - 2;
  mut pos : uint64 := 0;
  mut idx : uint64 := 0;
  mut db : DecodedStringByte := DecodedStringByte { value := 0, consumed := 0 };
  mut lit_slot : uint64 := new_reg(cg);
  mut elem_addr : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut byte_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut r : uint64 := 0;

  cg_piece(cg, 1); cg_reg_ref(cg, lit_slot); cg_piece(cg, 2); cg_piece(cg, 6);
  cg_type(cg, s, file_idx, (*e).data_type);
  cg_piece(cg, 0);

  while (pos < content_len) {
    db := decode_string_byte_at(src, content_off + pos);
    byte_op := Operand { is_reg := false, reg := 0, imm := uint64_to_int64(byte_to_uint64(db.value)), is_null := false, is_float_imm := false, float_bits := 0 };
    elem_addr := gen_member_addr(cg, s, file_idx, (*e).data_type, Operand { is_reg := true, reg := lit_slot, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 }, idx);
    cg_piece(cg, 1); cg_piece(cg, 9);
    cg_byte(cg, 105); cg_uint(cg, 8);
    cg_byte(cg, 32);
    cg_operand(cg, byte_op);
    cg_piece(cg, 8); cg_operand(cg, elem_addr); cg_piece(cg, 0);
    pos := pos + db.consumed;
    idx := idx + 1;
  }

  r := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 7);
  cg_type(cg, s, file_idx, (*e).data_type);
  cg_piece(cg, 8); cg_reg_ref(cg, lit_slot); cg_piece(cg, 0);
  return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

function llvm_int_width(tok_kind: int32) : uint64 {
  if (tok_kind == 32) { return 1; }
  return base_type_size(tok_kind) * 8;
}

// Every pointer, regardless of pointee, is spelled `ptr` -- opaque
// pointers (matching Stage1/src/codegen.ptl's own already-established
// choice, confirmed by its own literal ", ptr %vret\n" fragment) carry
// no pointee-type information in the IR type itself; `load`/`store`/
// `getelementptr` are what actually need the pointee type spelled out,
// each at its own call site (gen_expr's own UNARY_EXPR/BINARY_EXPR
// cases, below).
function cg_type(cg: *Codegen, s: *Sema, file_idx: uint64, ty: *ASTNode) : void {
  mut lr : LookupResult := LookupResult { found := false, index := 0 };
  if (ty == null) {
    (*cg).had_error := true;
    return;
  }
  if ((*ty).kind == 121) {
    cg_piece(cg, 51);
    return;
  }
  // v1.1.10: a FUNC_TYPE-typed value (a function/extern reference,
  // never called directly through its own name) is, at runtime, just
  // an address -- gen_global_func_addr/gen_call's own indirect-call
  // path already treat it that way, this is the matching type-emission
  // half (storage/parameter/return declarations of such a value).
  if ((*ty).kind == 161) {
    cg_piece(cg, 51);
    return;
  }
  if ((*ty).kind == 122) {
    cg_byte(cg, 91);
    cg_uint(cg, int64_to_uint64((*ty).int_val));
    cg_byte(cg, 32); cg_byte(cg, 120); cg_byte(cg, 32);
    cg_type(cg, s, file_idx, (*ty).left);
    cg_byte(cg, 93);
    return;
  }
  if ((*ty).kind != 120) {
    (*cg).had_error := true;
    return;
  }
  if ((*ty).tok.kind == 33) {
    cg_piece(cg, 26);
    return;
  }
  // v1.1.n: float32/float64/ufloat32/ufloat64 (`float`/`ufloat` are
  // aliases for the `64` form) -- checked before the generic integer
  // fallback below, since every float kind also has a nonzero
  // base_type_size (struct-field/sizeof sizing needs that) and would
  // otherwise be miscompiled as a plain integer of the same byte width.
  if (is_float_kind((*ty).tok.kind)) {
    if (base_type_size((*ty).tok.kind) == 4) {
      cg_byte(cg, 102); cg_byte(cg, 108); cg_byte(cg, 111); cg_byte(cg, 97); cg_byte(cg, 116);
    } else {
      cg_byte(cg, 100); cg_byte(cg, 111); cg_byte(cg, 117); cg_byte(cg, 98); cg_byte(cg, 108); cg_byte(cg, 101);
    }
    return;
  }
  if (base_type_size((*ty).tok.kind) > 0) {
    cg_byte(cg, 105);
    cg_uint(cg, llvm_int_width((*ty).tok.kind));
    return;
  }
  lr := find_struct_symbol(s, file_idx, (*ty).tok.offset, (*ty).tok.length);
  if (!lr.found) {
    (*cg).had_error := true;
    return;
  }
  cg_byte(cg, 37);
  cg_slice(cg, &(*(*s).buffers)[file_idx].bytes, (*ty).tok.offset, (*ty).tok.length);
}

function is_void_type(ty: *ASTNode) : bool {
  return ty != null && (*ty).kind == 120 && (*ty).tok.kind == 33;
}

// Scalar (any integer type, `bool`, `char`), struct-named, array, OR a
// pointer whose own pointee is -- recursively -- itself any of those
// or `*void` (`**int32` and friends included; a pointer's own inner
// type is only ever null for canon_null's own "adopts any pointer"
// sentinel, which should never actually reach a real decl's data_type,
// but treating it as supported rather than crashing is the safer
// default). `void` itself is excluded -- it's only ever valid as a
// return type, checked separately via is_void_type at each call site.
function is_supported_value_type(ty: *ASTNode) : bool {
  if (ty == null) { return false; }
  if ((*ty).kind == 121) {
    if ((*ty).left == null || is_void_type((*ty).left)) { return true; }
    return is_supported_value_type((*ty).left);
  }
  if ((*ty).kind == 122) {
    return is_supported_value_type((*ty).left);
  }
  // v1.1.10: FUNC_TYPE -- a function/extern reference, itself just an
  // address at runtime (cg_type's own matching k==161 case).
  if ((*ty).kind == 161) { return true; }
  if ((*ty).kind != 120) { return false; }
  return !is_void_type(ty);
}

// Whether decl (FUNCTION_DECL or EXTERN_DECL)'s entire signature is
// within this slice's scope -- every param AND the return type must be
// supported (is_supported_value_type, above) or `void` (return only).
// For a FUNCTION_DECL specifically, every top-level local (gen_
// function's own prologue allocas one for each) must ALSO be
// supported -- sizeof/lengthof can name a struct/array TYPE freely
// (type_byte_size's own job, never runtime codegen), but an actual
// struct/array-TYPED local would need real composite codegen the
// moment gen_function tried to alloca a slot for it, which is why this
// check exists at all: without it, a function with an unsupported
// local's own signature could still look "supported" from its
// params/return alone and only fail confusingly once already
// mid-emission. Anything unsupported here means gen_program simply
// skips the whole declaration rather than attempting and failing it.
function decl_is_supported(decl: *ASTNode) : bool {
  mut param : *ASTNode := (*decl).first_child;
  mut ok : bool := true;
  mut body : *ASTNode := null;
  mut stmt : *ASTNode := null;
  while (param != null && ok) {
    if (!is_supported_value_type((*param).data_type)) { ok := false; }
    param := (*param).next_sibling;
  }
  if (ok) {
    if (!(is_supported_value_type((*decl).data_type) || is_void_type((*decl).data_type))) {
      ok := false;
    }
  }
  if (ok && ((*decl).kind == 113 || (*decl).kind == 162)) {
    body := (*decl).extra;
    if (body != null) {
      stmt := (*body).first_child;
      while (stmt != null && ok) {
        if ((*stmt).kind == 134 && !is_supported_value_type((*stmt).data_type)) {
          ok := false;
        }
        stmt := (*stmt).next_sibling;
      }
    }
  }
  return ok;
}

function scope_reg_for_decl(sc: *Scope, decl: *ASTNode) : uint64 {
  mut i : uint64 := 0;
  mut r : uint64 := 0;
  while (i < (*sc).count) {
    if ((*sc).bindings.ptr[i].decl == decl) {
      r := (*sc).bindings.ptr[i].reg;
    }
    i := i + 1;
  }
  return r;
}

function cg_binop_mnemonic(cg: *Codegen, op_type: int32, is_unsigned: bool) : void {
  if (op_type == 85) { cg_piece(cg, 27); return; }
  if (op_type == 80) { cg_piece(cg, 28); return; }
  if (op_type == 81) { cg_piece(cg, 29); return; }
  if (op_type == 83) {
    if (is_unsigned) { cg_piece(cg, 30); } else { cg_piece(cg, 31); }
    return;
  }
  if (op_type == 84) {
    if (is_unsigned) { cg_piece(cg, 32); } else { cg_piece(cg, 33); }
    return;
  }
  if (op_type == 75) { cg_piece(cg, 34); return; }
  if (op_type == 76) {
    if (is_unsigned) { cg_piece(cg, 35); } else { cg_piece(cg, 36); }
    return;
  }
  if (op_type == 82) { cg_piece(cg, 37); return; }
  if (op_type == 89) { cg_piece(cg, 38); return; }
  cg_piece(cg, 39);
}

function cg_cmp_pred(cg: *Codegen, op_type: int32, is_unsigned: bool) : void {
  if (op_type == 71) { cg_piece(cg, 40); return; }
  if (op_type == 72) { cg_piece(cg, 41); return; }
  if (op_type == 86) {
    if (is_unsigned) { cg_piece(cg, 43); } else { cg_piece(cg, 42); }
    return;
  }
  if (op_type == 87) {
    if (is_unsigned) { cg_piece(cg, 45); } else { cg_piece(cg, 44); }
    return;
  }
  if (op_type == 73) {
    if (is_unsigned) { cg_piece(cg, 47); } else { cg_piece(cg, 46); }
    return;
  }
  if (is_unsigned) { cg_piece(cg, 49); } else { cg_piece(cg, 48); }
}

// gen_expr/gen_and/gen_or/gen_call/gen_block/gen_stmt call each other,
// directly and mutually recursively, in whatever order is convenient
// below -- no forward declaration needed for any of it, the same
// already-confirmed forward-reference support decorate_block/decorate_
// stmt's own mutual recursion already relies on elsewhere in this file.

function gen_and(cg: *Codegen, s: *Sema, sc: *Scope, file_idx: uint64, e: *ASTNode) : Operand {
  mut slot : uint64 := new_reg(cg);
  mut rhs_l : uint64 := new_label(cg);
  mut false_l : uint64 := new_label(cg);
  mut end_l : uint64 := new_label(cg);
  mut left_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut right_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut r : uint64 := 0;

  cg_piece(cg, 1); cg_reg_ref(cg, slot); cg_piece(cg, 2); cg_piece(cg, 6);
  cg_byte(cg, 105); cg_byte(cg, 49); cg_piece(cg, 0);

  left_op := gen_expr(cg, s, sc, file_idx, (*e).left);
  cg_piece(cg, 1); cg_piece(cg, 13); cg_operand(cg, left_op);
  cg_piece(cg, 14); cg_label_target(cg, rhs_l);
  cg_piece(cg, 14); cg_label_target(cg, false_l);
  cg_piece(cg, 0);

  cg_label_def(cg, rhs_l);
  right_op := gen_expr(cg, s, sc, file_idx, (*e).right);
  cg_piece(cg, 1); cg_piece(cg, 9); cg_byte(cg, 105); cg_byte(cg, 49); cg_byte(cg, 32);
  cg_operand(cg, right_op); cg_piece(cg, 8); cg_reg_ref(cg, slot); cg_piece(cg, 0);
  cg_piece(cg, 1); cg_piece(cg, 12); cg_piece(cg, 15); cg_label_target(cg, end_l); cg_piece(cg, 0);

  cg_label_def(cg, false_l);
  cg_piece(cg, 1); cg_piece(cg, 9); cg_byte(cg, 105); cg_byte(cg, 49); cg_byte(cg, 32);
  cg_byte(cg, 48); cg_piece(cg, 8); cg_reg_ref(cg, slot); cg_piece(cg, 0);
  cg_piece(cg, 1); cg_piece(cg, 12); cg_piece(cg, 15); cg_label_target(cg, end_l); cg_piece(cg, 0);

  cg_label_def(cg, end_l);
  r := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 7);
  cg_byte(cg, 105); cg_byte(cg, 49); cg_piece(cg, 8); cg_reg_ref(cg, slot); cg_piece(cg, 0);
  return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

function gen_or(cg: *Codegen, s: *Sema, sc: *Scope, file_idx: uint64, e: *ASTNode) : Operand {
  mut slot : uint64 := new_reg(cg);
  mut true_l : uint64 := new_label(cg);
  mut rhs_l : uint64 := new_label(cg);
  mut end_l : uint64 := new_label(cg);
  mut left_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut right_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut r : uint64 := 0;

  cg_piece(cg, 1); cg_reg_ref(cg, slot); cg_piece(cg, 2); cg_piece(cg, 6);
  cg_byte(cg, 105); cg_byte(cg, 49); cg_piece(cg, 0);

  left_op := gen_expr(cg, s, sc, file_idx, (*e).left);
  cg_piece(cg, 1); cg_piece(cg, 13); cg_operand(cg, left_op);
  cg_piece(cg, 14); cg_label_target(cg, true_l);
  cg_piece(cg, 14); cg_label_target(cg, rhs_l);
  cg_piece(cg, 0);

  cg_label_def(cg, true_l);
  cg_piece(cg, 1); cg_piece(cg, 9); cg_byte(cg, 105); cg_byte(cg, 49); cg_byte(cg, 32);
  cg_byte(cg, 49); cg_piece(cg, 8); cg_reg_ref(cg, slot); cg_piece(cg, 0);
  cg_piece(cg, 1); cg_piece(cg, 12); cg_piece(cg, 15); cg_label_target(cg, end_l); cg_piece(cg, 0);

  cg_label_def(cg, rhs_l);
  right_op := gen_expr(cg, s, sc, file_idx, (*e).right);
  cg_piece(cg, 1); cg_piece(cg, 9); cg_byte(cg, 105); cg_byte(cg, 49); cg_byte(cg, 32);
  cg_operand(cg, right_op); cg_piece(cg, 8); cg_reg_ref(cg, slot); cg_piece(cg, 0);
  cg_piece(cg, 1); cg_piece(cg, 12); cg_piece(cg, 15); cg_label_target(cg, end_l); cg_piece(cg, 0);

  cg_label_def(cg, end_l);
  r := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 7);
  cg_byte(cg, 105); cg_byte(cg, 49); cg_piece(cg, 8); cg_reg_ref(cg, slot); cg_piece(cg, 0);
  return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

// Argument evaluation order is LEFT TO RIGHT (postulate_v1_language_
// reference.md SS3.9's own "Changed" note -- v0's right-to-left rule
// only ever existed for Hoare's/the original proof of concept's push-
// based calling convention, which Stage 1's LLVM IR backend, v1.0.2,
// removed; matching source reading order is what v1 adopts once that
// reason is gone). Straightforwardly a single forward pass: each
// argument's Operand is computed into `ops`, in the same order they're
// written, and the `call` instruction printed afterward just reads
// those already-computed values back out in that same order. Extern
// calls are out of this round's scope (every extern this codebase
// declares takes a pointer argument) -- a callee that isn't an
// ordinary user FUNCTION_DECL just marks had_error.
function gen_call(cg: *Codegen, s: *Sema, sc: *Scope, file_idx: uint64, e: *ASTNode) : Operand {
  mut callee_decl : *ASTNode := (*(*e).left).symbol_ref;
  mut args : *ASTNode[16];
  mut ops : Operand[16];
  mut arg_is_ref : bool[16];
  mut n : uint64 := 0;
  mut arg : *ASTNode := null;
  mut param : *ASTNode := null;
  mut i : uint64 := 0;
  mut r : uint64 := 0;
  mut is_void : bool := false;
  mut indirect : bool := false;
  mut callee_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut ret_ty : *ASTNode := null;
  mut ret_file : uint64 := (*(*e).left).type_file_idx;

  if (callee_decl != null && ((*callee_decl).kind == 113 || (*callee_decl).kind == 112)) {
    param := (*callee_decl).first_child;
    ret_ty := (*callee_decl).data_type;
  } else {
    // v1.1.10: not a named function/extern -- maybe a function-TYPE-
    // typed VALUE instead (a variable/parameter/expression holding a
    // function reference), callable indirectly through its own
    // synthesized FUNC_TYPE signature (Sema's own decorate_expr k==149
    // case already accepts this shape, matching the callee's own
    // argument types against `sig_params` read the same way here).
    // `(*e).left` is evaluated here, ONCE, to get the actual function-
    // pointer VALUE to call through -- a direct call never evaluates
    // its own callee expression at all (there's nothing to compute,
    // `@name` is a compile-time-known symbol), so this only ever
    // triggers for the genuinely-indirect case.
    if ((*(*e).left).data_type != null && (*(*(*e).left).data_type).kind == 161) {
      indirect := true;
      callee_op := gen_expr(cg, s, sc, file_idx, (*e).left);
      param := (*(*(*e).left).data_type).first_child;
      ret_ty := (*(*(*e).left).data_type).data_type;
    } else {
      (*cg).had_error := true;
      return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
    }
  }

  arg := (*e).first_child;
  while (arg != null) {
    args[n] := arg;
    if (param != null && (*param).is_mutable) {
      // `ref` parameter (v1.1.5): the callee's own PARAM_DECL is
      // `ptr`-typed at this position (gen_function's own matching
      // change) -- pass the ARGUMENT's address, never its value, via
      // the exact same gen_addr used for `&x`/assignment targets.
      // Sema's own decorate_expr k==149 case already rejected any
      // non-lvalue argument here, so gen_addr always has a real storage
      // location to compute.
      arg_is_ref[n] := true;
      ops[n] := gen_addr(cg, s, sc, file_idx, arg);
    } else {
      arg_is_ref[n] := false;
      ops[n] := gen_expr(cg, s, sc, file_idx, arg);
    }
    n := n + 1;
    arg := (*arg).next_sibling;
    if (param != null) { param := (*param).next_sibling; }
  }

  is_void := is_void_type(ret_ty);

  cg_piece(cg, 1);
  if (!is_void) {
    r := new_reg(cg);
    cg_reg_ref(cg, r);
    cg_piece(cg, 2);
  }
  cg_piece(cg, 16);
  cg_type(cg, s, ret_file, ret_ty);
  cg_byte(cg, 32);
  if (indirect) {
    cg_operand(cg, callee_op);
  } else {
    cg_byte(cg, 64);
    cg_slice(cg, &(*(*s).buffers)[ret_file].bytes, (*callee_decl).tok.offset, (*callee_decl).tok.length);
  }
  cg_piece(cg, 24);
  i := 0;
  while (i < n) {
    if (i > 0) { cg_piece(cg, 3); }
    if (arg_is_ref[i]) {
      cg_piece(cg, 51);
    } else {
      cg_type(cg, s, (*args[i]).type_file_idx, (*args[i]).data_type);
    }
    cg_byte(cg, 32);
    cg_operand(cg, ops[i]);
    i := i + 1;
  }
  cg_piece(cg, 25);
  cg_piece(cg, 0);

  if (is_void) {
    return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }
  return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

// Sets are already validated by Module 3 (type/category, operand
// equality, pointer/`as` special cases) -- codegen only ever needs to
// pick the right opcode/predicate and read data_type for width/sign,
// never re-check legality. Anything reached here outside this slice's
// scope (pointers/structs/arrays/casts/sizeof) sets had_error.
// `p + n`/`n + p` (postulate_v1_language_reference.md SS2.5): whichever
// side is the pointer lends its own pointee type to `getelementptr`'s
// own required element-type operand; the other side is the raw index,
// used at its own already-resolved integer type/width, no widening to
// i64 needed (GEP accepts an index of any integer width). Module 3
// already rejected `p + p` and `*void` arithmetic before this can ever
// be reached, so ptr_ty's own pointee (`.left`) is always a real,
// non-null scalar type here.
function gen_ptr_add(cg: *Codegen, s: *Sema, file_idx: uint64, e: *ASTNode, left_op: Operand, right_op: Operand, lcat: int32) : Operand {
  mut ptr_op : Operand := left_op;
  mut int_op : Operand := right_op;
  mut ptr_ty : *ASTNode := (*(*e).left).data_type;
  mut int_ty : *ASTNode := (*(*e).right).data_type;
  mut ptr_file : uint64 := (*(*e).left).type_file_idx;
  mut int_file : uint64 := (*(*e).right).type_file_idx;
  mut r : uint64 := 0;

  if (lcat != 4) {
    ptr_op := right_op;
    int_op := left_op;
    ptr_ty := (*(*e).right).data_type;
    int_ty := (*(*e).left).data_type;
    ptr_file := (*(*e).right).type_file_idx;
    int_file := (*(*e).left).type_file_idx;
  }

  r := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 52);
  cg_type(cg, s, ptr_file, (*ptr_ty).left);
  cg_piece(cg, 3);
  cg_piece(cg, 51); cg_byte(cg, 32);
  cg_operand(cg, ptr_op);
  cg_piece(cg, 3);
  cg_type(cg, s, int_file, int_ty);
  cg_byte(cg, 32);
  cg_operand(cg, int_op);
  cg_piece(cg, 0);
  return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

// `p - n` negates the index first (GEP has no separate "subtract"
// mode, only ever adds a signed index) then reuses the exact same GEP
// shape as `p + n`. `p1 - p2` (same pointee type, Module 3's own
// requirement) has no single GEP-based lowering -- the standard
// technique is `ptrtoint` both sides to `i64`, `sub`, then `sdiv` by
// the pointee's own byte size to turn a byte distance into an element
// count (postulate_v1_language_reference.md SS2.5's own "number of
// T-sized elements between them").
function gen_ptr_sub(cg: *Codegen, s: *Sema, file_idx: uint64, e: *ASTNode, left_op: Operand, right_op: Operand, rcat: int32) : Operand {
  mut ptr_ty : *ASTNode := (*(*e).left).data_type;
  mut int_ty : *ASTNode := (*(*e).right).data_type;
  mut ptr_file : uint64 := (*(*e).left).type_file_idx;
  mut int_file : uint64 := (*(*e).right).type_file_idx;
  mut r : uint64 := 0;
  mut a : uint64 := 0;
  mut b : uint64 := 0;
  mut neg : uint64 := 0;
  mut sz : uint64 := 0;

  if (rcat == 4) {
    a := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, a); cg_piece(cg, 2); cg_piece(cg, 53);
    cg_piece(cg, 51); cg_byte(cg, 32);
    cg_operand(cg, left_op);
    cg_piece(cg, 54); cg_piece(cg, 0);

    b := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, b); cg_piece(cg, 2); cg_piece(cg, 53);
    cg_piece(cg, 51); cg_byte(cg, 32);
    cg_operand(cg, right_op);
    cg_piece(cg, 54); cg_piece(cg, 0);

    r := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 28);
    cg_byte(cg, 32); cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
    cg_reg_ref(cg, a); cg_piece(cg, 3); cg_reg_ref(cg, b); cg_piece(cg, 0);

    sz := type_byte_size(cg, s, ptr_file, (*ptr_ty).left);
    neg := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, neg); cg_piece(cg, 2); cg_piece(cg, 31);
    cg_byte(cg, 32); cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
    cg_reg_ref(cg, r); cg_piece(cg, 3); cg_uint(cg, sz); cg_piece(cg, 0);
    return Operand { is_reg := true, reg := neg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }

  neg := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, neg); cg_piece(cg, 2); cg_piece(cg, 28);
  cg_byte(cg, 32);
  cg_type(cg, s, int_file, int_ty);
  cg_byte(cg, 32); cg_byte(cg, 48); cg_piece(cg, 3);
  cg_operand(cg, right_op);
  cg_piece(cg, 0);

  r := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 52);
  cg_type(cg, s, ptr_file, (*ptr_ty).left);
  cg_piece(cg, 3);
  cg_piece(cg, 51); cg_byte(cg, 32);
  cg_operand(cg, left_op);
  cg_piece(cg, 3);
  cg_type(cg, s, int_file, int_ty); cg_byte(cg, 32);
  cg_reg_ref(cg, neg);
  cg_piece(cg, 0);
  return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

// `sizeof`/`lengthof` (postulate_v1_language_reference.md SS2.7a) are
// purely compile-time, type-level queries -- the answer never depends
// on a value at runtime, so this never emits any instructions at all,
// just folds straight to an immediate. A struct-named TYPE_BASE (kind
// 120, not a builtin keyword) delegates to Module 3's own field_type_
// size/compute_struct_size (Symbol's own sizing pass, already run to
// completion before codegen starts, per struct sizing_state's own
// white/gray/black cycle-detection contract) rather than recomputing
// struct layout here a second time.
function type_byte_size(cg: *Codegen, s: *Sema, file_idx: uint64, ty: *ASTNode) : uint64 {
  if (ty == null) {
    (*cg).had_error := true;
    return 0;
  }
  if ((*ty).kind == 121) { return 8; }
  if ((*ty).kind == 122) {
    return type_byte_size(cg, s, file_idx, (*ty).left) * int64_to_uint64((*ty).int_val);
  }
  if ((*ty).kind != 120) {
    (*cg).had_error := true;
    return 0;
  }
  if (base_type_size((*ty).tok.kind) > 0) {
    return base_type_size((*ty).tok.kind);
  }
  return field_type_size(s, ty, file_idx);
}

// `as` (postulate_v1_language_reference.md SS3.7a's own conversion
// table -- already fully legality-checked by Module 3, so every pair
// reached here is real): opaque pointers make `*T -> *U` an outright
// no-op (same "ptr" either way, nothing to convert); same-width
// integer/`char` pairs are also a no-op (identical bit pattern);
// everything else picks the one LLVM instruction that actually applies
// -- `ptrtoint`/`inttoptr` for the pointer/`uintptr` pair, `zext`/
// `icmp ne ..., 0` for `bool` in from/to an integer (`false`/`true` ->
// `0`/`1` and back, matching the table's own wording exactly), and
// `zext`/`sext`/`trunc` by width otherwise (`sext` only when the
// source is signed -- an unsigned source always zero-extends).
function gen_cast(cg: *Codegen, s: *Sema, sc: *Scope, file_idx: uint64, e: *ASTNode) : Operand {
  mut src_op : Operand := gen_expr(cg, s, sc, file_idx, (*e).left);
  mut src_ty : *ASTNode := (*(*e).left).data_type;
  mut dst_ty : *ASTNode := (*e).data_type;
  mut src_cat : int32 := cast_category(src_ty);
  mut dst_cat : int32 := cast_category(dst_ty);
  mut r : uint64 := 0;
  mut sw : uint64 := 0;
  mut dw : uint64 := 0;

  if ((src_cat == 4 && dst_cat == 4) || (src_cat == 2 && dst_cat == 2)) {
    return src_op;
  }
  // v1.1.n: a struct/array-category ("0") cast only ever reaches here
  // when Sema's own identity-cast check (types_equal(src,dst), CAST_EXPR
  // decoration) already confirmed it's a pure type ascription -- the
  // exact same type on both sides -- never a real cross-type composite
  // conversion (those stay illegal, matching Rust/Zig's own deliberate
  // restriction of `as` to scalars). Nothing to convert, the value's
  // already exactly the right shape.
  if (src_cat == 0 && dst_cat == 0) {
    return src_op;
  }

  if (src_cat == 4 && dst_cat == 1) {
    r := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 53);
    cg_piece(cg, 51); cg_byte(cg, 32);
    cg_operand(cg, src_op);
    cg_piece(cg, 54); cg_piece(cg, 0);
    return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }
  if (src_cat == 1 && dst_cat == 4) {
    r := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 55);
    cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
    cg_operand(cg, src_op);
    cg_piece(cg, 56); cg_piece(cg, 0);
    return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }

  if (src_cat == 2) {
    r := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 57);
    cg_byte(cg, 105); cg_uint(cg, 1); cg_byte(cg, 32);
    cg_operand(cg, src_op);
    cg_piece(cg, 60);
    cg_type(cg, s, file_idx, dst_ty);
    cg_piece(cg, 0);
    return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }
  if (dst_cat == 2) {
    r := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 17); cg_piece(cg, 41);
    cg_byte(cg, 32);
    cg_type(cg, s, (*(*e).left).type_file_idx, src_ty);
    cg_byte(cg, 32);
    cg_operand(cg, src_op);
    cg_piece(cg, 3); cg_byte(cg, 48); cg_piece(cg, 0);
    return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }

  // v1.1.3: float-family casts -- checked before the generic integer-
  // width fallback below, which reads llvm_int_width (meaningless for a
  // float type) and would otherwise emit a `trunc`/`zext`/`sext` on a
  // float value, invalid IR.
  if (src_cat == 6 && dst_cat == 6) {
    sw := base_type_size((*src_ty).tok.kind);
    dw := base_type_size((*dst_ty).tok.kind);
    if (sw == dw) {
      // float32<->ufloat32 or float64<->ufloat64: identical LLVM type
      // either way (`float`/`double` carry no signedness of their own).
      return src_op;
    }
    r := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
    if (dw > sw) {
      cg_byte(cg, 102); cg_byte(cg, 112); cg_byte(cg, 101); cg_byte(cg, 120); cg_byte(cg, 116); cg_byte(cg, 32);
    } else {
      cg_byte(cg, 102); cg_byte(cg, 112); cg_byte(cg, 116); cg_byte(cg, 114); cg_byte(cg, 117); cg_byte(cg, 110); cg_byte(cg, 99); cg_byte(cg, 32);
    }
    cg_type(cg, s, (*(*e).left).type_file_idx, src_ty);
    cg_byte(cg, 32);
    cg_operand(cg, src_op);
    cg_piece(cg, 60);
    cg_type(cg, s, file_idx, dst_ty);
    cg_piece(cg, 0);
    return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }
  if (src_cat == 6 && dst_cat == 1) {
    r := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
    if (is_unsigned_for_cast((*dst_ty).tok.kind)) {
      cg_byte(cg, 102); cg_byte(cg, 112); cg_byte(cg, 116); cg_byte(cg, 111); cg_byte(cg, 117); cg_byte(cg, 105); cg_byte(cg, 32);
    } else {
      cg_byte(cg, 102); cg_byte(cg, 112); cg_byte(cg, 116); cg_byte(cg, 111); cg_byte(cg, 115); cg_byte(cg, 105); cg_byte(cg, 32);
    }
    cg_type(cg, s, (*(*e).left).type_file_idx, src_ty);
    cg_byte(cg, 32);
    cg_operand(cg, src_op);
    cg_piece(cg, 60);
    cg_type(cg, s, file_idx, dst_ty);
    cg_piece(cg, 0);
    return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }
  if (src_cat == 1 && dst_cat == 6) {
    r := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
    if (is_unsigned_for_cast((*src_ty).tok.kind)) {
      cg_byte(cg, 117); cg_byte(cg, 105); cg_byte(cg, 116); cg_byte(cg, 111); cg_byte(cg, 102); cg_byte(cg, 112); cg_byte(cg, 32);
    } else {
      cg_byte(cg, 115); cg_byte(cg, 105); cg_byte(cg, 116); cg_byte(cg, 111); cg_byte(cg, 102); cg_byte(cg, 112); cg_byte(cg, 32);
    }
    cg_type(cg, s, (*(*e).left).type_file_idx, src_ty);
    cg_byte(cg, 32);
    cg_operand(cg, src_op);
    cg_piece(cg, 60);
    cg_type(cg, s, file_idx, dst_ty);
    cg_piece(cg, 0);
    return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }

  sw := llvm_int_width((*src_ty).tok.kind);
  dw := llvm_int_width((*dst_ty).tok.kind);
  if (sw == dw) {
    return src_op;
  }
  r := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  if (dw > sw) {
    if (is_unsigned_for_cast((*src_ty).tok.kind)) {
      cg_piece(cg, 57);
    } else {
      cg_piece(cg, 58);
    }
  } else {
    cg_piece(cg, 59);
  }
  cg_type(cg, s, (*(*e).left).type_file_idx, src_ty);
  cg_byte(cg, 32);
  cg_operand(cg, src_op);
  cg_piece(cg, 60);
  cg_type(cg, s, file_idx, dst_ty);
  cg_piece(cg, 0);
  return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

// v1.1.10: a bare reference to a function/extern name (not immediately
// called) is a FUNC_TYPE-typed value -- Sema's own decorate_expr
// k==140/163 case already synthesizes that type (make_func_type_from_
// decl), but the symbol itself has no local "slot" to `load` from the
// way a variable/parameter does: LLVM function symbols are already
// addresses, never `alloca`'d. A single zero-offset `getelementptr`
// materializes that address into an ordinary register instead, exactly
// like any other computed pointer value -- every later use of it (an
// indirect call through it, storing it into a FUNC_TYPE-typed local,
// passing it as an argument) then needs no special case of its own,
// since it flows out of gen_expr as an ordinary Operand like anything
// else.
function gen_global_func_addr(cg: *Codegen, s: *Sema, file_idx: uint64, decl: *ASTNode) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 52);
  cg_byte(cg, 105); cg_uint(cg, 8);
  cg_piece(cg, 3);
  cg_piece(cg, 51); cg_byte(cg, 32);
  cg_byte(cg, 64);
  cg_slice(cg, &(*(*s).buffers)[file_idx].bytes, (*decl).tok.offset, (*decl).tok.length);
  cg_piece(cg, 3);
  cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32); cg_byte(cg, 48);
  cg_piece(cg, 0);
  return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

// ---------------------------------------------------------------------
// FLOAT_LIT -> IEEE-754 binary64 bits, in pure integer arithmetic.
//
// Why this exists at all: FLOAT_LIT (unlike every other literal kind)
// stores no pre-computed value of its own -- the ASTNode kind table's
// own comment says so -- so Codegen has to convert the raw source text
// itself. It has to do this WITHOUT ever using a `float`/`double` value
// anywhere in its OWN implementation: this file is compiled by the
// vendored `codegen_selfhost` bootstrap binary (see ../../scripts/
// build.sh), a frozen snapshot of the OLD, pre-float architecture that
// has no idea what a float type even is. Every step below is ordinary
// uint64/128-bit-pair (two uint64s) integer arithmetic.
//
// Scope: plain decimal form (`digit+ . digit+ (e[+-]?digit+)?`) AND
// based form (`digit+ n value_digit+ (.value_digit+)? (exponent)?`,
// bases 2/8/10/16 -- float_lit_is_based_form/parse_based_float_literal,
// below). Base 10's own based form (`10n123.45e6`) reuses the plain-
// decimal machinery outright (float_literal_to_bits) once its digits
// and net exponent are read in the based-form's own value_digit shape
// -- decimal scaling doesn't care which literal SYNTAX produced its
// `digits`/`dec_exp` pair. Bases 2/8/16 skip decimal scaling entirely:
// being powers of two, `digits * base^net_exp` is an EXACT binary
// shift (`based_float_to_bits`), never an approximation the way
// scaling by a non-power-of-two base would need.
//
// Precision: correct across the full representable exponent range
// (underflows to +0.0 / overflows to +inf rather than wrapping or
// crashing), but the final mantissa extraction TRUNCATES rather than
// round-to-nearest -- at most 1 ULP of error, judged an acceptable
// trade for how much more intricate a fully round-to-nearest-even
// implementation would be to get right without any way to cross-check
// it against a working float implementation on the SAME machine.
// ---------------------------------------------------------------------

// Built via a shift, never spelled as a literal >~1.3 billion: this
// exact Edsger v0/v1 compiler generation has a genuine, confirmed
// front-end performance bug where a hand-written decimal integer
// literal past roughly that magnitude makes compilation itself
// severely CPU-bound (near-hang) -- the same workaround already used
// for max_value_for_anchor's own large constants elsewhere in this
// codebase. Called (not inlined as a `const`, since this language has
// none), which costs nothing at the RUNTIME of the resulting compiled
// program -- the slow part was only ever THIS file's own compile time.
function mask32() : uint64 {
  mut one : uint64 := 1;
  return (one << 32) - 1;
}

function two_pow_32() : uint64 {
  mut one : uint64 := 1;
  return one << 32;
}

function mask52() : uint64 {
  mut one : uint64 := 1;
  return (one << 52) - 1;
}

// binary64's own all-ones exponent field (2047 = 2^11 - 1) -- used only
// to build the "overflowed to infinity" bit pattern, as a uint64 (the
// plain literal `2047 << 52` doesn't anchor to uint64 on its own here:
// both operands of that shift are bare literals, and Sema's own
// anchoring rule only kicks in when at least one side is ALREADY
// concretely typed).
function inf_exp_bits() : uint64 {
  mut e : uint64 := 2047;
  return e;
}

// A 128-bit unsigned value as two uint64 halves -- this language has no
// native 128-bit integer type, and the intermediate values scaling a
// decimal literal by a large power of ten need more than 64 bits of
// headroom.
struct Wide128 {
  hi : uint64;
  lo : uint64;
}

function wide_shl(w: Wide128, k: uint64) : Wide128 {
  if (k == 0) { return w; }
  if (k >= 128) { return Wide128 { hi := 0, lo := 0 }; }
  if (k >= 64) { return Wide128 { hi := w.lo << (k - 64), lo := 0 }; }
  return Wide128 { hi := (w.hi << k) | (w.lo >> (64 - k)), lo := w.lo << k };
}

function wide_shr(w: Wide128, k: uint64) : Wide128 {
  if (k == 0) { return w; }
  if (k >= 128) { return Wide128 { hi := 0, lo := 0 }; }
  if (k >= 64) { return Wide128 { hi := 0, lo := w.hi >> (k - 64) }; }
  return Wide128 { hi := w.hi >> k, lo := (w.lo >> k) | (w.hi << (64 - k)) };
}

// w * 10, as an exact 128-bit result -- schoolbook long multiplication
// across four 32-bit limbs (base 2^32) rather than a naive `hi << 32`-
// style split, which would silently overflow a uint64 register (a
// 36-bit partial product shifted left by 32 needs up to 68 bits, more
// than fits). The caller is expected to have already shifted `w` right
// (via wide_shr, tracking the same shift as a binary-exponent
// adjustment) whenever its own top nibble is nonzero, so the true
// 128-bit product here never actually needs a 5th limb.
function wide_mul10(w: Wide128) : Wide128 {
  mut l0 : uint64 := w.lo & mask32();
  mut l1 : uint64 := w.lo >> 32;
  mut l2 : uint64 := w.hi & mask32();
  mut l3 : uint64 := w.hi >> 32;
  mut c : uint64 := 0;
  mut r : uint64 := 0;
  mut n0 : uint64 := 0;
  mut n1 : uint64 := 0;
  mut n2 : uint64 := 0;
  mut n3 : uint64 := 0;

  r := l0 * 10 + c; n0 := r & mask32(); c := r >> 32;
  r := l1 * 10 + c; n1 := r & mask32(); c := r >> 32;
  r := l2 * 10 + c; n2 := r & mask32(); c := r >> 32;
  r := l3 * 10 + c; n3 := r & mask32();

  return Wide128 { hi := (n3 << 32) | n2, lo := (n1 << 32) | n0 };
}

struct WideDiv10Result {
  q : Wide128;
  rem : uint64;
}

// w / 10, exact quotient and remainder -- base-2^32 long division
// across the same four limbs, most-significant first, carrying each
// step's remainder (always < 10) into the next.
function wide_div10(w: Wide128) : WideDiv10Result {
  mut l3 : uint64 := w.hi >> 32;
  mut l2 : uint64 := w.hi & mask32();
  mut l1 : uint64 := w.lo >> 32;
  mut l0 : uint64 := w.lo & mask32();
  mut rem : uint64 := 0;
  mut cur : uint64 := 0;
  mut q3 : uint64 := 0;
  mut q2 : uint64 := 0;
  mut q1 : uint64 := 0;
  mut q0 : uint64 := 0;

  cur := rem * two_pow_32() + l3; q3 := cur / 10; rem := cur % 10;
  cur := rem * two_pow_32() + l2; q2 := cur / 10; rem := cur % 10;
  cur := rem * two_pow_32() + l1; q1 := cur / 10; rem := cur % 10;
  cur := rem * two_pow_32() + l0; q0 := cur / 10; rem := cur % 10;

  return WideDiv10Result { q := Wide128 { hi := (q3 << 32) | q2, lo := (q1 << 32) | q0 }, rem := rem };
}

function highest_set_bit(x: uint64) : uint64 {
  mut n : uint64 := 0;
  mut v : uint64 := x;
  while (v > 1) {
    v := v >> 1;
    n := n + 1;
  }
  return n;
}

function highest_set_bit_wide(w: Wide128) : uint64 {
  if (w.hi != 0) { return 64 + highest_set_bit(w.hi); }
  return highest_set_bit(w.lo);
}

struct FloatParts {
  digits : uint64;
  dec_exp : int64;
}

// `digit+ 'n' ...` (the lexer's own based-form marker, right after the
// leading digit run) vs `digit+ '.' ...` (plain form, which a FLOAT_LIT
// always has, per the ASTNode kind table's own comment) -- cheap to
// tell apart without parsing either form fully.
function float_lit_is_based_form(src: *DynBytes, offset: uint64, length: uint64) : bool {
  mut i : uint64 := 0;
  while (i < length && is_digit((*src).ptr[offset + i])) {
    i := i + 1;
  }
  return i < length && (*src).ptr[offset + i] == 110;
}

// How many bits one value_digit is worth in a power-of-two base -- 0
// for base 10 (never used there; that path reuses float_literal_to_
// bits' own decimal scaling instead, see this section's own header
// comment).
function bits_per_digit_for_base(base: uint64) : uint64 {
  if (base == 2) { return 1; }
  if (base == 8) { return 3; }
  if (base == 16) { return 4; }
  return 0;
}

// How many value_digits fit in a uint64 accumulator without overflow,
// per base -- base^max_digits - 1 (every digit at its own max value)
// must stay <= uint64's own max (2^64 - 1): 2^64-1 exactly at 64
// binary digits, 2^63-1 at 21 octal digits (22 would need 66 bits),
// 2^64-1 exactly at 16 hex digits. Base 10 mirrors parse_float_
// literal's own existing 19-digit cap, for the same reason given
// there (ample for a binary64 mantissa's own ~15-17 significant
// decimal digits).
function max_value_digits_for_base(base: uint64) : uint64 {
  if (base == 2) { return 64; }
  if (base == 8) { return 21; }
  if (base == 16) { return 16; }
  return 19;
}

struct BasedFloatParts {
  digits : uint64;
  base : uint64;
  // Net exponent in value_digit POSITION units (mirrors FloatParts'
  // own dec_exp exactly) -- base 10 hands this straight to float_
  // literal_to_bits unchanged; bases 2/8/16 scale it by bits_per_
  // digit_for_base first (based_float_to_bits), since there it's a
  // binary shift amount instead of a decimal one.
  net_exp : int64;
}

// `digit+ 'n' value_digit+ ('.' value_digit+)? (exponent)?` (see
// float_lit_is_based_form) -- same digit-accumulation shape as parse_
// float_literal (a running `digits` value, a dropped/fractional digit
// count folded into one net exponent), just reading `base`-radix
// value_digits (byte_digit_value, already restricted to the declared
// base at LEX time -- is_value_digit_for_base) instead of always-
// decimal ones, and choosing the exponent marker (`p`/`P` for base 16,
// `e`/`E` otherwise) the same way the lexer's own scan_number already
// does. Never called on a malformed literal -- the lexer already
// guarantees a well-formed token (has_value_digit/has_exp_digit)
// reaches here, same trust boundary every other literal-value reader
// in this file already relies on.
function parse_based_float_literal(src: *DynBytes, offset: uint64, length: uint64) : BasedFloatParts {
  mut i : uint64 := 0;
  mut base : uint64 := 0;
  mut digits : uint64 := 0;
  mut ndigits : uint64 := 0;
  mut max_digits : uint64 := 0;
  mut frac_digits : int64 := 0;
  mut dropped_digits : int64 := 0;
  mut exp_marker_hi : uint8 := 101;  // 'e'
  mut exp_marker_lo : uint8 := 69;   // 'E'
  mut exp_negative : bool := false;
  mut exp_val : int64 := 0;

  while (i < length && is_digit((*src).ptr[offset + i])) {
    base := base * 10 + byte_digit_value((*src).ptr[offset + i]);
    i := i + 1;
  }
  i := i + 1; // skip the 'n' float_lit_is_based_form already confirmed

  max_digits := max_value_digits_for_base(base);

  while (i < length && is_value_digit_for_base((*src).ptr[offset + i], base)) {
    if (ndigits < max_digits) {
      digits := digits * base + byte_digit_value((*src).ptr[offset + i]);
      ndigits := ndigits + 1;
    } else {
      dropped_digits := dropped_digits + 1;
    }
    i := i + 1;
  }

  if (i < length && (*src).ptr[offset + i] == 46) {
    i := i + 1;
    while (i < length && is_value_digit_for_base((*src).ptr[offset + i], base)) {
      if (ndigits < max_digits) {
        digits := digits * base + byte_digit_value((*src).ptr[offset + i]);
        ndigits := ndigits + 1;
        frac_digits := frac_digits + 1;
      }
      i := i + 1;
    }
  }

  if (base == 16) {
    exp_marker_hi := 112;  // 'p'
    exp_marker_lo := 80;   // 'P'
  }
  if (i < length && ((*src).ptr[offset + i] == exp_marker_hi || (*src).ptr[offset + i] == exp_marker_lo)) {
    i := i + 1;
    if (i < length && (*src).ptr[offset + i] == 43) {
      i := i + 1;
    } else {
      if (i < length && (*src).ptr[offset + i] == 45) {
        exp_negative := true;
        i := i + 1;
      }
    }
    while (i < length && is_digit((*src).ptr[offset + i])) {
      exp_val := exp_val * 10 + uint64_to_int64(byte_digit_value((*src).ptr[offset + i]));
      i := i + 1;
    }
  }
  if (exp_negative) { exp_val := 0 - exp_val; }

  return BasedFloatParts { digits := digits, base := base, net_exp := exp_val - frac_digits + dropped_digits };
}

// Plain decimal form only (see float_lit_is_based_form) -- collects up
// to 19 significant digits (ample for a 53-bit binary mantissa's own
// ~15-17 significant decimal digits; anything beyond that in a hand-
// written literal carries no additional real precision anyway) into a
// single uint64, and folds the decimal point position, any `e`/`E`
// exponent, AND whatever integer-part digits were dropped past the
// 19-digit cap into one net decimal exponent -- `digits * 10^dec_exp`
// is then the literal's own exact value.
function parse_float_literal(src: *DynBytes, offset: uint64, length: uint64) : FloatParts {
  mut i : uint64 := 0;
  mut digits : uint64 := 0;
  mut ndigits : uint64 := 0;
  mut frac_digits : int64 := 0;
  mut dropped_int_digits : int64 := 0;
  mut exp_negative : bool := false;
  mut exp_val : int64 := 0;

  while (i < length && is_digit((*src).ptr[offset + i])) {
    if (ndigits < 19) {
      digits := digits * 10 + byte_digit_value((*src).ptr[offset + i]);
      ndigits := ndigits + 1;
    } else {
      dropped_int_digits := dropped_int_digits + 1;
    }
    i := i + 1;
  }
  if (i < length && (*src).ptr[offset + i] == 46) {
    i := i + 1;
    while (i < length && is_digit((*src).ptr[offset + i])) {
      if (ndigits < 19) {
        digits := digits * 10 + byte_digit_value((*src).ptr[offset + i]);
        ndigits := ndigits + 1;
        frac_digits := frac_digits + 1;
      }
      i := i + 1;
    }
  }
  if (i < length && ((*src).ptr[offset + i] == 101 || (*src).ptr[offset + i] == 69)) {
    i := i + 1;
    if (i < length && (*src).ptr[offset + i] == 43) {
      i := i + 1;
    } else {
      if (i < length && (*src).ptr[offset + i] == 45) {
        exp_negative := true;
        i := i + 1;
      }
    }
    while (i < length && is_digit((*src).ptr[offset + i])) {
      exp_val := exp_val * 10 + uint64_to_int64(byte_digit_value((*src).ptr[offset + i]));
      i := i + 1;
    }
  }
  if (exp_negative) { exp_val := 0 - exp_val; }

  return FloatParts { digits := digits, dec_exp := exp_val - frac_digits + dropped_int_digits };
}

// `digits * 10^dec_exp` -> IEEE-754 binary64 bits. `digits` starts as a
// 128-bit value (hi=0) and is repeatedly multiplied or divided by 10,
// `abs(dec_exp)` times -- cheap even at its largest realistic magnitude
// (a few hundred iterations for an extreme exponent like `1e300`).
// Interleaved renormalization (shifting the whole 128-bit pair by 4
// bits before a multiply that would otherwise overflow it, or widening
// by 1 bit before a divide that would otherwise waste precision) keeps
// a running binary-exponent correction (`bexp`) consistent throughout,
// exactly the technique a simple (non-Grisu/Ryu) `strtod` uses.
// Shared core: `digits * 10^dec_exp * 2^start_bin_exp` -> IEEE-754
// binary64 bits. `start_bin_exp` is 0 for a plain decimal literal
// (float_literal_to_bits, below) -- based_float_to_bits (also below)
// instead passes `dec_exp := 0` and a nonzero `start_bin_exp`, since a
// power-of-two base's own scaling is an EXACT bit shift, needing none
// of this loop's decimal renormalization at all.
function digits_to_bits_core(digits: uint64, dec_exp: int64, start_bin_exp: int64) : uint64 {
  mut w : Wide128 := Wide128 { hi := 0, lo := digits };
  mut bexp : int64 := start_bin_exp;
  mut d : WideDiv10Result := WideDiv10Result { q := Wide128 { hi := 0, lo := 0 }, rem := 0 };
  mut msb : uint64 := 0;
  mut unbiased_exp : int64 := 0;
  mut biased_exp : int64 := 0;
  mut mantissa_bits : uint64 := 0;
  mut shifted : Wide128 := Wide128 { hi := 0, lo := 0 };

  if (digits == 0) { return 0; }

  while (dec_exp > 0) {
    while ((w.hi >> 60) != 0) {
      w := wide_shr(w, 4);
      bexp := bexp + 4;
    }
    w := wide_mul10(w);
    dec_exp := dec_exp - 1;
  }

  while (dec_exp < 0) {
    while ((w.hi >> 63) == 0) {
      w := wide_shl(w, 1);
      bexp := bexp - 1;
    }
    d := wide_div10(w);
    w := d.q;
    dec_exp := dec_exp + 1;
  }

  msb := highest_set_bit_wide(w);
  unbiased_exp := uint64_to_int64(msb) + bexp;

  if (msb >= 52) {
    shifted := wide_shr(w, msb - 52);
  } else {
    shifted := wide_shl(w, 52 - msb);
  }
  mantissa_bits := shifted.lo & mask52();

  biased_exp := unbiased_exp + 1023;
  if (biased_exp <= 0) { return 0; }
  if (biased_exp >= 2047) { return inf_exp_bits() << 52; }

  return (int64_to_uint64(biased_exp) << 52) | mantissa_bits;
}

function float_literal_to_bits(digits: uint64, dec_exp: int64) : uint64 {
  return digits_to_bits_core(digits, dec_exp, 0);
}

// A based-form float whose declared base is a power of two (2/8/16):
// `digits * base^net_exp` is then an EXACT binary shift (`net_exp *
// bits_per_digit`, base 10's own decimal scaling never involved) --
// `digits_to_bits_core` still does the actual mantissa-alignment/
// rounding/exponent-biasing work, just starting from this bit shift
// directly instead of running its own decimal renormalization loop
// (which never executes here, since `dec_exp` is always 0 in this
// path).
function based_float_to_bits(digits: uint64, net_bin_exp: int64) : uint64 {
  return digits_to_bits_core(digits, 0, net_bin_exp);
}

function gen_float_literal(cg: *Codegen, s: *Sema, file_idx: uint64, e: *ASTNode) : Operand {
  mut src : *DynBytes := &(*(*s).buffers)[file_idx].bytes;
  mut parts : FloatParts := FloatParts { digits := 0, dec_exp := 0 };
  mut based : BasedFloatParts := BasedFloatParts { digits := 0, base := 0, net_exp := 0 };
  mut bits : uint64 := 0;

  // v1.1.n: `_/`'s own desugaring (Sema.ptl, op==166) builds a
  // synthetic FLOAT_LIT for the constant `1.0` (its own `1.0/n`
  // rewrite needs one) -- `op_type := 999` there marks it as such.
  // Every OTHER FLOAT_LIT reaching here is a real, source-derived
  // literal whose value lives in its own `tok` text (read below); this
  // synthetic one has an empty (zero-length, alloc_node-zeroed) tok
  // instead, since it was never actually written anywhere in the
  // source -- reading zero bytes of "value text" from it would
  // silently parse as 0.0, not 1.0 (a real bug this exact case hit:
  // `2.0 _/ 4.0` computed `4.0 ** (0.0/2.0)` == 1.0, not `4.0 ** 0.5`
  // == 2.0, until this check was added).
  if ((*e).op_type == 999) {
    return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := true, float_bits := float_literal_to_bits(1, 0) };
  }

  if (float_lit_is_based_form(src, (*e).tok.offset, (*e).tok.length)) {
    based := parse_based_float_literal(src, (*e).tok.offset, (*e).tok.length);
    // Only bases 2/8/10/16 have a defined conversion (base_type_size's
    // own header comment on `based_form` scope) -- an unsupported base
    // would silently mean "no scaling at all" if it fell through to
    // based_float_to_bits below (bits_per_digit_for_base's own 0
    // default), so this errors loudly instead. Unreachable for an
    // INTEGER based-form literal of any other base (those stay legal,
    // unaffected by this float-only restriction), only a based-form
    // FLOAT (a fraction or exponent present) can even reach gen_float_
    // literal at all.
    if (based.base != 2 && based.base != 8 && based.base != 10 && based.base != 16) {
      (*cg).had_error := true;
      return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
    }
    if (based.base == 10) {
      bits := float_literal_to_bits(based.digits, based.net_exp);
    } else {
      bits := based_float_to_bits(based.digits, based.net_exp * uint64_to_int64(bits_per_digit_for_base(based.base)));
    }
    return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := true, float_bits := bits };
  }

  parts := parse_float_literal(src, (*e).tok.offset, (*e).tok.length);
  return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := true, float_bits := float_literal_to_bits(parts.digits, parts.dec_exp) };
}

// `fadd`/`fsub`/`fmul`/`fdiv` -- float arithmetic has no signed/
// unsigned distinction (unlike cg_binop_mnemonic's own integer
// opcodes), and `%` never reaches here (Sema keeps it integer-only).
function cg_float_binop_mnemonic(cg: *Codegen, op_type: int32) : void {
  if (op_type == 85) { cg_byte(cg, 102); cg_byte(cg, 97); cg_byte(cg, 100); cg_byte(cg, 100); return; }
  if (op_type == 80) { cg_byte(cg, 102); cg_byte(cg, 115); cg_byte(cg, 117); cg_byte(cg, 98); return; }
  if (op_type == 81) { cg_byte(cg, 102); cg_byte(cg, 109); cg_byte(cg, 117); cg_byte(cg, 108); return; }
  cg_byte(cg, 102); cg_byte(cg, 100); cg_byte(cg, 105); cg_byte(cg, 118);
}

// `fcmp`'s own ORDERED predicates (NaN never compares true/equal to
// anything, including itself, under any of these -- the natural
// default for an ordinary language comparison, and the same choice
// `oeq`/`one`/etc. rather than `ueq`/`une` makes everywhere else this
// kind of unordered-vs-ordered choice comes up).
function cg_float_cmp_pred(cg: *Codegen, op_type: int32) : void {
  if (op_type == 71) { cg_byte(cg, 111); cg_byte(cg, 101); cg_byte(cg, 113); return; }
  if (op_type == 72) { cg_byte(cg, 111); cg_byte(cg, 110); cg_byte(cg, 101); return; }
  if (op_type == 86) { cg_byte(cg, 111); cg_byte(cg, 108); cg_byte(cg, 116); return; }
  if (op_type == 87) { cg_byte(cg, 111); cg_byte(cg, 103); cg_byte(cg, 116); return; }
  if (op_type == 73) { cg_byte(cg, 111); cg_byte(cg, 108); cg_byte(cg, 101); return; }
  cg_byte(cg, 111); cg_byte(cg, 103); cg_byte(cg, 101);
}

function gen_float_binop(cg: *Codegen, s: *Sema, e: *ASTNode, left_op: Operand, right_op: Operand) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  if (is_comparison_op((*e).op_type)) {
    cg_byte(cg, 102); cg_byte(cg, 99); cg_byte(cg, 109); cg_byte(cg, 112); cg_byte(cg, 32);
    cg_float_cmp_pred(cg, (*e).op_type);
    cg_byte(cg, 32);
    cg_type(cg, s, (*(*e).left).type_file_idx, (*(*e).left).data_type);
  } else {
    cg_float_binop_mnemonic(cg, (*e).op_type);
    cg_byte(cg, 32);
    cg_type(cg, s, (*e).type_file_idx, (*e).data_type);
  }
  cg_byte(cg, 32);
  cg_operand(cg, left_op);
  cg_piece(cg, 3);
  cg_operand(cg, right_op);
  cg_piece(cg, 0);
  return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

// `a ** b` for a float-family pair. NOT `llvm.pow.*`: that intrinsic
// lowers to a plain call to libm's own `pow`, and this whole toolchain
// is freestanding by design (`ld -static -no-pie`, no libc/libm linked
// in at all -- confirmed the hard way, by `ld` actually failing with
// "undefined reference to `pow'" the first time this used the
// intrinsic). `llvm.powi.*` (float base, INTEGER exponent -- seemingly
// the exact right fit here) was also tried and confirmed the same hard
// way: it only avoids a runtime call when the exponent is a compile-
// time CONSTANT (llc then expands it inline via exponentiation-by-
// squaring); for a genuinely variable exponent it lowers to a call to
// `__powidf2`, a compiler-rt symbol this toolchain doesn't link either
// -- no better than `llvm.pow` for the general case this function
// actually has to handle. So: an ordinary runtime multiply loop (the
// same technique gen_int_pow uses, `fmul` in place of `mul`), over the
// exponent's ABSOLUTE value -- `llvm.fabs.f64`/`llvm.fabs.f32` would
// need their own conditional `declare` (the exact machinery an earlier
// version of this function had for `llvm.pow.*` and that broke every
// fixture golden by appearing unconditionally, see git history), so
// this uses `fneg` + `select` instead, both ordinary instructions
// nothing ever needs to declare. v1.1.n: a NEGATIVE exponent used to
// silently truncate to a zero-iteration loop and return 1.0 instead of
// the true reciprocal (postulate_stage1_bootstrap_plan.md's 2026-08-31
// entry has the full writeup) -- now handled correctly by computing
// the ordinary positive-exponent result and its reciprocal (`1.0 /
// result`) unconditionally, then `select`ing whichever the exponent's
// own sign actually calls for (branch-free, so no new labels needed
// beyond the loop's own). A FRACTIONAL exponent (`x ** 0.5`) is still
// out of scope -- `fptosi` truncates it same as before -- since a real
// answer needs a transcendental `pow` (log2+exp2 or similar), which
// absent a libm would be its own substantial undertaking.
// Exact, loop-based `**` for an INTEGER-valued exponent -- see gen_
// float_pow's own header comment (below) for why this stays the fast/
// exact path rather than always routing through the new general (log2/
// exp2-based) machinery: an integer exponent's result is exactly
// representable via repeated `fmul` (up to ordinary rounding), no
// series-approximation error at all, so there's no reason to prefer
// the approximate path when the exact one is available and already
// correct (including for a negative exponent, via the reciprocal fix
// below).
function gen_float_pow_int_exp(cg: *Codegen, s: *Sema, e: *ASTNode, base_op: Operand, exp_op: Operand) : Operand {
  mut ty_file : uint64 := (*e).type_file_idx;
  mut ty : *ASTNode := (*e).data_type;
  mut is_neg_reg : uint64 := new_reg(cg);
  mut neg_exp_reg : uint64 := new_reg(cg);
  mut abs_exp_reg : uint64 := new_reg(cg);
  mut result_slot : uint64 := new_reg(cg);
  mut i_slot : uint64 := new_reg(cg);
  mut n_reg : uint64 := 0;
  mut cond_l : uint64 := new_label(cg);
  mut body_l : uint64 := new_label(cg);
  mut end_l : uint64 := new_label(cg);
  mut cur_i : uint64 := 0;
  mut cur_result : uint64 := 0;
  mut cmp_reg : uint64 := 0;
  mut mul_reg : uint64 := 0;
  mut inc_reg : uint64 := 0;
  mut final_reg : uint64 := 0;
  mut loaded_reg : uint64 := 0;
  mut recip_reg : uint64 := 0;

  // is_neg := fcmp olt <ty> exp_op, 0.0
  cg_piece(cg, 1); cg_reg_ref(cg, is_neg_reg); cg_piece(cg, 2);
  cg_byte(cg, 102); cg_byte(cg, 99); cg_byte(cg, 109); cg_byte(cg, 112); cg_byte(cg, 32);
  cg_float_cmp_pred(cg, 86);
  cg_byte(cg, 32);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, exp_op);
  cg_piece(cg, 3);
  cg_operand(cg, Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := true, float_bits := 0 });
  cg_piece(cg, 0);

  // neg_exp := fneg <ty> exp_op
  cg_piece(cg, 1); cg_reg_ref(cg, neg_exp_reg); cg_piece(cg, 2);
  cg_byte(cg, 102); cg_byte(cg, 110); cg_byte(cg, 101); cg_byte(cg, 103); cg_byte(cg, 32);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, exp_op);
  cg_piece(cg, 0);

  // abs_exp := select i1 is_neg, <ty> neg_exp, <ty> exp_op
  cg_piece(cg, 1); cg_reg_ref(cg, abs_exp_reg); cg_piece(cg, 2);
  cg_byte(cg, 115); cg_byte(cg, 101); cg_byte(cg, 108); cg_byte(cg, 101); cg_byte(cg, 99); cg_byte(cg, 116); cg_byte(cg, 32);
  cg_byte(cg, 105); cg_byte(cg, 49); cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := is_neg_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 3);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := neg_exp_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 3);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, exp_op);
  cg_piece(cg, 0);

  n_reg := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, n_reg); cg_piece(cg, 2);
  cg_byte(cg, 102); cg_byte(cg, 112); cg_byte(cg, 116); cg_byte(cg, 111); cg_byte(cg, 115); cg_byte(cg, 105); cg_byte(cg, 32);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := abs_exp_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 60);
  cg_byte(cg, 105); cg_uint(cg, 64);
  cg_piece(cg, 0);

  cg_piece(cg, 1); cg_reg_ref(cg, result_slot); cg_piece(cg, 2); cg_piece(cg, 6);
  cg_type(cg, s, ty_file, ty);
  cg_piece(cg, 0);
  cg_piece(cg, 1); cg_reg_ref(cg, i_slot); cg_piece(cg, 2); cg_piece(cg, 6);
  cg_byte(cg, 105); cg_uint(cg, 64);
  cg_piece(cg, 0);

  cg_piece(cg, 1); cg_piece(cg, 9);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := true, float_bits := float_literal_to_bits(1, 0) });
  cg_piece(cg, 8); cg_reg_ref(cg, result_slot); cg_piece(cg, 0);

  cg_piece(cg, 1); cg_piece(cg, 9);
  cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32); cg_byte(cg, 48);
  cg_piece(cg, 8); cg_reg_ref(cg, i_slot); cg_piece(cg, 0);

  cg_piece(cg, 1); cg_piece(cg, 12); cg_piece(cg, 15); cg_label_target(cg, cond_l); cg_piece(cg, 0);
  cg_label_def(cg, cond_l);

  cur_i := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, cur_i); cg_piece(cg, 2); cg_piece(cg, 7);
  cg_byte(cg, 105); cg_uint(cg, 64);
  cg_piece(cg, 8); cg_reg_ref(cg, i_slot); cg_piece(cg, 0);

  cmp_reg := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, cmp_reg); cg_piece(cg, 2); cg_piece(cg, 17);
  cg_cmp_pred(cg, 86, false);
  cg_byte(cg, 32);
  cg_byte(cg, 105); cg_uint(cg, 64);
  cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := cur_i, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 3);
  cg_operand(cg, Operand { is_reg := true, reg := n_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 0);

  cg_piece(cg, 1); cg_piece(cg, 13);
  cg_operand(cg, Operand { is_reg := true, reg := cmp_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 14); cg_label_target(cg, body_l);
  cg_piece(cg, 14); cg_label_target(cg, end_l);
  cg_piece(cg, 0);

  cg_label_def(cg, body_l);

  cur_result := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, cur_result); cg_piece(cg, 2); cg_piece(cg, 7);
  cg_type(cg, s, ty_file, ty);
  cg_piece(cg, 8); cg_reg_ref(cg, result_slot); cg_piece(cg, 0);

  mul_reg := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, mul_reg); cg_piece(cg, 2);
  cg_float_binop_mnemonic(cg, 81);
  cg_byte(cg, 32);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := cur_result, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 3);
  cg_operand(cg, base_op);
  cg_piece(cg, 0);

  cg_piece(cg, 1); cg_piece(cg, 9);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := mul_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 8); cg_reg_ref(cg, result_slot); cg_piece(cg, 0);

  cur_i := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, cur_i); cg_piece(cg, 2); cg_piece(cg, 7);
  cg_byte(cg, 105); cg_uint(cg, 64);
  cg_piece(cg, 8); cg_reg_ref(cg, i_slot); cg_piece(cg, 0);

  inc_reg := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, inc_reg); cg_piece(cg, 2); cg_piece(cg, 27);
  cg_byte(cg, 32);
  cg_byte(cg, 105); cg_uint(cg, 64);
  cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := cur_i, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 3);
  cg_byte(cg, 49);
  cg_piece(cg, 0);

  cg_piece(cg, 1); cg_piece(cg, 9);
  cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := inc_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 8); cg_reg_ref(cg, i_slot); cg_piece(cg, 0);

  cg_piece(cg, 1); cg_piece(cg, 12); cg_piece(cg, 15); cg_label_target(cg, cond_l); cg_piece(cg, 0);

  cg_label_def(cg, end_l);

  loaded_reg := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, loaded_reg); cg_piece(cg, 2); cg_piece(cg, 7);
  cg_type(cg, s, ty_file, ty);
  cg_piece(cg, 8); cg_reg_ref(cg, result_slot); cg_piece(cg, 0);

  // recip := fdiv <ty> 1.0, loaded -- always computed (branch-free is
  // simpler than a new label/block just to skip it in the common
  // non-negative case, and an extra `fdiv` is cheap).
  recip_reg := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, recip_reg); cg_piece(cg, 2);
  cg_float_binop_mnemonic(cg, 83);
  cg_byte(cg, 32);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := true, float_bits := float_literal_to_bits(1, 0) });
  cg_piece(cg, 3);
  cg_operand(cg, Operand { is_reg := true, reg := loaded_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 0);

  // final := select i1 is_neg, <ty> recip, <ty> loaded
  final_reg := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, final_reg); cg_piece(cg, 2);
  cg_byte(cg, 115); cg_byte(cg, 101); cg_byte(cg, 108); cg_byte(cg, 101); cg_byte(cg, 99); cg_byte(cg, 116); cg_byte(cg, 32);
  cg_byte(cg, 105); cg_byte(cg, 49); cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := is_neg_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 3);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := recip_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 3);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := loaded_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 0);

  return Operand { is_reg := true, reg := final_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

// =======================================================================
// General (fractional-exponent) `**`/`_/` support -- v1.1.n.
//
// gen_float_pow_int_exp (above) is exact but only correct for an
// INTEGER-valued exponent: `x ** 2.0` is exactly `x*x`, but `x ** 0.5`
// (an ordinary square root -- and `_/`'s own desugaring, `n _/ x ==
// x ** (1.0/n)`, produces a genuinely fractional exponent for every
// n other than +-1) has no such finite unrolling. `llvm.pow`/`llvm.
// powi` were both already ruled out for the INTEGER case (this file's
// own git history/postulate_stage1_bootstrap_plan.md 2026-08-31 entry
// -- `__powidf2`/libm calls this freestanding, `-static -no-pie`
// toolchain can't link), and a genuinely fractional exponent has no
// integer-unrolling equivalent at all -- so this is a real, from-
// scratch `pow(x, y) = 2^(y * log2(x))` for a non-integer y, built the
// same way any minimal libm does it: extract x's own IEEE-754 binary64
// exponent/mantissa directly via bit tricks (no division needed to
// range-reduce), a fixed-degree series for log2 of the [1,2) mantissa,
// a fixed-degree series for 2^f of a [0,1) fraction, and the integer
// part of the final exponent folded back in as an exact bit-shift.
// Numerically prototyped and checked against Python's own `**` first
// (this file's own established practice for anything not verifiable
// by direct inspection): ~10 log-series terms + ~13 exp-series terms
// already lands within 1-2 ULP of the true double-precision result
// across every case tried (sqrt/cube-root/`x**y` for assorted
// positive/negative/fractional y) -- see this session's own working
// notes for the exact Python cross-check. Deliberately NOT used for an
// integer-valued exponent (gen_float_pow, below, only ever calls this
// once it's confirmed the exponent ISN'T one) -- gen_float_pow_int_exp
// stays exact there, no reason to prefer an approximation when an
// exact answer is already cheap.
//
// Everything below operates purely in `double` (float64), regardless
// of `**`'s own declared type (which could be `float32`) -- gen_float_
// pow converts in and back out at its own two call boundaries
// (gen_to_f64/gen_from_f64), the same "compute at the widest available
// precision, narrow only at the very end" choice an ordinary hand-
// written libm makes too. That keeps every helper below free of a
// `ty`/`ty_file` parameter pair -- there's only ever one type in play
// here, so it's simplest to just spell `double` directly (cg_double_kw)
// rather than thread a type through three call levels for a type that
// never actually varies.
// =======================================================================

function cg_double_kw(cg: *Codegen) : void {
  cg_byte(cg, 100); cg_byte(cg, 111); cg_byte(cg, 117); cg_byte(cg, 98); cg_byte(cg, 108); cg_byte(cg, 101);
}

function f64_imm(digits: uint64, dec_exp: int64) : Operand {
  return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := true, float_bits := float_literal_to_bits(digits, dec_exp) };
}

function i64_imm(v: int64) : Operand {
  return Operand { is_reg := false, reg := 0, imm := v, is_null := false, is_float_imm := false, float_bits := 0 };
}

function reg_op(r: uint64) : Operand {
  return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

function gen_i64_binop(cg: *Codegen, op_type: int32, is_unsigned: bool, a: Operand, b: Operand) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_binop_mnemonic(cg, op_type, is_unsigned);
  cg_byte(cg, 32); cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
  cg_operand(cg, a); cg_piece(cg, 3); cg_operand(cg, b); cg_piece(cg, 0);
  return reg_op(r);
}

function gen_i64_icmp(cg: *Codegen, op_type: int32, is_unsigned: bool, a: Operand, b: Operand) : uint64 {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 17);
  cg_cmp_pred(cg, op_type, is_unsigned);
  cg_byte(cg, 32); cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
  cg_operand(cg, a); cg_piece(cg, 3); cg_operand(cg, b); cg_piece(cg, 0);
  return r;
}

function gen_fbinop_f64(cg: *Codegen, op_type: int32, a: Operand, b: Operand) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_float_binop_mnemonic(cg, op_type);
  cg_byte(cg, 32); cg_double_kw(cg); cg_byte(cg, 32);
  cg_operand(cg, a); cg_piece(cg, 3); cg_operand(cg, b); cg_piece(cg, 0);
  return reg_op(r);
}

function gen_fcmp_f64(cg: *Codegen, op_type: int32, a: Operand, b: Operand) : uint64 {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_byte(cg, 102); cg_byte(cg, 99); cg_byte(cg, 109); cg_byte(cg, 112); cg_byte(cg, 32);
  cg_float_cmp_pred(cg, op_type);
  cg_byte(cg, 32); cg_double_kw(cg); cg_byte(cg, 32);
  cg_operand(cg, a); cg_piece(cg, 3); cg_operand(cg, b); cg_piece(cg, 0);
  return r;
}

function gen_select_i64(cg: *Codegen, cond_reg: uint64, true_op: Operand, false_op: Operand) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_byte(cg, 115); cg_byte(cg, 101); cg_byte(cg, 108); cg_byte(cg, 101); cg_byte(cg, 99); cg_byte(cg, 116); cg_byte(cg, 32);
  cg_byte(cg, 105); cg_byte(cg, 49); cg_byte(cg, 32);
  cg_operand(cg, reg_op(cond_reg));
  cg_piece(cg, 3);
  cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
  cg_operand(cg, true_op);
  cg_piece(cg, 3);
  cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
  cg_operand(cg, false_op);
  cg_piece(cg, 0);
  return reg_op(r);
}

function gen_select_f64(cg: *Codegen, cond_reg: uint64, true_op: Operand, false_op: Operand) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_byte(cg, 115); cg_byte(cg, 101); cg_byte(cg, 108); cg_byte(cg, 101); cg_byte(cg, 99); cg_byte(cg, 116); cg_byte(cg, 32);
  cg_byte(cg, 105); cg_byte(cg, 49); cg_byte(cg, 32);
  cg_operand(cg, reg_op(cond_reg));
  cg_piece(cg, 3);
  cg_double_kw(cg); cg_byte(cg, 32);
  cg_operand(cg, true_op);
  cg_piece(cg, 3);
  cg_double_kw(cg); cg_byte(cg, 32);
  cg_operand(cg, false_op);
  cg_piece(cg, 0);
  return reg_op(r);
}

function gen_bitcast_f64_to_i64(cg: *Codegen, op: Operand) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_byte(cg, 98); cg_byte(cg, 105); cg_byte(cg, 116); cg_byte(cg, 99); cg_byte(cg, 97); cg_byte(cg, 115); cg_byte(cg, 116); cg_byte(cg, 32);
  cg_double_kw(cg); cg_byte(cg, 32);
  cg_operand(cg, op);
  cg_piece(cg, 60);
  cg_byte(cg, 105); cg_uint(cg, 64);
  cg_piece(cg, 0);
  return reg_op(r);
}

function gen_bitcast_i64_to_f64(cg: *Codegen, op: Operand) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_byte(cg, 98); cg_byte(cg, 105); cg_byte(cg, 116); cg_byte(cg, 99); cg_byte(cg, 97); cg_byte(cg, 115); cg_byte(cg, 116); cg_byte(cg, 32);
  cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
  cg_operand(cg, op);
  cg_piece(cg, 60);
  cg_double_kw(cg);
  cg_piece(cg, 0);
  return reg_op(r);
}

function gen_sitofp_i64_to_f64(cg: *Codegen, op: Operand) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_byte(cg, 115); cg_byte(cg, 105); cg_byte(cg, 116); cg_byte(cg, 111); cg_byte(cg, 102); cg_byte(cg, 112); cg_byte(cg, 32);
  cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
  cg_operand(cg, op);
  cg_piece(cg, 60);
  cg_double_kw(cg);
  cg_piece(cg, 0);
  return reg_op(r);
}

function gen_fptosi_f64_to_i64(cg: *Codegen, op: Operand) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_byte(cg, 102); cg_byte(cg, 112); cg_byte(cg, 116); cg_byte(cg, 111); cg_byte(cg, 115); cg_byte(cg, 105); cg_byte(cg, 32);
  cg_double_kw(cg); cg_byte(cg, 32);
  cg_operand(cg, op);
  cg_piece(cg, 60);
  cg_byte(cg, 105); cg_uint(cg, 64);
  cg_piece(cg, 0);
  return reg_op(r);
}

// float32 <-> float64 at the type actually declared for `**`/`_/`'s own
// result (gen_float_pow's own two call sites, below) -- a same-width
// no-op when that type is already float64 (the common case), an
// ordinary `fpext`/`fptrunc` otherwise, mirroring gen_cast's own
// src_cat==6&&dst_cat==6 branch exactly (duplicated rather than
// reused, since that branch is keyed off two AST-node-derived types,
// not the single fixed `double` this whole section otherwise assumes).
function gen_to_f64(cg: *Codegen, s: *Sema, ty_file: uint64, ty: *ASTNode, op: Operand) : Operand {
  mut r : uint64 := 0;
  if (base_type_size((*ty).tok.kind) == 8) { return op; }
  r := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_byte(cg, 102); cg_byte(cg, 112); cg_byte(cg, 101); cg_byte(cg, 120); cg_byte(cg, 116); cg_byte(cg, 32);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, op);
  cg_piece(cg, 60);
  cg_double_kw(cg);
  cg_piece(cg, 0);
  return reg_op(r);
}

function gen_from_f64(cg: *Codegen, s: *Sema, ty_file: uint64, ty: *ASTNode, op: Operand) : Operand {
  mut r : uint64 := 0;
  if (base_type_size((*ty).tok.kind) == 8) { return op; }
  r := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_byte(cg, 102); cg_byte(cg, 112); cg_byte(cg, 116); cg_byte(cg, 114); cg_byte(cg, 117); cg_byte(cg, 110); cg_byte(cg, 99); cg_byte(cg, 32);
  cg_double_kw(cg);
  cg_byte(cg, 32);
  cg_operand(cg, op);
  cg_piece(cg, 60);
  cg_type(cg, s, ty_file, ty);
  cg_piece(cg, 0);
  return reg_op(r);
}

// v1.1.n: like gen_i64_binop, but the right operand is a raw, already-
// KNOWN-AT-CODEGEN-TIME uint64 constant (mask52()'s AND-mask, the
// 1023<<52 exponent-bias-shift below) printed DIRECTLY via cg_uint --
// deliberately NOT built as an ordinary i64_imm Operand first. This
// file's own int64_to_uint64/uint64_to_int64 (Sema.ptl/Parser.ptl) are
// genuine, confirmed O(n) COUNTING loops (`while (steps>0) { result+1;
// steps-1; }`), fine for a small value but catastrophic for one of
// THESE constants' own magnitude (mask52() alone is ~4.5e15) --
// cg_operand's own plain-integer-Operand branch always routes through
// exactly that counting conversion before printing, so any Operand
// carrying a value this large would never actually finish compiling.
// cg_uint's own decimal-formatting path has no such problem (ordinary
// digit-by-digit formatting, not a per-VALUE loop) -- this helper just
// reaches it directly, bypassing Operand/cg_operand entirely for the
// one operand that needs it.
function gen_i64_binop_const(cg: *Codegen, op_type: int32, is_unsigned: bool, a: Operand, b_const: uint64) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_binop_mnemonic(cg, op_type, is_unsigned);
  cg_byte(cg, 32); cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
  cg_operand(cg, a); cg_piece(cg, 3); cg_uint(cg, b_const); cg_piece(cg, 0);
  return reg_op(r);
}

// A float64 immediate built from its own EXACT bit pattern directly --
// unlike f64_imm (which goes through the decimal-literal conversion
// machinery, `digits * 10^dec_exp`), this is for a value that's only
// ever meaningful AS bits (+inf, a quiet NaN) -- converting through a
// decimal round-trip would be both pointless and, for `float_bits`
// itself, entirely unnecessary: it's already the exact uint64 field
// cg_hex64 wants, no conversion of any kind needed.
function f64_bits_imm(bits: uint64) : Operand {
  return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := true, float_bits := bits };
}

// `1023 << 52` (binary64's own zero-exponent bias, shifted into the
// exponent field's own bit position) -- built via a shift from a small
// literal, matching mask32()/two_pow_32()/mask52()/inf_exp_bits()'s own
// established pattern elsewhere in this file (a literal this large
// written directly would hit the OTHER, unrelated front-end performance
// bug those exist to avoid -- see their own header comments).
function bias1023_shl52() : uint64 {
  mut b : uint64 := 1023;
  return b << 52;
}

function pos_inf_bits() : uint64 {
  return inf_exp_bits() << 52;
}

// A canonical quiet NaN: binary64's all-ones exponent field (same as
// +inf) plus any nonzero mantissa bit (bit 51 here) -- the mantissa
// bit is what distinguishes a NaN from an infinity; which specific bit
// is set doesn't matter (every NaN payload compares unordered/false
// against everything, including itself, the same as every other NaN).
function qnan_bits() : uint64 {
  mut one : uint64 := 1;
  return pos_inf_bits() | (one << 51);
}

// ln(2) and 1/ln(2)'s own exact IEEE-754 binary64 bit patterns, built
// nibble-by-nibble from small (<16) literals -- NOT written as a
// decimal literal (`0.6931471805599453`) the ordinary way: this file's
// own established front-end performance bug (mask32()/two_pow_32()/
// mask52()/inf_exp_bits()'s own header comments) makes any hand-
// written literal past ~1.3 billion a near-hang to even COMPILE (this
// was hit directly during development -- a `docker build` that
// normally finishes in ~20s never returned). A 16-17 significant-digit
// constant is nowhere near a workaround otherwise, so this builds the
// exact bit pattern directly instead, the same way inf_exp_bits()
// itself avoids writing `2047` embedded in a literal shift.
function ln2_bits() : uint64 {
  mut v : uint64 := 3;
  v := (v << 4) | 15; v := (v << 4) | 14; v := (v << 4) | 6; v := (v << 4) | 2;
  v := (v << 4) | 14; v := (v << 4) | 4; v := (v << 4) | 2; v := (v << 4) | 15;
  v := (v << 4) | 14; v := (v << 4) | 15; v := (v << 4) | 10; v := (v << 4) | 3;
  v := (v << 4) | 9; v := (v << 4) | 14; v := (v << 4) | 15;
  return v;
}

function inv_ln2_bits() : uint64 {
  mut v : uint64 := 3;
  v := (v << 4) | 15; v := (v << 4) | 15; v := (v << 4) | 7; v := (v << 4) | 1;
  v := (v << 4) | 5; v := (v << 4) | 4; v := (v << 4) | 7; v := (v << 4) | 6;
  v := (v << 4) | 5; v := (v << 4) | 2; v := (v << 4) | 11; v := (v << 4) | 8;
  v := (v << 4) | 2; v := (v << 4) | 15; v := (v << 4) | 14;
  return v;
}

// log2(|x|) for any nonzero, finite double `x` -- the ABSOLUTE value,
// deliberately: the sign bit (bit 63) never participates in the
// exponent/mantissa extraction below, so this naturally ignores it
// rather than needing a separate fabs step. gen_float_pow_frac (below)
// is the only caller, and only ever needs |x|'s own log2 (it decides
// the sign of x separately, since a negative base is only valid there
// alongside an INTEGER exponent, already handled by gen_float_pow_
// int_exp before this function is ever reached). Not meaningful for
// x == 0 (the caller selects that case away separately) or a subnormal
// x (an extreme, ~1e-308-magnitude edge case not specially handled --
// documented limitation, not attempted here).
//
// Method: x's own IEEE-754 bits already encode log2(x) almost exactly
// -- the biased exponent field IS floor(log2(x)) + 1023 by
// construction. Rebuilding a double with THAT SAME mantissa but a
// forced zero exponent (bias 1023, i.e. 2^0) yields `m` in [1,2),
// x's own true mantissa value with no arithmetic at all -- only
// log2(m) needs real computation, via the standard atanh-based series
// (ln(m) = 2*atanh((m-1)/(m+1)), converges quickly since m in [1,2)
// keeps that ratio's magnitude under 1/3). 10 terms already lands
// within 1-2 ULP of the true value end to end (this session's own
// Python cross-check, gen_float_pow_frac's own header comment).
function gen_log2_f64(cg: *Codegen, x_op: Operand) : Operand {
  mut bits : Operand := gen_bitcast_f64_to_i64(cg, x_op);
  mut raw_exp : Operand := gen_i64_binop(cg, 76, true, bits, i64_imm(52));
  mut raw_exp_masked : Operand := gen_i64_binop_const(cg, 82, false, raw_exp, 2047);
  mut unbiased_exp : Operand := gen_i64_binop(cg, 80, false, raw_exp_masked, i64_imm(1023));
  mut unbiased_exp_f : Operand := gen_sitofp_i64_to_f64(cg, unbiased_exp);
  mut mantissa_bits : Operand := gen_i64_binop_const(cg, 82, false, bits, mask52());
  mut m_bits : Operand := gen_i64_binop_const(cg, 89, false, mantissa_bits, bias1023_shl52());
  mut m : Operand := gen_bitcast_i64_to_f64(cg, m_bits);
  mut u : Operand := gen_fbinop_f64(cg, 83, gen_fbinop_f64(cg, 80, m, f64_imm(1, 0)), gen_fbinop_f64(cg, 85, m, f64_imm(1, 0)));
  mut v : Operand := gen_fbinop_f64(cg, 81, u, u);
  // Horner form of ln(m) = 2u*(1 + v/3 + v^2/5 + ... + v^9/19), v=u^2
  // -- 10 terms (odd divisors 19 downto 1) already lands within 1-2
  // ULP of the true value end to end (gen_float_pow_frac's own header
  // comment covers the Python cross-check this was validated against).
  mut divisor : uint64 := 19;
  mut acc : Operand := gen_fbinop_f64(cg, 83, f64_imm(1, 0), f64_imm(divisor, 0));
  mut looping : bool := true;
  mut ln_m : Operand := f64_imm(0, 0);
  mut log2_m : Operand := f64_imm(0, 0);

  while (looping) {
    if (divisor <= 1) {
      looping := false;
    } else {
      divisor := divisor - 2;
      acc := gen_fbinop_f64(cg, 85, gen_fbinop_f64(cg, 83, f64_imm(1, 0), f64_imm(divisor, 0)), gen_fbinop_f64(cg, 81, v, acc));
    }
  }

  ln_m := gen_fbinop_f64(cg, 81, f64_imm(2, 0), gen_fbinop_f64(cg, 81, u, acc));
  log2_m := gen_fbinop_f64(cg, 81, ln_m, f64_bits_imm(inv_ln2_bits()));
  return gen_fbinop_f64(cg, 85, unbiased_exp_f, log2_m);
}

// 2^z for any finite double `z` -- decomposes into an exact integer
// power (a direct exponent-field bit shift, clamped to +-inf/0.0 the
// same way digits_to_bits_core's own overflow/underflow handling
// already does) times a [0,1)-fraction power (a 13-term e^t Taylor
// series, t = f*ln2 -- e^(f*ln2) == 2^f). `floor`, not `trunc`, is
// required for the split (z's fractional part must land in [0,1), not
// (-1,1) -- fptosi truncates toward zero, so a negative z needs an
// explicit floor correction, the `is_over` check below).
function gen_exp2_f64(cg: *Codegen, z_op: Operand) : Operand {
  mut n_trunc : Operand := gen_fptosi_f64_to_i64(cg, z_op);
  mut n_trunc_f : Operand := gen_sitofp_i64_to_f64(cg, n_trunc);
  mut is_over : uint64 := gen_fcmp_f64(cg, 87, n_trunc_f, z_op);
  mut n_floor : Operand := gen_select_i64(cg, is_over, gen_i64_binop(cg, 80, false, n_trunc, i64_imm(1)), n_trunc);
  mut n_floor_f : Operand := gen_sitofp_i64_to_f64(cg, n_floor);
  mut f : Operand := gen_fbinop_f64(cg, 80, z_op, n_floor_f);
  mut t : Operand := gen_fbinop_f64(cg, 81, f, f64_bits_imm(ln2_bits()));
  // Horner form of e^t = 1 + t/1*(1 + t/2*(1 + t/3*(... + t/13))) --
  // 13 terms, t in [0, ln2) at most, lands far beyond the precision
  // this whole approximation needs elsewhere (gen_log2_f64's own
  // header comment covers the Python cross-check).
  mut acc : Operand := f64_imm(1, 0);
  mut k : uint64 := 13;
  mut looping : bool := true;
  mut biased : Operand := gen_i64_binop(cg, 85, false, n_floor, i64_imm(1023));
  mut is_overflow : uint64 := 0;
  mut is_underflow : uint64 := 0;
  mut safe_biased : Operand := i64_imm(0);
  mut pow2n_normal_bits : Operand := i64_imm(0);
  mut pow2n : Operand := f64_imm(0, 0);

  while (looping) {
    acc := gen_fbinop_f64(cg, 85, f64_imm(1, 0), gen_fbinop_f64(cg, 83, gen_fbinop_f64(cg, 81, t, acc), f64_imm(k, 0)));
    if (k <= 1) {
      looping := false;
    } else {
      k := k - 1;
    }
  }

  is_overflow := gen_i64_icmp(cg, 74, false, biased, i64_imm(2047));
  is_underflow := gen_i64_icmp(cg, 73, false, biased, i64_imm(0));
  safe_biased := gen_select_i64(cg, is_overflow, i64_imm(2046), gen_select_i64(cg, is_underflow, i64_imm(1), biased));
  pow2n_normal_bits := gen_i64_binop(cg, 75, false, safe_biased, i64_imm(52));
  pow2n := gen_select_f64(cg, is_overflow, f64_bits_imm(pos_inf_bits()), gen_select_f64(cg, is_underflow, f64_imm(0, 0), gen_bitcast_i64_to_f64(cg, pow2n_normal_bits)));

  return gen_fbinop_f64(cg, 81, pow2n, acc);
}

// pow(x, y) for a genuinely FRACTIONAL y (gen_float_pow, below, only
// ever calls this once it's confirmed y isn't integer-valued) --
// x == 0 and x < 0 handled explicitly (`gen_log2_f64`'s own bit
// extraction produces a meaningless value for either, silently, so
// this selects the mathematically correct answer in instead of ever
// returning that raw garbage): x == 0 follows the ordinary IEEE-754
// convention (0.0 for a positive exponent, +inf for a negative one);
// x < 0 with a fractional exponent has no real answer at all (unlike
// an INTEGER exponent, already handled exactly by gen_float_pow_
// int_exp before this function is ever reached) -- quiet NaN, matching
// `pow`'s own standard behavior everywhere else.
function gen_float_pow_frac(cg: *Codegen, x_op: Operand, y_op: Operand) : Operand {
  mut abs_log2x : Operand := gen_log2_f64(cg, x_op);
  mut z : Operand := gen_fbinop_f64(cg, 81, y_op, abs_log2x);
  mut raw_result : Operand := gen_exp2_f64(cg, z);
  mut is_zero_x : uint64 := gen_fcmp_f64(cg, 71, x_op, f64_imm(0, 0));
  mut is_neg_x : uint64 := gen_fcmp_f64(cg, 86, x_op, f64_imm(0, 0));
  mut is_neg_y : uint64 := gen_fcmp_f64(cg, 86, y_op, f64_imm(0, 0));
  mut zero_case : Operand := gen_select_f64(cg, is_neg_y, f64_bits_imm(pos_inf_bits()), f64_imm(0, 0));
  mut nan_val : Operand := f64_bits_imm(qnan_bits());

  return gen_select_f64(cg, is_zero_x, zero_case, gen_select_f64(cg, is_neg_x, nan_val, raw_result));
}

// `**` dispatcher: gen_float_pow_int_exp (exact) for an integer-valued
// exponent, gen_float_pow_frac (log2/exp2-based) otherwise -- computed
// UNCONDITIONALLY on both sides then `select`ed on the exponent's own
// integer-ness, the same branch-free style gen_float_pow_int_exp's own
// negative-exponent fix already uses, rather than real control-flow
// branching (which would need a join point / two divergent register
// sets to merge). Both operands are converted to `double` first (gen_
// to_f64) regardless of `**`'s own declared type (which could be
// float32 for a float32**float32 expression) -- every helper above
// only ever speaks `double` -- and the final result converted back
// (gen_from_f64) before returning.
function gen_float_pow(cg: *Codegen, s: *Sema, e: *ASTNode, base_op: Operand, exp_op: Operand) : Operand {
  mut ty_file : uint64 := (*e).type_file_idx;
  mut ty : *ASTNode := (*e).data_type;
  mut exp64 : Operand := gen_to_f64(cg, s, ty_file, ty, exp_op);
  mut base64 : Operand := gen_to_f64(cg, s, ty_file, ty, base_op);
  mut trunc_i : Operand := gen_fptosi_f64_to_i64(cg, exp64);
  mut back_f : Operand := gen_sitofp_i64_to_f64(cg, trunc_i);
  mut is_int_reg : uint64 := gen_fcmp_f64(cg, 71, exp64, back_f);
  mut fast_result : Operand := gen_float_pow_int_exp(cg, s, e, base_op, exp_op);
  mut frac_result64 : Operand := gen_float_pow_frac(cg, base64, exp64);
  mut frac_result : Operand := gen_from_f64(cg, s, ty_file, ty, frac_result64);
  mut r : uint64 := new_reg(cg);

  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_byte(cg, 115); cg_byte(cg, 101); cg_byte(cg, 108); cg_byte(cg, 101); cg_byte(cg, 99); cg_byte(cg, 116); cg_byte(cg, 32);
  cg_byte(cg, 105); cg_byte(cg, 49); cg_byte(cg, 32);
  cg_operand(cg, reg_op(is_int_reg));
  cg_piece(cg, 3);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, fast_result);
  cg_piece(cg, 3);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, frac_result);
  cg_piece(cg, 0);
  return reg_op(r);
}

// `a ** b` for an integer pair: no native instruction either, and
// unlike the float case there's no intrinsic to lean on -- an ordinary
// runtime multiply loop (`result := 1; while (i < b) { result *:= a;
// i++; }`), emitted directly as raw labels/branches rather than through
// a synthetic WHILE_STMT AST node, the same way gen_and/gen_or already
// embed multi-basic-block control flow inside expression evaluation.
function gen_int_pow(cg: *Codegen, s: *Sema, e: *ASTNode, base_op: Operand, exp_op: Operand) : Operand {
  mut ty_file : uint64 := (*e).type_file_idx;
  mut ty : *ASTNode := (*e).data_type;
  mut is_unsigned : bool := is_unsigned_for_cast((*ty).tok.kind);
  mut result_slot : uint64 := new_reg(cg);
  mut i_slot : uint64 := new_reg(cg);
  mut cond_l : uint64 := new_label(cg);
  mut body_l : uint64 := new_label(cg);
  mut end_l : uint64 := new_label(cg);
  mut cur_i : uint64 := 0;
  mut cur_result : uint64 := 0;
  mut cmp_reg : uint64 := 0;
  mut mul_reg : uint64 := 0;
  mut inc_reg : uint64 := 0;
  mut final_reg : uint64 := 0;

  cg_piece(cg, 1); cg_reg_ref(cg, result_slot); cg_piece(cg, 2); cg_piece(cg, 6);
  cg_type(cg, s, ty_file, ty);
  cg_piece(cg, 0);
  cg_piece(cg, 1); cg_reg_ref(cg, i_slot); cg_piece(cg, 2); cg_piece(cg, 6);
  cg_type(cg, s, ty_file, ty);
  cg_piece(cg, 0);

  cg_piece(cg, 1); cg_piece(cg, 9);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32); cg_byte(cg, 49);
  cg_piece(cg, 8); cg_reg_ref(cg, result_slot); cg_piece(cg, 0);

  cg_piece(cg, 1); cg_piece(cg, 9);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32); cg_byte(cg, 48);
  cg_piece(cg, 8); cg_reg_ref(cg, i_slot); cg_piece(cg, 0);

  cg_piece(cg, 1); cg_piece(cg, 12); cg_piece(cg, 15); cg_label_target(cg, cond_l); cg_piece(cg, 0);
  cg_label_def(cg, cond_l);

  cur_i := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, cur_i); cg_piece(cg, 2); cg_piece(cg, 7);
  cg_type(cg, s, ty_file, ty);
  cg_piece(cg, 8); cg_reg_ref(cg, i_slot); cg_piece(cg, 0);

  cmp_reg := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, cmp_reg); cg_piece(cg, 2); cg_piece(cg, 17);
  cg_cmp_pred(cg, 86, is_unsigned);
  cg_byte(cg, 32);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := cur_i, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 3);
  cg_operand(cg, exp_op);
  cg_piece(cg, 0);

  cg_piece(cg, 1); cg_piece(cg, 13);
  cg_operand(cg, Operand { is_reg := true, reg := cmp_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 14); cg_label_target(cg, body_l);
  cg_piece(cg, 14); cg_label_target(cg, end_l);
  cg_piece(cg, 0);

  cg_label_def(cg, body_l);

  cur_result := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, cur_result); cg_piece(cg, 2); cg_piece(cg, 7);
  cg_type(cg, s, ty_file, ty);
  cg_piece(cg, 8); cg_reg_ref(cg, result_slot); cg_piece(cg, 0);

  mul_reg := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, mul_reg); cg_piece(cg, 2);
  cg_binop_mnemonic(cg, 81, is_unsigned);
  cg_byte(cg, 32);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := cur_result, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 3);
  cg_operand(cg, base_op);
  cg_piece(cg, 0);

  cg_piece(cg, 1); cg_piece(cg, 9);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := mul_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 8); cg_reg_ref(cg, result_slot); cg_piece(cg, 0);

  cur_i := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, cur_i); cg_piece(cg, 2); cg_piece(cg, 7);
  cg_type(cg, s, ty_file, ty);
  cg_piece(cg, 8); cg_reg_ref(cg, i_slot); cg_piece(cg, 0);

  inc_reg := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, inc_reg); cg_piece(cg, 2);
  cg_binop_mnemonic(cg, 85, is_unsigned);
  cg_byte(cg, 32);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := cur_i, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 3);
  cg_byte(cg, 49);
  cg_piece(cg, 0);

  cg_piece(cg, 1); cg_piece(cg, 9);
  cg_type(cg, s, ty_file, ty);
  cg_byte(cg, 32);
  cg_operand(cg, Operand { is_reg := true, reg := inc_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 });
  cg_piece(cg, 8); cg_reg_ref(cg, i_slot); cg_piece(cg, 0);

  cg_piece(cg, 1); cg_piece(cg, 12); cg_piece(cg, 15); cg_label_target(cg, cond_l); cg_piece(cg, 0);

  cg_label_def(cg, end_l);

  final_reg := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, final_reg); cg_piece(cg, 2); cg_piece(cg, 7);
  cg_type(cg, s, ty_file, ty);
  cg_piece(cg, 8); cg_reg_ref(cg, result_slot); cg_piece(cg, 0);

  return Operand { is_reg := true, reg := final_reg, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

function gen_expr(cg: *Codegen, s: *Sema, sc: *Scope, file_idx: uint64, e: *ASTNode) : Operand {
  mut k : uint32 := (*e).kind;
  mut slot : uint64 := 0;
  mut r : uint64 := 0;
  mut left_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut right_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut is_unsigned : bool := false;
  mut lcat : int32 := 0;
  mut rcat : int32 := 0;
  mut lit_lr : LookupResult := LookupResult { found := false, index := 0 };
  mut lit_struct_decl : *ASTNode := null;
  mut lit_struct_file : uint64 := 0;
  mut lit_field : *ASTNode := null;
  mut lit_decl_field : *ASTNode := null;
  mut lit_field_idx : uint64 := 0;
  mut lit_found : bool := false;
  mut lit_val_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut lit_addr : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut lit_base_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut lit_slot : uint64 := 0;
  mut lit_elem_ty : *ASTNode := null;
  mut lit_elem_file : uint64 := 0;

  // QUALIFIED_IDENT_EXPR (163, v1.1.12, `Alias::Symbol`) reads/binds
  // exactly like a bare IDENT_EXPR here -- Sema's own decorate_expr
  // k==163 case already resolved `symbol_ref`/`data_type` identically,
  // never rewriting the node's own kind back to 140, so this (and gen_
  // addr's matching k==140 case below) are the only two places that
  // still need to know both kinds mean the same thing at codegen time.
  // `(*e).type_file_idx`, not this function's own `file_idx` parameter,
  // is used for the type lookup -- for a cross-namespace reference (the
  // whole point of 163, but just as real for an ordinary cross-file
  // `use` of a struct-typed value under a bare 140), `data_type`'s own
  // token was written in the DECLARING file, not this expression's own.
  if (k == 140 || k == 163) {
    if ((*e).symbol_ref != null && ((*(*e).symbol_ref).kind == 112 || (*(*e).symbol_ref).kind == 113)) {
      return gen_global_func_addr(cg, s, (*e).type_file_idx, (*e).symbol_ref);
    }
    slot := scope_reg_for_decl(sc, (*e).symbol_ref);
    r := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 7);
    cg_type(cg, s, (*e).type_file_idx, (*e).data_type);
    cg_piece(cg, 8); cg_reg_ref(cg, slot); cg_piece(cg, 0);
    return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }

  if (k == 141 || k == 144) {
    return Operand { is_reg := false, reg := 0, imm := (*e).int_val, is_null := false, is_float_imm := false, float_bits := 0 };
  }

  if (k == 142) {
    // A multi-byte literal only ever anchors to `rune` (Sema's own
    // decorate_literal_with_expected k==142 case) -- decode its real
    // codepoint value rather than decode_char_literal's own single-byte
    // (escapes included) logic, which only ever looks at the first one
    // or two source bytes.
    if (cast_category((*e).data_type) == 8) {
      return Operand { is_reg := false, reg := 0, imm := decode_rune_literal(&(*(*s).buffers)[file_idx].bytes, (*e).tok.offset), is_null := false, is_float_imm := false, float_bits := 0 };
    }
    return Operand { is_reg := false, reg := 0, imm := decode_char_literal(&(*(*s).buffers)[file_idx].bytes, (*e).tok.offset), is_null := false, is_float_imm := false, float_bits := 0 };
  }

  if (k == 145) {
    return Operand { is_reg := false, reg := 0, imm := 0, is_null := true, is_float_imm := false, float_bits := 0 };
  }

  if (k == 164) {
    return gen_float_literal(cg, s, file_idx, e);
  }

  if (k == 143) {
    // Sema's own decorate_literal_with_expected k==143 case guarantees
    // `data_type` is always an ARRAY by the time this runs (a bare
    // string literal with no char[N]/rune[N] context is a hard Sema
    // error, never reaches Codegen at all) -- only its own ELEMENT type
    // still needs telling apart.
    if ((*(*(*e).data_type).left).kind == 120 && (*(*(*e).data_type).left).tok.kind == 36) {
      return gen_string_char_array(cg, s, file_idx, e);
    }
    if (cast_category((*(*e).data_type).left) == 8) {
      return gen_string_rune_array(cg, s, file_idx, e);
    }
    (*cg).had_error := true;
    return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }

  if (k == 146) {
    if (is_logical_op((*e).op_type)) {
      if ((*e).op_type == 77) { return gen_and(cg, s, sc, file_idx, e); }
      return gen_or(cg, s, sc, file_idx, e);
    }
    left_op := gen_expr(cg, s, sc, file_idx, (*e).left);
    right_op := gen_expr(cg, s, sc, file_idx, (*e).right);

    // v1.1.6: an `operator` overload (Sema's own find_operator_overload,
    // checked only when the built-in BINARY_EXPR category rules don't
    // already apply to both operands -- e.g. two struct types) sets
    // `symbol_ref` to the resolved OPERATOR_DECL; every built-in path
    // below assumes a scalar/pointer category that a struct operand
    // never has, so this must be checked first, before any of them run.
    if ((*e).symbol_ref != null) {
      return gen_operator_call(cg, s, (*e).symbol_ref, left_op, right_op);
    }

    lcat := cast_category((*(*e).left).data_type);
    rcat := cast_category((*(*e).right).data_type);

    if ((*e).op_type == 85 && (lcat == 4 || rcat == 4)) {
      return gen_ptr_add(cg, s, file_idx, e, left_op, right_op, lcat);
    }
    if ((*e).op_type == 80 && lcat == 4) {
      return gen_ptr_sub(cg, s, file_idx, e, left_op, right_op, rcat);
    }

    // `**` (v1.1.3): Sema's own decorate_expr already requires both
    // operands to be the same type, either integer OR float-family --
    // checked here on its own since neither LLVM instruction it maps to
    // (an `llvm.pow.*` intrinsic call for floats, a runtime multiply
    // loop for integers -- neither has a native single-instruction
    // form) fits the generic icmp/arithmetic-opcode dispatch below.
    if ((*e).op_type == 165) {
      if (lcat == 6) {
        return gen_float_pow(cg, s, e, left_op, right_op);
      }
      return gen_int_pow(cg, s, e, left_op, right_op);
    }

    // v1.1.3: a same-float-type operand pair (Sema's own decorate_expr
    // "`+ - * /` also accept a same-float-type pair" note, plus ordinary
    // float comparisons) -- `fadd`/`fsub`/`fmul`/`fdiv`/`fcmp` are
    // entirely separate LLVM instructions from their integer
    // counterparts below, never sharing an opcode/predicate spelling.
    if (lcat == 6) {
      return gen_float_binop(cg, s, e, left_op, right_op);
    }

    if (lcat == 4 && rcat == 4) {
      // SS3.4's pointer exception: any two pointer types compare,
      // regardless of pointee -- an address is conventionally an
      // UNSIGNED quantity, so ordered comparisons always use the
      // unsigned predicate here, never derived from a pointer type
      // node's own (meaningless -- TYPE_POINTER carries no base-type
      // keyword) tok.kind the way a scalar comparison's would be.
      is_unsigned := true;
    } else {
      is_unsigned := is_unsigned_for_cast((*(*(*e).left).data_type).tok.kind);
    }
    r := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
    if (is_comparison_op((*e).op_type)) {
      cg_piece(cg, 17);
      cg_cmp_pred(cg, (*e).op_type, is_unsigned);
      cg_byte(cg, 32);
      cg_type(cg, s, (*(*e).left).type_file_idx, (*(*e).left).data_type);
    } else {
      cg_binop_mnemonic(cg, (*e).op_type, is_unsigned);
      cg_byte(cg, 32);
      cg_type(cg, s, (*e).type_file_idx, (*e).data_type);
    }
    cg_byte(cg, 32);
    cg_operand(cg, left_op);
    cg_piece(cg, 3);
    cg_operand(cg, right_op);
    cg_piece(cg, 0);
    return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }

  if (k == 147) {
    if ((*e).op_type == 82) {
      // Address-of: the inner lvalue's own ADDRESS (an ordinary local's
      // own alloca slot register, or a freshly-computed `getelementptr`
      // for `&x.field`/`&arr[i]`) -- never call gen_expr (which would
      // instead LOAD its current value) on the operand here.
      return gen_addr(cg, s, sc, file_idx, (*e).left);
    }
    left_op := gen_expr(cg, s, sc, file_idx, (*e).left);
    if ((*e).op_type == 81) {
      r := new_reg(cg);
      cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 7);
      cg_type(cg, s, (*e).type_file_idx, (*e).data_type);
      cg_piece(cg, 8);
      cg_operand(cg, left_op);
      cg_piece(cg, 0);
      return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
    }
    r := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
    if ((*e).op_type == 79) {
      cg_piece(cg, 18);
      cg_operand(cg, left_op);
      cg_piece(cg, 3);
      cg_byte(cg, 49);
    } else {
      if (cast_category((*(*e).left).data_type) == 6) {
        // v1.1.3: unary `-` on a float-family operand -- `fneg`, never
        // `sub <ty> 0, %x` (invalid IR for a float type, and wrong for
        // `-0.0` even conceptually).
        cg_byte(cg, 102); cg_byte(cg, 110); cg_byte(cg, 101); cg_byte(cg, 103); cg_byte(cg, 32);
        cg_type(cg, s, (*e).type_file_idx, (*e).data_type);
        cg_byte(cg, 32);
        cg_operand(cg, left_op);
      } else {
        cg_piece(cg, 28);
        cg_byte(cg, 32);
        cg_type(cg, s, (*e).type_file_idx, (*e).data_type);
        cg_byte(cg, 32);
        cg_byte(cg, 48);
        cg_piece(cg, 3);
        cg_operand(cg, left_op);
      }
    }
    cg_piece(cg, 0);
    return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }

  if (k == 149) {
    return gen_call(cg, s, sc, file_idx, e);
  }

  if (k == 148) {
    return gen_cast(cg, s, sc, file_idx, e);
  }

  if (k == 155 || k == 156) {
    // `extra` is the measured type for BOTH forms once decorated
    // (decorate_literal_with_expected's own header comment) EXCEPT the
    // expr form, which only ever set `left`, never `extra` -- that
    // case reads the already-decorated operand's own data_type
    // instead. Neither form's operand is ever evaluated at runtime
    // (see type_byte_size's own header comment on why not).
    if ((*e).left != null) {
      if (k == 155) {
        return Operand { is_reg := false, reg := 0, imm := uint64_to_int64(type_byte_size(cg, s, (*(*e).left).type_file_idx, (*(*e).left).data_type)), is_null := false, is_float_imm := false, float_bits := 0 };
      }
      if ((*(*e).left).data_type == null || (*(*(*e).left).data_type).kind != 122) {
        (*cg).had_error := true;
        return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
      }
      return Operand { is_reg := false, reg := 0, imm := (*(*(*e).left).data_type).int_val, is_null := false, is_float_imm := false, float_bits := 0 };
    }
    if (k == 155) {
      return Operand { is_reg := false, reg := 0, imm := uint64_to_int64(type_byte_size(cg, s, file_idx, (*e).extra)), is_null := false, is_float_imm := false, float_bits := 0 };
    }
    if ((*e).extra == null || (*(*e).extra).kind != 122) {
      (*cg).had_error := true;
      return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
    }
    return Operand { is_reg := false, reg := 0, imm := (*(*e).extra).int_val, is_null := false, is_float_imm := false, float_bits := 0 };
  }

  // STRUCT_LIT/ARRAY_LIT (postulate_v0_language_reference.md SS3.8): no
  // single LLVM instruction builds an aggregate constant from runtime
  // values, so this uses the same technique as any other composite
  // write -- a fresh temporary `alloca`, one `getelementptr`+`store`
  // per member (evaluated in the literal's own left-to-right written
  // order), then a whole-value `load` back out, exactly mirroring the
  // existing alloca+load/store convention everywhere else in this file
  // rather than inventing a literal-specific shape.
  if (k == 152) {
    lit_slot := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, lit_slot); cg_piece(cg, 2); cg_piece(cg, 6);
    cg_type(cg, s, (*e).type_file_idx, (*e).data_type);
    cg_piece(cg, 0);

    lit_lr := find_struct_symbol(s, file_idx, (*e).tok.offset, (*e).tok.length);
    if (!lit_lr.found) {
      (*cg).had_error := true;
      return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
    }
    lit_struct_decl := sym_decl(s, lit_lr.index);
    lit_struct_file := (*s).symbols.ptr[lit_lr.index].file_idx;
    lit_base_op := Operand { is_reg := true, reg := lit_slot, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };

    lit_field := (*e).first_child;
    while (lit_field != null) {
      lit_decl_field := (*lit_struct_decl).first_child;
      lit_field_idx := 0;
      lit_found := false;
      while (lit_decl_field != null && !lit_found) {
        if (bytes_equal_cross(&(*(*s).buffers)[lit_struct_file].bytes, (*lit_decl_field).tok.offset, (*lit_decl_field).tok.length, &(*(*s).buffers)[file_idx].bytes, (*lit_field).tok.offset, (*lit_field).tok.length)) {
          lit_found := true;
        } else {
          lit_decl_field := (*lit_decl_field).next_sibling;
          lit_field_idx := lit_field_idx + 1;
        }
      }
      lit_val_op := gen_expr(cg, s, sc, file_idx, (*lit_field).left);
      lit_addr := gen_member_addr(cg, s, (*e).type_file_idx, (*e).data_type, lit_base_op, lit_field_idx);
      cg_piece(cg, 1); cg_piece(cg, 9);
      cg_type(cg, s, lit_struct_file, (*lit_decl_field).data_type);
      cg_byte(cg, 32);
      cg_operand(cg, lit_val_op);
      cg_piece(cg, 8); cg_operand(cg, lit_addr); cg_piece(cg, 0);

      lit_field := (*lit_field).next_sibling;
    }

    r := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 7);
    cg_type(cg, s, (*e).type_file_idx, (*e).data_type);
    cg_piece(cg, 8); cg_reg_ref(cg, lit_slot); cg_piece(cg, 0);
    return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }

  if (k == 153) {
    lit_slot := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, lit_slot); cg_piece(cg, 2); cg_piece(cg, 6);
    cg_type(cg, s, (*e).type_file_idx, (*e).data_type);
    cg_piece(cg, 0);

    lit_elem_ty := (*(*e).data_type).left;
    lit_elem_file := (*e).type_file_idx;
    lit_base_op := Operand { is_reg := true, reg := lit_slot, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };

    lit_field := (*e).first_child;
    lit_field_idx := 0;
    while (lit_field != null) {
      lit_val_op := gen_expr(cg, s, sc, file_idx, lit_field);
      lit_addr := gen_member_addr(cg, s, (*e).type_file_idx, (*e).data_type, lit_base_op, lit_field_idx);
      cg_piece(cg, 1); cg_piece(cg, 9);
      cg_type(cg, s, lit_elem_file, lit_elem_ty);
      cg_byte(cg, 32);
      cg_operand(cg, lit_val_op);
      cg_piece(cg, 8); cg_operand(cg, lit_addr); cg_piece(cg, 0);

      lit_field := (*lit_field).next_sibling;
      lit_field_idx := lit_field_idx + 1;
    }

    r := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 7);
    cg_type(cg, s, (*e).type_file_idx, (*e).data_type);
    cg_piece(cg, 8); cg_reg_ref(cg, lit_slot); cg_piece(cg, 0);
    return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }

  if (k == 150 || k == 151) {
    left_op := gen_addr(cg, s, sc, file_idx, e);
    r := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 7);
    cg_type(cg, s, (*e).type_file_idx, (*e).data_type);
    cg_piece(cg, 8);
    cg_operand(cg, left_op);
    cg_piece(cg, 0);
    return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }

  (*cg).had_error := true;
  return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

// field_decl's own position (0-based) among struct_decl's FIELD_DECL
// chain -- exactly the index `getelementptr`'s own struct-index operand
// needs. field_decl is always (*some FIELD_EXPR).symbol_ref, already
// resolved by Module 3's own decorate_expr (k == 151) to point at one
// of struct_decl's actual children, so the walk always terminates on a
// match, never falls off the end.
function find_field_index(struct_decl: *ASTNode, field_decl: *ASTNode) : uint64 {
  mut field : *ASTNode := (*struct_decl).first_child;
  mut idx : uint64 := 0;
  while (field != null && field != field_decl) {
    field := (*field).next_sibling;
    idx := idx + 1;
  }
  return idx;
}

// `%r = getelementptr <container_ty>, ptr <base>, i32 0, i32 <index>` --
// the leading `i32 0` selects "the one container object at `base`"
// (GEP's own pointer-arithmetic-over-an-array-of-container_ty
// interpretation), the second selects a compile-time-known struct
// field or array element position within it. Shared by FIELD_EXPR's
// own address computation and by STRUCT_LIT/ARRAY_LIT's own per-
// member store address (gen_addr and gen_expr, below) -- NOT used for
// a runtime-VARIABLE array index (gen_addr's own INDEX_EXPR case),
// since that one's second GEP operand has to keep the index
// expression's own natural type, not a hardcoded `i32` constant.
function gen_member_addr(cg: *Codegen, s: *Sema, container_file: uint64, container_ty: *ASTNode, base: Operand, index: uint64) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 52);
  cg_type(cg, s, container_file, container_ty);
  cg_piece(cg, 3);
  cg_piece(cg, 51); cg_byte(cg, 32);
  cg_operand(cg, base);
  cg_piece(cg, 3);
  cg_byte(cg, 105); cg_uint(cg, 32); cg_byte(cg, 32); cg_byte(cg, 48);
  cg_piece(cg, 3);
  cg_byte(cg, 105); cg_uint(cg, 32); cg_byte(cg, 32); cg_uint(cg, index);
  cg_piece(cg, 0);
  return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

// Broadcast-init/assignment (postulate_v1_language_reference.md SS4.1/
// SS4.2, v1.1.7): a DECL_STMT/ASSIGN_PAIR whose target is array-typed
// but whose source is a plain scalar/struct expression (never STRING_
// LIT/ARRAY_LIT, which are already their own whole-array value forms --
// see Sema.ptl's check_array_broadcast_or_expected header comment)
// stores that ALREADY-EVALUATED value -- evaluated exactly once by the
// caller, before this runs, per the language's own "coerced/copied
// exactly once, never re-evaluated per element" rule -- into every
// element via an unrolled GEP+store per index (the array's own size is
// always a compile-time constant, `target_ty.int_val`). Sema only ever
// unwraps ONE level (a scalar broadcasts into an array's own immediate
// element type, never recursively into a further-nested array, per
// that same header comment), so this never recurses either.
function gen_broadcast_store(cg: *Codegen, s: *Sema, target_file: uint64, target_ty: *ASTNode, target_addr: Operand, elem_file: uint64, elem_ty: *ASTNode, val_op: Operand) : void {
  mut n : uint64 := int64_to_uint64((*target_ty).int_val);
  mut i : uint64 := 0;
  mut elem_addr : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  while (i < n) {
    elem_addr := gen_member_addr(cg, s, target_file, target_ty, target_addr, i);
    cg_piece(cg, 1); cg_piece(cg, 9);
    cg_type(cg, s, elem_file, elem_ty);
    cg_byte(cg, 32);
    cg_operand(cg, val_op);
    cg_piece(cg, 8); cg_operand(cg, elem_addr); cg_piece(cg, 0);
    i := i + 1;
  }
}

// Whether a DECL_STMT/ASSIGN_PAIR's own source, of AST kind `src_kind`,
// needs gen_broadcast_store above rather than a single plain store --
// exactly Sema's own "array-typed target, but the source isn't already
// one of the two whole-array literal forms" condition.
function is_broadcast_target(target_ty: *ASTNode, src_kind: uint32) : bool {
  return target_ty != null && (*target_ty).kind == 122 && src_kind != 143 && src_kind != 153;
}

// The lvalue's own "address" operand -- used both to STORE through
// (ASSIGN_STMT) and, for FIELD_EXPR/INDEX_EXPR, to LOAD from (gen_
// expr's own read branches for kind 150/151): an ordinary local
// (IDENT_EXPR) is its own alloca slot register, used directly; `*p` is
// the pointer VALUE `p` evaluates to (gen_expr on the dereference's own
// operand, not the dereference itself); `x.field` computes the base's
// own address (recursing into gen_addr if the base is itself a plain
// struct value, or gen_expr if the base's static type is already a
// pointer-to-struct, matching decorate_expr's own one-level auto-deref
// rule for `.`) then a struct-shaped `getelementptr`; `arr[i]` reuses
// gen_ptr_add's existing single-index GEP shape when the base is a
// pointer (`p[i]` is exactly `*(p + i)`), or a leading-`i32 0` array-
// shaped `getelementptr` when the base is a true array value.
function gen_addr(cg: *Codegen, s: *Sema, sc: *Scope, file_idx: uint64, e: *ASTNode) : Operand {
  mut base_ty : *ASTNode := null;
  mut base_file : uint64 := 0;
  mut base_addr : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut struct_ty : *ASTNode := null;
  mut struct_file : uint64 := 0;
  mut lr : LookupResult := LookupResult { found := false, index := 0 };
  mut struct_decl : *ASTNode := null;
  mut field_idx : uint64 := 0;
  mut idx_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut r : uint64 := 0;

  if ((*e).kind == 140 || (*e).kind == 163) {
    return Operand { is_reg := true, reg := scope_reg_for_decl(sc, (*e).symbol_ref), imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }
  if ((*e).kind == 147 && (*e).op_type == 81) {
    return gen_expr(cg, s, sc, file_idx, (*e).left);
  }

  if ((*e).kind == 151) {
    base_ty := (*(*e).left).data_type;
    base_file := (*(*e).left).type_file_idx;
    if (base_ty != null && (*base_ty).kind == 121) {
      base_addr := gen_expr(cg, s, sc, file_idx, (*e).left);
      struct_ty := (*base_ty).left;
    } else {
      base_addr := gen_addr(cg, s, sc, file_idx, (*e).left);
      struct_ty := base_ty;
    }
    struct_file := base_file;
    lr := find_struct_symbol(s, struct_file, (*struct_ty).tok.offset, (*struct_ty).tok.length);
    if (!lr.found) {
      (*cg).had_error := true;
      return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
    }
    struct_decl := sym_decl(s, lr.index);
    field_idx := find_field_index(struct_decl, (*e).symbol_ref);
    return gen_member_addr(cg, s, struct_file, struct_ty, base_addr, field_idx);
  }

  if ((*e).kind == 150) {
    base_ty := (*(*e).left).data_type;
    base_file := (*(*e).left).type_file_idx;
    if (base_ty != null && (*base_ty).kind == 121) {
      base_addr := gen_expr(cg, s, sc, file_idx, (*e).left);
      idx_op := gen_expr(cg, s, sc, file_idx, (*e).right);
      return gen_ptr_add(cg, s, file_idx, e, base_addr, idx_op, 4);
    }
    base_addr := gen_addr(cg, s, sc, file_idx, (*e).left);
    idx_op := gen_expr(cg, s, sc, file_idx, (*e).right);
    r := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2); cg_piece(cg, 52);
    cg_type(cg, s, base_file, base_ty);
    cg_piece(cg, 3);
    cg_piece(cg, 51); cg_byte(cg, 32);
    cg_operand(cg, base_addr);
    cg_piece(cg, 3);
    cg_byte(cg, 105); cg_uint(cg, 32); cg_byte(cg, 32); cg_byte(cg, 48);
    cg_piece(cg, 3);
    cg_type(cg, s, (*(*e).right).type_file_idx, (*(*e).right).data_type);
    cg_byte(cg, 32);
    cg_operand(cg, idx_op);
    cg_piece(cg, 0);
    return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }

  (*cg).had_error := true;
  return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

function gen_stmt(cg: *Codegen, s: *Sema, sc: *Scope, file_idx: uint64, stmt: *ASTNode) : void {
  mut k : uint32 := (*stmt).kind;
  mut cond_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut then_l : uint64 := 0;
  mut else_l : uint64 := 0;
  mut end_l : uint64 := 0;
  mut cond_l : uint64 := 0;
  mut body_l : uint64 := 0;
  mut ret_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut val_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut slot : uint64 := 0;
  mut pair : *ASTNode := null;
  mut pair_slots : Operand[16];
  mut pair_ops : Operand[16];
  mut n_pairs : uint64 := 0;
  mut i : uint64 := 0;
  mut branch_ret : bool := false;
  mut branch : *ASTNode := null;
  mut next_branch : *ASTNode := null;
  mut synth_bin : ASTNode := ASTNode { kind := 146, tok := Token { kind := 0, offset := 0, length := 0 }, first_child := null, next_sibling := null, data_type := null, is_mutable := false, int_val := 0, op_type := 0, left := null, right := null, extra := null, symbol_ref := null, is_constant := false, type_file_idx := 0 };
  mut synth_one : ASTNode := ASTNode { kind := 141, tok := Token { kind := 0, offset := 0, length := 0 }, first_child := null, next_sibling := null, data_type := null, is_mutable := false, int_val := 1, op_type := 0, left := null, right := null, extra := null, symbol_ref := null, is_constant := false, type_file_idx := 0 };
  mut addr_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut incdec_binop : int32 := 80;
  mut first_branch : bool := true;

  // IF_STMT (v1.1.2): first_child is a real, flat IF_BRANCH chain (the
  // `if` plus every `elseif`, in source order) -- no longer a single
  // cond/then pair with an `extra` that might be a nested IF_STMT (see
  // Sema.ptl's decorate_stmt k==131 case, which documents the same AST
  // shape change from the Sema side). Each branch's own cond is tested
  // in turn; a false test falls through to a label that either starts
  // the NEXT branch's own cond test, starts the final `else` BLOCK (if
  // any), or -- for the last branch with no `else` -- is simply the
  // statement's own shared end label.
  if (k == 131) {
    first_branch := true;
    branch := (*stmt).first_child;
    while (branch != null) {
      cond_op := gen_expr(cg, s, sc, file_idx, (*branch).left);
      then_l := new_label(cg);
      // The shared exit label is allocated right after the FIRST
      // branch's own then_l -- matching the label numbering an ordinary
      // single-`if`/`if-else` (no `elseif`) got before this function was
      // generalized to a real n-way chain, so the common case's own
      // fixture goldens don't churn over a purely cosmetic renumbering.
      if (first_branch) {
        end_l := new_label(cg);
        first_branch := false;
      }
      next_branch := (*branch).next_sibling;
      if (next_branch != null) {
        else_l := new_label(cg);
      } else {
        if ((*stmt).extra != null) {
          else_l := new_label(cg);
        } else {
          else_l := end_l;
        }
      }

      cg_piece(cg, 1); cg_piece(cg, 13); cg_operand(cg, cond_op);
      cg_piece(cg, 14); cg_label_target(cg, then_l);
      cg_piece(cg, 14); cg_label_target(cg, else_l);
      cg_piece(cg, 0);

      cg_label_def(cg, then_l);
      // A `br` right after the then-block's own `ret`/`break`/`continue`
      // (no label between them) would be a second terminator in the
      // same basic block -- invalid IR -- so it's only emitted when the
      // block did NOT already end in one (gen_block's own returned
      // bool; see its own comment for exactly what it does and doesn't
      // detect).
      branch_ret := gen_block(cg, s, sc, file_idx, (*branch).right);
      if (!branch_ret) {
        cg_piece(cg, 1); cg_piece(cg, 12); cg_piece(cg, 15); cg_label_target(cg, end_l); cg_piece(cg, 0);
      }

      if (next_branch != null) {
        cg_label_def(cg, else_l);
      } else {
        if ((*stmt).extra != null) {
          cg_label_def(cg, else_l);
          branch_ret := gen_block(cg, s, sc, file_idx, (*stmt).extra);
          if (!branch_ret) {
            cg_piece(cg, 1); cg_piece(cg, 12); cg_piece(cg, 15); cg_label_target(cg, end_l); cg_piece(cg, 0);
          }
        }
      }

      branch := next_branch;
    }

    cg_label_def(cg, end_l);
    return;
  }

  if (k == 132) {
    cond_l := new_label(cg);
    body_l := new_label(cg);
    end_l := new_label(cg);

    cg_piece(cg, 1); cg_piece(cg, 12); cg_piece(cg, 15); cg_label_target(cg, cond_l); cg_piece(cg, 0);

    cg_label_def(cg, cond_l);
    cond_op := gen_expr(cg, s, sc, file_idx, (*stmt).left);
    cg_piece(cg, 1); cg_piece(cg, 13); cg_operand(cg, cond_op);
    cg_piece(cg, 14); cg_label_target(cg, body_l);
    cg_piece(cg, 14); cg_label_target(cg, end_l);
    cg_piece(cg, 0);

    cg_label_def(cg, body_l);
    // BREAK_STMT/CONTINUE_STMT anywhere in this body (including nested
    // inside an `if`, which does NOT push its own scope here -- Sema's
    // own Scope.loop_depth comment notes the same) resolve against
    // these two targets; popped again once the body's own statements
    // are done, so an enclosing loop (if any) sees ITS OWN targets
    // again for whatever follows.
    (*cg).loop_break[(*cg).loop_top] := end_l;
    (*cg).loop_continue[(*cg).loop_top] := cond_l;
    (*cg).loop_top := (*cg).loop_top + 1;
    branch_ret := gen_block(cg, s, sc, file_idx, (*stmt).right);
    (*cg).loop_top := (*cg).loop_top - 1;
    if (!branch_ret) {
      cg_piece(cg, 1); cg_piece(cg, 12); cg_piece(cg, 15); cg_label_target(cg, cond_l); cg_piece(cg, 0);
    }

    cg_label_def(cg, end_l);
    return;
  }

  if (k == 158) {
    cg_piece(cg, 1); cg_piece(cg, 12); cg_piece(cg, 15); cg_label_target(cg, (*cg).loop_break[(*cg).loop_top - 1]); cg_piece(cg, 0);
    return;
  }

  if (k == 159) {
    cg_piece(cg, 1); cg_piece(cg, 12); cg_piece(cg, 15); cg_label_target(cg, (*cg).loop_continue[(*cg).loop_top - 1]); cg_piece(cg, 0);
    return;
  }

  // INCDEC_STMT (`++`/`--`): read-modify-write through a synthetic
  // BINARY_EXPR (`target + 1` / `target - 1`), exactly the way ASSIGN_
  // STMT's own compound-assignment case below reuses gen_expr's k==146
  // codegen for `:+ :- :* :/` rather than duplicating its arithmetic/
  // pointer-arithmetic rules here -- Sema's own decorate_stmt k==160
  // case already confirmed the target is an integer lvalue (cast_
  // category == 1), so `1` always anchors to its own type cleanly.
  if (k == 160) {
    incdec_binop := 80;
    if ((*stmt).op_type == 163) { incdec_binop := 85; }
    synth_one := ASTNode { kind := 141, tok := Token { kind := 0, offset := 0, length := 0 }, first_child := null, next_sibling := null, data_type := (*(*stmt).left).data_type, is_mutable := false, int_val := 1, op_type := 0, left := null, right := null, extra := null, symbol_ref := null, is_constant := false, type_file_idx := (*(*stmt).left).type_file_idx };
    synth_bin := ASTNode { kind := 146, tok := Token { kind := 0, offset := 0, length := 0 }, first_child := null, next_sibling := null, data_type := (*(*stmt).left).data_type, is_mutable := false, int_val := 0, op_type := incdec_binop, left := (*stmt).left, right := &synth_one, extra := null, symbol_ref := null, is_constant := false, type_file_idx := (*(*stmt).left).type_file_idx };
    val_op := gen_expr(cg, s, sc, file_idx, &synth_bin);
    addr_op := gen_addr(cg, s, sc, file_idx, (*stmt).left);
    cg_piece(cg, 1); cg_piece(cg, 9);
    cg_type(cg, s, (*(*stmt).left).type_file_idx, (*(*stmt).left).data_type);
    cg_byte(cg, 32);
    cg_operand(cg, val_op);
    cg_piece(cg, 8); cg_operand(cg, addr_op); cg_piece(cg, 0);
    return;
  }

  if (k == 133) {
    if ((*stmt).left != null) {
      ret_op := gen_expr(cg, s, sc, file_idx, (*stmt).left);
      cg_piece(cg, 1); cg_piece(cg, 10);
      cg_type(cg, s, (*(*stmt).left).type_file_idx, (*(*stmt).left).data_type);
      cg_byte(cg, 32);
      cg_operand(cg, ret_op);
      cg_piece(cg, 0);
    } else {
      cg_piece(cg, 1); cg_piece(cg, 11);
    }
    return;
  }

  if (k == 134) {
    slot := scope_reg_for_decl(sc, stmt);
    if ((*stmt).left != null) {
      val_op := gen_expr(cg, s, sc, file_idx, (*stmt).left);
      if (is_broadcast_target((*stmt).data_type, (*(*stmt).left).kind)) {
        gen_broadcast_store(cg, s, file_idx, (*stmt).data_type, Operand { is_reg := true, reg := slot, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 }, (*(*stmt).left).type_file_idx, (*(*stmt).left).data_type, val_op);
      } else {
        cg_piece(cg, 1); cg_piece(cg, 9);
        cg_type(cg, s, file_idx, (*stmt).data_type);
        cg_byte(cg, 32);
        cg_operand(cg, val_op);
        cg_piece(cg, 8); cg_reg_ref(cg, slot); cg_piece(cg, 0);
      }
    }
    return;
  }

  if (k == 135) {
    // Dijkstra/Hoare simultaneous assignment (postulate_v0_language_
    // reference.md SS4.2): every right-hand side evaluated against the
    // state as it was before, THEN all stores happen -- collect every
    // pair's target slot and computed value first, in one pass, before
    // emitting any `store` at all.
    pair := (*stmt).first_child;
    while (pair != null) {
      pair_slots[n_pairs] := gen_addr(cg, s, sc, file_idx, (*pair).left);
      if ((*pair).op_type == 0) {
        pair_ops[n_pairs] := gen_expr(cg, s, sc, file_idx, (*pair).right);
      } else {
        // Compound assignment (`:+ :- :* :/`): read the lvalue's CURRENT
        // value here, in this same before-any-stores pass (matching the
        // Dijkstra/Hoare rule above -- `a :+ b, a := c` still reads `a`'s
        // OLD value for the first pair), via a synthetic BINARY_EXPR
        // reusing gen_expr's k==146 codegen, same technique as INCDEC_
        // STMT above and Sema's own check_compound_assign.
        synth_bin := ASTNode { kind := 146, tok := Token { kind := 0, offset := 0, length := 0 }, first_child := null, next_sibling := null, data_type := (*(*pair).left).data_type, is_mutable := false, int_val := 0, op_type := compound_op_to_binary((*pair).op_type), left := (*pair).left, right := (*pair).right, extra := null, symbol_ref := null, is_constant := false, type_file_idx := (*(*pair).left).type_file_idx };
        pair_ops[n_pairs] := gen_expr(cg, s, sc, file_idx, &synth_bin);
      }
      n_pairs := n_pairs + 1;
      pair := (*pair).next_sibling;
    }
    pair := (*stmt).first_child;
    i := 0;
    while (i < n_pairs) {
      if ((*pair).op_type == 0 && is_broadcast_target((*(*pair).left).data_type, (*(*pair).right).kind)) {
        gen_broadcast_store(cg, s, (*(*pair).left).type_file_idx, (*(*pair).left).data_type, pair_slots[i], (*(*pair).right).type_file_idx, (*(*pair).right).data_type, pair_ops[i]);
      } else {
        cg_piece(cg, 1); cg_piece(cg, 9);
        cg_type(cg, s, (*(*pair).left).type_file_idx, (*(*pair).left).data_type);
        cg_byte(cg, 32);
        cg_operand(cg, pair_ops[i]);
        cg_piece(cg, 8); cg_operand(cg, pair_slots[i]); cg_piece(cg, 0);
      }
      pair := (*pair).next_sibling;
      i := i + 1;
    }
    return;
  }

  if (k == 136) {
    val_op := gen_expr(cg, s, sc, file_idx, (*stmt).left);
    return;
  }
}

// Returns whether this block's own last statement, positionally, was
// literally a RETURN_STMT/BREAK_STMT/CONTINUE_STMT -- not real
// reachability analysis (Module 3 doesn't do "every path returns"
// checking, so this doesn't either), just enough for callers to know
// whether the basic block they're still inside already has a
// terminator, and so must NOT get another instruction appended to it
// (LLVM IR allows only one terminator per block, at its very end). A
// block ending in an `if`/`while` that itself always returns doesn't
// need this: gen_stmt's own IF_STMT case always finishes by DEFINING a
// fresh, unterminated label with nothing emitted after it, so the code
// position right after it is always safe to append to regardless of
// what happened inside.
function gen_block(cg: *Codegen, s: *Sema, sc: *Scope, file_idx: uint64, block: *ASTNode) : bool {
  mut stmt : *ASTNode := (*block).first_child;
  mut last_kind : uint32 := 0;
  while (stmt != null) {
    gen_stmt(cg, s, sc, file_idx, stmt);
    last_kind := (*stmt).kind;
    stmt := (*stmt).next_sibling;
  }
  return last_kind == 133 || last_kind == 158 || last_kind == 159;
}

// v1.1.6: an OPERATOR_DECL's own `tok` is the overloaded operator's own
// token (e.g. `==`), never a valid LLVM identifier on its own -- every
// overload instead gets a synthetic name, `__operator_<N>`, where N is
// its own stable position in Sema's own `(*s).operators` registration
// array (populated once, at declare time, in declare_operator -- never
// reordered afterward, so any two call sites computing this the same
// way -- the definition in gen_program/gen_function and every BINARY_
// EXPR call site resolved to it in gen_expr -- always agree without
// needing to thread the index through the AST itself).
function find_operator_index(s: *Sema, decl: *ASTNode) : uint64 {
  mut i : uint64 := 0;
  while (i < (*s).operator_count) {
    if ((*(*s).operators)[i].decl == decl) { return i; }
    i := i + 1;
  }
  return 0;
}

function cg_operator_name(cg: *Codegen, idx: uint64) : void {
  cg_byte(cg, 95); cg_byte(cg, 95);
  cg_byte(cg, 111); cg_byte(cg, 112); cg_byte(cg, 101); cg_byte(cg, 114);
  cg_byte(cg, 97); cg_byte(cg, 116); cg_byte(cg, 111); cg_byte(cg, 114);
  cg_byte(cg, 95);
  cg_uint(cg, idx);
}

// A resolved operator overload (BINARY_EXPR.symbol_ref set by Sema's
// own decorate_expr, once `find_operator_overload` matches) is called
// exactly like an ordinary two-argument function -- `left_op`/`right_op`
// are already-evaluated operands (gen_expr's own k==146 case computes
// them before checking `symbol_ref`, same order as the built-in
// arithmetic path it replaces), and the overload's own two PARAM_DECLs
// give each argument's real declared type (never re-derived from the
// call site, which might reach it through an implicit conversion the
// declared parameter type itself already accounts for). `OperatorOverload.
// file_idx` -- not this expression's own file -- is used for every type
// lookup here, since the overload's own signature was written in
// (and its type tokens still point into) that declaring file.
function gen_operator_call(cg: *Codegen, s: *Sema, decl: *ASTNode, left_op: Operand, right_op: Operand) : Operand {
  mut idx : uint64 := find_operator_index(s, decl);
  mut ov_file : uint64 := (*(*s).operators)[idx].file_idx;
  mut is_void : bool := is_void_type((*decl).data_type);
  mut r : uint64 := 0;
  mut param1 : *ASTNode := (*decl).first_child;
  mut param2 : *ASTNode := (*param1).next_sibling;

  cg_piece(cg, 1);
  if (!is_void) {
    r := new_reg(cg);
    cg_reg_ref(cg, r);
    cg_piece(cg, 2);
  }
  cg_piece(cg, 16);
  cg_type(cg, s, ov_file, (*decl).data_type);
  cg_byte(cg, 32);
  cg_byte(cg, 64);
  cg_operator_name(cg, idx);
  cg_piece(cg, 24);
  cg_type(cg, s, ov_file, (*param1).data_type);
  cg_byte(cg, 32);
  cg_operand(cg, left_op);
  cg_piece(cg, 3);
  cg_type(cg, s, ov_file, (*param2).data_type);
  cg_byte(cg, 32);
  cg_operand(cg, right_op);
  cg_piece(cg, 25);
  cg_piece(cg, 0);

  if (is_void) {
    return Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  }
  return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

function gen_function(cg: *Codegen, s: *Sema, func_decl: *ASTNode, file_idx: uint64) : void {
  mut sc : Scope := Scope { bindings := dynbindings_new(256), count := 0, ret_type := (*func_decl).data_type, ret_file := file_idx, loop_depth := 0 };
  mut param : *ASTNode := (*func_decl).first_child;
  mut body : *ASTNode := (*func_decl).extra;
  mut stmt : *ASTNode := null;
  mut pidx : uint64 := 0;
  mut val_pidx : uint64 := 0;
  mut slot : uint64 := 0;
  mut body_ret : bool := false;

  (*cg).loop_top := 0;

  cg_piece(cg, 4);
  cg_type(cg, s, file_idx, (*func_decl).data_type);
  cg_byte(cg, 32);
  cg_byte(cg, 64);
  if ((*func_decl).kind == 162) {
    cg_operator_name(cg, find_operator_index(s, func_decl));
  } else {
    cg_slice(cg, &(*(*s).buffers)[file_idx].bytes, (*func_decl).tok.offset, (*func_decl).tok.length);
  }
  cg_piece(cg, 24);
  while (param != null) {
    if (pidx > 0) { cg_piece(cg, 3); }
    if ((*param).is_mutable) {
      // `ref` parameter (v1.1.5): passed by address -- the incoming
      // LLVM parameter itself IS the caller's own storage location (see
      // gen_call's own matching change), so it's named directly in the
      // same %rN register space every other local's own alloca slot
      // already lives in (never %pN) and bound into `sc` right here --
      // every later read/write of this PARAM_DECL then falls through
      // gen_expr/gen_addr's ordinary IDENT_EXPR paths completely
      // unchanged, load/storing through this register exactly like any
      // other local's own alloca'd address, no double indirection or
      // special-casing needed anywhere else in this file.
      slot := new_reg(cg);
      scope_add(&sc, param);
      sc.bindings.ptr[sc.count - 1].reg := slot;
      cg_piece(cg, 51);
      cg_byte(cg, 32);
      cg_reg_ref(cg, slot);
    } else {
      cg_type(cg, s, file_idx, (*param).data_type);
      cg_byte(cg, 32);
      cg_param_ref(cg, val_pidx);
      val_pidx := val_pidx + 1;
    }
    param := (*param).next_sibling;
    pidx := pidx + 1;
  }
  cg_piece(cg, 25);
  cg_byte(cg, 32);
  cg_piece(cg, 22);
  cg_piece(cg, 20);

  param := (*func_decl).first_child;
  val_pidx := 0;
  while (param != null) {
    if (!(*param).is_mutable) {
      scope_add(&sc, param);
      slot := new_reg(cg);
      sc.bindings.ptr[sc.count - 1].reg := slot;
      cg_piece(cg, 1); cg_reg_ref(cg, slot); cg_piece(cg, 2); cg_piece(cg, 6);
      cg_type(cg, s, file_idx, (*param).data_type);
      cg_piece(cg, 0);
      cg_piece(cg, 1); cg_piece(cg, 9);
      cg_type(cg, s, file_idx, (*param).data_type);
      cg_byte(cg, 32);
      cg_param_ref(cg, val_pidx);
      cg_piece(cg, 8); cg_reg_ref(cg, slot); cg_piece(cg, 0);
      val_pidx := val_pidx + 1;
    }
    param := (*param).next_sibling;
  }

  if (body != null) {
    stmt := (*body).first_child;
    while (stmt != null) {
      if ((*stmt).kind == 134) {
        scope_add(&sc, stmt);
        slot := new_reg(cg);
        sc.bindings.ptr[sc.count - 1].reg := slot;
        cg_piece(cg, 1); cg_reg_ref(cg, slot); cg_piece(cg, 2); cg_piece(cg, 6);
        cg_type(cg, s, file_idx, (*stmt).data_type);
        cg_piece(cg, 0);
      }
      stmt := (*stmt).next_sibling;
    }
    body_ret := gen_block(cg, s, &sc, file_idx, body);
  }

  // Only reached when the body did NOT already end in its own `ret`
  // (Module 3 doesn't do full "every path returns" control-flow
  // analysis, so a source function that doesn't is still possible) --
  // NO fresh label first: wherever generation left off is always
  // either mid-block (some non-terminator statement, e.g. a plain
  // assignment, was the body's last one -- this terminates it) or
  // sitting right at an `if`/`while`'s own freshly-defined, still-
  // empty merge label (gen_stmt's own IF_STMT/WHILE_STMT cases always
  // leave one behind) -- either way, appending a terminator directly
  // is exactly what that block still needs, and inserting a new label
  // first would either orphan the still-open current block (never
  // itself terminated) or produce a second, empty, unreachable label
  // with nothing branching into it -- both invalid IR.
  if (!body_ret) {
    if (is_void_type((*func_decl).data_type)) {
      cg_piece(cg, 1); cg_piece(cg, 11);
    } else {
      cg_piece(cg, 1); cg_piece(cg, 21);
    }
  }
  cg_piece(cg, 23);
}

// One `%Name = type { field1, field2, ... }` line per struct symbol in
// the WHOLE program (Sema's own symbol table is already global across
// every file by the time codegen runs), emitted once up front before
// any function/extern -- LLVM requires every named type to be defined
// before its first use, and a struct can be referenced from a function
// declared in any file via cross-file `use`. Plain (unpacked) `{ ... }`
// -- v1.1.8 switched struct layout's own default from packed to
// natural/ABI alignment (Sema.ptl's own compute_struct_size/
// field_type_align header comment), which is exactly what LLVM's
// default (non-`<{...}>`) struct layout already computes on its own:
// each field at the next offset that's a multiple of its own type's
// alignment, overall size rounded up to the struct's own (largest-
// field) alignment -- so no manual padding/offset math is needed here,
// just dropping the `<`/`>` packed markers this line used to wrap the
// field list in. GEP-by-field-index (find_field_index/gen_member_addr)
// is unaffected either way, since GEP always addresses a struct field
// by position, never by a hand-computed byte offset.
function gen_struct_types(cg: *Codegen, s: *Sema) : void {
  mut i : uint64 := 0;
  mut decl : *ASTNode := null;
  mut struct_file : uint64 := 0;
  mut field : *ASTNode := null;
  mut first : bool := true;

  while (i < (*s).symbol_count) {
    if ((*s).symbols.ptr[i].kind == 1) {
      decl := sym_decl(s, i);
      struct_file := (*s).symbols.ptr[i].file_idx;
      cg_byte(cg, 37);
      cg_slice(cg, &(*(*s).buffers)[struct_file].bytes, (*decl).tok.offset, (*decl).tok.length);
      cg_piece(cg, 2);
      cg_byte(cg, 116); cg_byte(cg, 121); cg_byte(cg, 112); cg_byte(cg, 101); cg_byte(cg, 32);
      cg_byte(cg, 123); cg_byte(cg, 32);
      field := (*decl).first_child;
      first := true;
      while (field != null) {
        if (!first) { cg_piece(cg, 3); }
        cg_type(cg, s, struct_file, (*field).data_type);
        first := false;
        field := (*field).next_sibling;
      }
      cg_byte(cg, 32); cg_byte(cg, 125);
      cg_piece(cg, 0);
    }
    i := i + 1;
  }
}


// Linux x86-64 syscall numbers for exactly the twelve `extern
// function` names postulate_v1_language_reference.md SS5.2 whitelists.
// Any OTHER extern function name still only gets a bare `declare`
// (gen_program's own fallback, unchanged below) -- there is no way to
// back an arbitrary extern symbol with a real implementation, only
// these twelve specific ones. `.index` (LookupResult's own generic
// payload field, reused here) holds the syscall number itself, not a
// symbol-table index. Matched the same way `classify_word` (the
// lexer's own keyword recognizer, above) matches fixed keyword text:
// bucketed by length first, then compared byte by byte.
function syscall_number_for(s: *Sema, file_idx: uint64, decl: *ASTNode) : LookupResult {
  mut buf : *DynBytes := &(*(*s).buffers)[file_idx].bytes;
  mut o : uint64 := (*decl).tok.offset;
  mut n : uint64 := (*decl).tok.length;

  if (n == 8) {
    if ((*buf).ptr[o+0]==115 && (*buf).ptr[o+1]==121 && (*buf).ptr[o+2]==115 && (*buf).ptr[o+3]==95 && (*buf).ptr[o+4]==114 && (*buf).ptr[o+5]==101 && (*buf).ptr[o+6]==97 && (*buf).ptr[o+7]==100) { return LookupResult { found := true, index := 0 }; }
    if ((*buf).ptr[o+0]==115 && (*buf).ptr[o+1]==121 && (*buf).ptr[o+2]==115 && (*buf).ptr[o+3]==95 && (*buf).ptr[o+4]==109 && (*buf).ptr[o+5]==109 && (*buf).ptr[o+6]==97 && (*buf).ptr[o+7]==112) { return LookupResult { found := true, index := 9 }; }
    if ((*buf).ptr[o+0]==115 && (*buf).ptr[o+1]==121 && (*buf).ptr[o+2]==115 && (*buf).ptr[o+3]==95 && (*buf).ptr[o+4]==101 && (*buf).ptr[o+5]==120 && (*buf).ptr[o+6]==105 && (*buf).ptr[o+7]==116) { return LookupResult { found := true, index := 60 }; }
    return LookupResult { found := false, index := 0 };
  }
  if (n == 9) {
    if ((*buf).ptr[o+0]==115 && (*buf).ptr[o+1]==121 && (*buf).ptr[o+2]==115 && (*buf).ptr[o+3]==95 && (*buf).ptr[o+4]==119 && (*buf).ptr[o+5]==114 && (*buf).ptr[o+6]==105 && (*buf).ptr[o+7]==116 && (*buf).ptr[o+8]==101) { return LookupResult { found := true, index := 1 }; }
    if ((*buf).ptr[o+0]==115 && (*buf).ptr[o+1]==121 && (*buf).ptr[o+2]==115 && (*buf).ptr[o+3]==95 && (*buf).ptr[o+4]==99 && (*buf).ptr[o+5]==108 && (*buf).ptr[o+6]==111 && (*buf).ptr[o+7]==110 && (*buf).ptr[o+8]==101) { return LookupResult { found := true, index := 56 }; }
    if ((*buf).ptr[o+0]==115 && (*buf).ptr[o+1]==121 && (*buf).ptr[o+2]==115 && (*buf).ptr[o+3]==95 && (*buf).ptr[o+4]==102 && (*buf).ptr[o+5]==117 && (*buf).ptr[o+6]==116 && (*buf).ptr[o+7]==101 && (*buf).ptr[o+8]==120) { return LookupResult { found := true, index := 202 }; }
    if ((*buf).ptr[o+0]==115 && (*buf).ptr[o+1]==121 && (*buf).ptr[o+2]==115 && (*buf).ptr[o+3]==95 && (*buf).ptr[o+4]==99 && (*buf).ptr[o+5]==108 && (*buf).ptr[o+6]==111 && (*buf).ptr[o+7]==115 && (*buf).ptr[o+8]==101) { return LookupResult { found := true, index := 3 }; }
    return LookupResult { found := false, index := 0 };
  }
  if (n == 10) {
    if ((*buf).ptr[o+0]==115 && (*buf).ptr[o+1]==121 && (*buf).ptr[o+2]==115 && (*buf).ptr[o+3]==95 && (*buf).ptr[o+4]==109 && (*buf).ptr[o+5]==117 && (*buf).ptr[o+6]==110 && (*buf).ptr[o+7]==109 && (*buf).ptr[o+8]==97 && (*buf).ptr[o+9]==112) { return LookupResult { found := true, index := 11 }; }
    if ((*buf).ptr[o+0]==115 && (*buf).ptr[o+1]==121 && (*buf).ptr[o+2]==115 && (*buf).ptr[o+3]==95 && (*buf).ptr[o+4]==109 && (*buf).ptr[o+5]==114 && (*buf).ptr[o+6]==101 && (*buf).ptr[o+7]==109 && (*buf).ptr[o+8]==97 && (*buf).ptr[o+9]==112) { return LookupResult { found := true, index := 25 }; }
    if ((*buf).ptr[o+0]==115 && (*buf).ptr[o+1]==121 && (*buf).ptr[o+2]==115 && (*buf).ptr[o+3]==95 && (*buf).ptr[o+4]==103 && (*buf).ptr[o+5]==101 && (*buf).ptr[o+6]==116 && (*buf).ptr[o+7]==116 && (*buf).ptr[o+8]==105 && (*buf).ptr[o+9]==100) { return LookupResult { found := true, index := 186 }; }
    if ((*buf).ptr[o+0]==115 && (*buf).ptr[o+1]==121 && (*buf).ptr[o+2]==115 && (*buf).ptr[o+3]==95 && (*buf).ptr[o+4]==111 && (*buf).ptr[o+5]==112 && (*buf).ptr[o+6]==101 && (*buf).ptr[o+7]==110 && (*buf).ptr[o+8]==97 && (*buf).ptr[o+9]==116) { return LookupResult { found := true, index := 257 }; }
    return LookupResult { found := false, index := 0 };
  }
  if (n == 14) {
    if ((*buf).ptr[o+0]==115 && (*buf).ptr[o+1]==121 && (*buf).ptr[o+2]==115 && (*buf).ptr[o+3]==95 && (*buf).ptr[o+4]==101 && (*buf).ptr[o+5]==120 && (*buf).ptr[o+6]==105 && (*buf).ptr[o+7]==116 && (*buf).ptr[o+8]==95 && (*buf).ptr[o+9]==103 && (*buf).ptr[o+10]==114 && (*buf).ptr[o+11]==111 && (*buf).ptr[o+12]==117 && (*buf).ptr[o+13]==112) { return LookupResult { found := true, index := 231 }; }
    return LookupResult { found := false, index := 0 };
  }
  return LookupResult { found := false, index := 0 };
}

// A type a raw syscall wrapper can move through an integer register --
// a pointer (`ptrtoint`/`inttoptr` at the boundary) or any non-void
// scalar keyword (passed/returned as its own width, widened to `i64`
// with `zext` when narrower -- every whitelisted parameter narrower
// than 64 bits happens to be `uint32`, SS5.2's own table, so `zext` is
// always correct here, never `sext`). Explicitly false for a struct-
// named TYPE_BASE or an array -- neither has a meaningful raw-register
// representation, so a same-named `extern function` with one anywhere
// in its signature safely falls back to gen_program's plain `declare`
// instead of a syscall wrapper, rather than emitting nonsense IR.
function is_syscall_safe_type(ty: *ASTNode) : bool {
  if (ty == null) { return false; }
  if ((*ty).kind == 121) { return true; }
  if ((*ty).kind != 120) { return false; }
  if ((*ty).tok.kind == 33) { return false; }
  if ((*ty).tok.kind == 32) { return true; }
  return base_type_size((*ty).tok.kind) > 0;
}

function cg_syscall_arg_reg(cg: *Codegen, which: uint64) : void {
  cg_byte(cg, 123);
  if (which == 0) { cg_byte(cg, 114); cg_byte(cg, 100); cg_byte(cg, 105); }
  if (which == 1) { cg_byte(cg, 114); cg_byte(cg, 115); cg_byte(cg, 105); }
  if (which == 2) { cg_byte(cg, 114); cg_byte(cg, 100); cg_byte(cg, 120); }
  if (which == 3) { cg_byte(cg, 114); cg_byte(cg, 49); cg_byte(cg, 48); }
  if (which == 4) { cg_byte(cg, 114); cg_byte(cg, 56); }
  if (which == 5) { cg_byte(cg, 114); cg_byte(cg, 57); }
  cg_byte(cg, 125);
}

// The only realistic way to reach the kernel directly from LLVM IR --
// no libc, no syscall intrinsic -- is a `call` to an inline-asm blob
// with register-constrained operands, the same idiom e.g. Rust's/
// Zig's own freestanding raw-syscall paths use (postulate_stage1_
// bootstrap_plan.md's own "Tracked checkpoint: extern/syscall calls
// and `_start`", which this whole function, gen_syscall_extern, and
// gen_start below implement in full). `args` holds each already-`i64`
// argument operand, in order; `n_args` is at most 6 -- System V's own
// register-argument limit, which every whitelisted extern function
// already respects by construction. Always returns an `i64`; callers
// translate it to their own wrapper's declared return type themselves.
function gen_raw_syscall(cg: *Codegen, syscall_num: uint64, args: *(Operand[6]), n_args: uint64) : Operand {
  mut r : uint64 := new_reg(cg);
  mut i : uint64 := 0;
  mut cur : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };

  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_piece(cg, 16);
  cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
  cg_byte(cg, 97); cg_byte(cg, 115); cg_byte(cg, 109); cg_byte(cg, 32);
  cg_byte(cg, 115); cg_byte(cg, 105); cg_byte(cg, 100); cg_byte(cg, 101); cg_byte(cg, 101); cg_byte(cg, 102); cg_byte(cg, 102); cg_byte(cg, 101); cg_byte(cg, 99); cg_byte(cg, 116); cg_byte(cg, 32);
  cg_byte(cg, 34);
  cg_byte(cg, 115); cg_byte(cg, 121); cg_byte(cg, 115); cg_byte(cg, 99); cg_byte(cg, 97); cg_byte(cg, 108); cg_byte(cg, 108);
  cg_byte(cg, 34);
  cg_piece(cg, 3);
  cg_byte(cg, 34);
  cg_byte(cg, 61); cg_byte(cg, 123); cg_byte(cg, 114); cg_byte(cg, 97); cg_byte(cg, 120); cg_byte(cg, 125);
  cg_byte(cg, 44);
  cg_byte(cg, 123); cg_byte(cg, 114); cg_byte(cg, 97); cg_byte(cg, 120); cg_byte(cg, 125);
  i := 0;
  while (i < n_args) {
    cg_byte(cg, 44);
    cg_syscall_arg_reg(cg, i);
    i := i + 1;
  }
  cg_byte(cg, 44);
  cg_byte(cg, 126); cg_byte(cg, 123); cg_byte(cg, 114); cg_byte(cg, 99); cg_byte(cg, 120); cg_byte(cg, 125);
  cg_byte(cg, 44);
  cg_byte(cg, 126); cg_byte(cg, 123); cg_byte(cg, 114); cg_byte(cg, 49); cg_byte(cg, 49); cg_byte(cg, 125);
  cg_byte(cg, 44);
  cg_byte(cg, 126); cg_byte(cg, 123); cg_byte(cg, 109); cg_byte(cg, 101); cg_byte(cg, 109); cg_byte(cg, 111); cg_byte(cg, 114); cg_byte(cg, 121); cg_byte(cg, 125);
  cg_byte(cg, 34);
  cg_byte(cg, 40);
  cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32); cg_uint(cg, syscall_num);
  i := 0;
  while (i < n_args) {
    cg_piece(cg, 3);
    cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
    cur := (*args)[i];
    cg_operand(cg, cur);
    i := i + 1;
  }
  cg_byte(cg, 41);
  cg_piece(cg, 0);
  return Operand { is_reg := true, reg := r, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
}

// Emits a full `define` for a whitelisted `extern function`, backing
// its own name with a real raw-syscall implementation instead of the
// unresolvable `declare` gen_program falls back to for every other
// extern. A pointer parameter is `ptrtoint`'d to feed the syscall's own
// raw integer registers; a narrower-than-64-bit one is `zext`'d (see
// is_syscall_safe_type's own comment on why zext, never sext, is always
// correct here); an already-64-bit one needs no real conversion, but
// still gets a fresh `add i64 %pN, 0` so it has its own `%rN` register
// to hand to gen_raw_syscall (Operand's own reg field is always an
// `%rN`, never a `%pN`, so a bare parameter reference can't be handed
// through directly). The reverse (`inttoptr`) undoes the pointer
// conversion for a `*void`-returning syscall (`sys_mmap`/`sys_mremap`)
// on the way back out; `void`/64-bit-int returns need no conversion at
// all. Only ever called once its caller (gen_program) has already
// confirmed every parameter and the return type are all syscall-safe.
function gen_syscall_extern(cg: *Codegen, s: *Sema, file_idx: uint64, decl: *ASTNode, syscall_num: uint64) : void {
  mut param : *ASTNode := (*decl).first_child;
  mut pidx : uint64 := 0;
  mut args : Operand[6];
  mut n_args : uint64 := 0;
  mut ret_ty : *ASTNode := (*decl).data_type;
  mut a : uint64 := 0;
  mut rp : uint64 := 0;
  mut result : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut arg_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };

  cg_piece(cg, 4);
  cg_type(cg, s, file_idx, ret_ty);
  cg_byte(cg, 32);
  cg_byte(cg, 64);
  cg_slice(cg, &(*(*s).buffers)[file_idx].bytes, (*decl).tok.offset, (*decl).tok.length);
  cg_piece(cg, 24);
  param := (*decl).first_child;
  pidx := 0;
  while (param != null) {
    if (pidx > 0) { cg_piece(cg, 3); }
    cg_type(cg, s, file_idx, (*param).data_type);
    cg_byte(cg, 32);
    cg_param_ref(cg, pidx);
    param := (*param).next_sibling;
    pidx := pidx + 1;
  }
  cg_piece(cg, 25);
  cg_byte(cg, 32);
  cg_piece(cg, 22);
  cg_piece(cg, 20);

  param := (*decl).first_child;
  pidx := 0;
  n_args := 0;
  while (param != null) {
    if ((*(*param).data_type).kind == 121) {
      a := new_reg(cg);
      cg_piece(cg, 1); cg_reg_ref(cg, a); cg_piece(cg, 2);
      cg_piece(cg, 53); cg_piece(cg, 51); cg_byte(cg, 32); cg_param_ref(cg, pidx); cg_piece(cg, 54); cg_piece(cg, 0);
      arg_op := Operand { is_reg := true, reg := a, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
      args[n_args] := arg_op;
    } else {
      if (llvm_int_width((*(*param).data_type).tok.kind) == 64) {
        a := new_reg(cg);
        cg_piece(cg, 1); cg_reg_ref(cg, a); cg_piece(cg, 2);
        cg_piece(cg, 27); cg_byte(cg, 32);
        cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
        cg_param_ref(cg, pidx);
        cg_piece(cg, 3); cg_byte(cg, 48);
        cg_piece(cg, 0);
        arg_op := Operand { is_reg := true, reg := a, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
        args[n_args] := arg_op;
      } else {
        a := new_reg(cg);
        cg_piece(cg, 1); cg_reg_ref(cg, a); cg_piece(cg, 2);
        cg_piece(cg, 57);
        cg_type(cg, s, file_idx, (*param).data_type);
        cg_byte(cg, 32);
        cg_param_ref(cg, pidx);
        cg_piece(cg, 60);
        cg_byte(cg, 105); cg_uint(cg, 64);
        cg_piece(cg, 0);
        arg_op := Operand { is_reg := true, reg := a, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
        args[n_args] := arg_op;
      }
    }
    n_args := n_args + 1;
    param := (*param).next_sibling;
    pidx := pidx + 1;
  }

  result := gen_raw_syscall(cg, syscall_num, &args, n_args);

  if (is_void_type(ret_ty)) {
    cg_piece(cg, 1); cg_piece(cg, 11);
  } else {
    if ((*ret_ty).kind == 121) {
      rp := new_reg(cg);
      cg_piece(cg, 1); cg_reg_ref(cg, rp); cg_piece(cg, 2);
      cg_piece(cg, 55); cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32); cg_operand(cg, result); cg_piece(cg, 56); cg_piece(cg, 0);
      cg_piece(cg, 1); cg_piece(cg, 10); cg_type(cg, s, file_idx, ret_ty); cg_byte(cg, 32); cg_reg_ref(cg, rp); cg_piece(cg, 0);
    } else {
      cg_piece(cg, 1); cg_piece(cg, 10); cg_type(cg, s, file_idx, ret_ty); cg_byte(cg, 32); cg_operand(cg, result); cg_piece(cg, 0);
    }
  }
  cg_piece(cg, 23);
}

// Walks one file's already-declared+decorated top-level decls, emitting
// a real `define` (gen_syscall_extern) for every EXTERN_DECL whose name
// and whole signature exactly match one of the twelve whitelisted
// syscalls (syscall_number_for + is_syscall_safe_type on every
// param/the return type), a bare `declare` for any other EXTERN_DECL,
// and `define` for every FUNCTION_DECL whose entire signature -- and
// every top-level body-local declaration too -- is supported (decl_is_
// supported, above: scalar, struct, array, and pointer-to-any-of-those
// types, per is_supported_value_type). What's still out of scope here
// is expression-level, not signature-level -- a struct/array LITERAL
// (STRUCT_LIT/ARRAY_LIT) still sets had_error the moment gen_expr
// actually reaches an unsupported shape, exactly like sizeof/lengthof's
// own struct-name case already does for an unresolvable type.
function gen_program(cg: *Codegen, s: *Sema, program: *ASTNode, file_idx: uint64) : void {
  mut child : *ASTNode := (*program).first_child;
  mut param : *ASTNode := null;
  mut pidx : uint64 := 0;
  mut lr : LookupResult := LookupResult { found := false, index := 0 };
  mut safe : bool := false;
  mut pcount : uint64 := 0;

  while (child != null) {
    if ((*child).kind == 112 && decl_is_supported(child)) {
      lr := syscall_number_for(s, file_idx, child);
      safe := lr.found;
      param := (*child).first_child;
      pcount := 0;
      while (safe && param != null) {
        if (!is_syscall_safe_type((*param).data_type)) { safe := false; }
        pcount := pcount + 1;
        param := (*param).next_sibling;
      }
      if (pcount > 6) { safe := false; }
      if (safe && !(is_void_type((*child).data_type) || is_syscall_safe_type((*child).data_type))) {
        safe := false;
      }
      if (safe) {
        gen_syscall_extern(cg, s, file_idx, child, lr.index);
      } else {
        cg_piece(cg, 5);
        cg_type(cg, s, file_idx, (*child).data_type);
        cg_byte(cg, 32);
        cg_byte(cg, 64);
        cg_slice(cg, &(*(*s).buffers)[file_idx].bytes, (*child).tok.offset, (*child).tok.length);
        cg_piece(cg, 24);
        param := (*child).first_child;
        pidx := 0;
        while (param != null) {
          if (pidx > 0) { cg_piece(cg, 3); }
          cg_type(cg, s, file_idx, (*param).data_type);
          param := (*param).next_sibling;
          pidx := pidx + 1;
        }
        cg_piece(cg, 25);
        cg_piece(cg, 0);
      }
    } else {
      if ((*child).kind == 113 && decl_is_supported(child)) {
        gen_function(cg, s, child, file_idx);
      }
      // OPERATOR_DECL (162, v1.1.6): shaped exactly like FUNCTION_DECL
      // (Sema's own decorate_program header comment) -- gen_function
      // already needs no separate operator-aware variant either, beyond
      // its own name-emission branch.
      if ((*child).kind == 162 && decl_is_supported(child)) {
        gen_function(cg, s, child, file_idx);
      }
    }
    child := (*child).next_sibling;
  }
}

// `_start`'s own raw-stack-read for the two-parameter `main(argv,
// argc)` form (v1.1.n, postulate_v1_language_reference.md SS6.3) --
// four small, `_start`-only helpers, not generalized further since
// nothing else in this file ever needs to read a raw `i64` address or
// convert one this way.
//
// `movq %rsp, $0` has to be the ABSOLUTE FIRST instruction `_start`
// ever executes -- the kernel hands the process its own initial
// `argc`/`argv`/`envp` laid out ON THE STACK, at whatever `rsp` is at
// the very moment control reaches `_start`, with no register or ABI
// path to recover it once even ONE more instruction has touched `rsp`.
// Confirmed the hard way: an ordinary (non-`naked`) `define void @
// _start() { ... }` had `llc` insert a stray `pushq %rax` BEFORE this
// exact inline-asm line (`_start` isn't recognized as special --
// nothing here tells `llc` this function has no real caller/return, so
// it silently applied its own ordinary stack-alignment prologue logic,
// shifting `rsp` by 8 bytes before this code ever got a chance to read
// it). The `naked` function attribute (gen_start's own definition,
// below) suppresses ALL of that -- confirmed empirically, byte for
// byte, against `llc`'s own disassembly, and then end to end with a
// real compiled-and-linked binary invoked with real command-line
// arguments (`argc`/`argv[0]` read back out and written to stdout,
// matching the actual invocation exactly, both with and without extra
// arguments). Safe per the SysV ABI's own documented guarantee that
// the kernel's initial `rsp` is ALREADY 16-byte aligned at process
// entry -- exactly the alignment an ordinary `call` instruction
// expects immediately before it, so a `naked` `_start` calling `main`
// with zero intervening stack traffic needs no alignment fixup of its
// own either.
function gen_read_rsp(cg: *Codegen) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_piece(cg, 16);
  cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
  cg_byte(cg, 97); cg_byte(cg, 115); cg_byte(cg, 109); cg_byte(cg, 32);
  cg_byte(cg, 115); cg_byte(cg, 105); cg_byte(cg, 100); cg_byte(cg, 101); cg_byte(cg, 101); cg_byte(cg, 102); cg_byte(cg, 102); cg_byte(cg, 101); cg_byte(cg, 99); cg_byte(cg, 116); cg_byte(cg, 32);
  cg_byte(cg, 34);
  cg_byte(cg, 109); cg_byte(cg, 111); cg_byte(cg, 118); cg_byte(cg, 113); cg_byte(cg, 32);
  cg_byte(cg, 37); cg_byte(cg, 114); cg_byte(cg, 115); cg_byte(cg, 112);
  cg_byte(cg, 44); cg_byte(cg, 32);
  cg_byte(cg, 36); cg_byte(cg, 48);
  cg_byte(cg, 34);
  cg_piece(cg, 3);
  cg_byte(cg, 34); cg_byte(cg, 61); cg_byte(cg, 114); cg_byte(cg, 34);
  cg_byte(cg, 40); cg_byte(cg, 41);
  cg_piece(cg, 0);
  return reg_op(r);
}

function gen_inttoptr_i64(cg: *Codegen, op: Operand) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_byte(cg, 105); cg_byte(cg, 110); cg_byte(cg, 116); cg_byte(cg, 116); cg_byte(cg, 111); cg_byte(cg, 112); cg_byte(cg, 116); cg_byte(cg, 114); cg_byte(cg, 32);
  cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
  cg_operand(cg, op);
  cg_piece(cg, 60);
  cg_piece(cg, 51);
  cg_piece(cg, 0);
  return reg_op(r);
}

function gen_load_i64(cg: *Codegen, ptr_op: Operand) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_piece(cg, 7);
  cg_byte(cg, 105); cg_uint(cg, 64);
  cg_piece(cg, 8);
  cg_operand(cg, ptr_op);
  cg_piece(cg, 0);
  return reg_op(r);
}

function gen_trunc_i64_to_i16(cg: *Codegen, op: Operand) : Operand {
  mut r : uint64 := new_reg(cg);
  cg_piece(cg, 1); cg_reg_ref(cg, r); cg_piece(cg, 2);
  cg_piece(cg, 59);
  cg_byte(cg, 105); cg_uint(cg, 64); cg_byte(cg, 32);
  cg_operand(cg, op);
  cg_piece(cg, 60);
  cg_byte(cg, 105); cg_uint(cg, 16);
  cg_piece(cg, 0);
  return reg_op(r);
}

// Emits `_start`, the process's real ELF entry point, for whichever
// file declares `main` -- found by walking each file's own top-level
// FUNCTION_DECLs for the literal name (Module 3 doesn't yet enforce
// v1's own "exactly one `main`, in `\Main`" rule, reference SS6.3, so
// this walks every file via main()'s own per-file loop below and stops
// at the first match; a well-formed program only ever has one).
// `_start` is always `naked` now (gen_read_rsp's own header comment
// covers why) -- harmless for the zero-parameter form too (an ordinary
// `call` needs no more stack setup than a `naked` entry already
// provides, per the same SysV alignment guarantee), so there's exactly
// one code shape rather than two. Calls `@main` with no arguments, or
// with `(argv: **char, argc: uint16)` read directly off `_start`'s own
// pristine initial stack -- Sema's own `main_params_valid` guarantees
// `main_decl`'s param list is always one of exactly these two shapes
// by the time this runs, nothing else to branch on. Coerces the return
// value (`void` or any atomic type, SS6.3) to the raw `i64` an exit-
// code register needs -- a pointer via `ptrtoint`, a narrower-than-
// 64-bit value via `zext` unconditionally (the exit syscall's own
// observable code only depends on the low 8 bits regardless, so this
// doesn't need to branch on `main`'s own signedness), `void` as a
// literal `0` -- then terminates the WHOLE process via `sys_exit_
// group` (231), not `sys_exit` (60), which only ends the calling
// thread and would leave any other still-running thread (started via
// `sys_clone`) alive. `unreachable` afterward, since the syscall
// itself never returns. Returns whether it found (and therefore
// emitted) `main` in THIS file, so main()'s own driver loop knows to
// stop trying further files.
function gen_start(cg: *Codegen, s: *Sema, program: *ASTNode, file_idx: uint64) : bool {
  mut child : *ASTNode := (*program).first_child;
  mut main_decl : *ASTNode := null;
  mut buf : *DynBytes := &(*(*s).buffers)[file_idx].bytes;
  mut o : uint64 := 0;
  mut call_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut code_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut ret_ty : *ASTNode := null;
  mut a : uint64 := 0;
  mut args : Operand[6];
  mut discard_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut has_args : bool := false;
  mut rsp_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut argv_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  mut argc_op : Operand := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };

  while (child != null) {
    if ((*child).kind == 113 && (*child).tok.length == 4) {
      o := (*child).tok.offset;
      if ((*buf).ptr[o+0]==109 && (*buf).ptr[o+1]==97 && (*buf).ptr[o+2]==105 && (*buf).ptr[o+3]==110) {
        main_decl := child;
      }
    }
    child := (*child).next_sibling;
  }
  if (main_decl == null) { return false; }
  has_args := (*main_decl).first_child != null;

  cg_piece(cg, 4);
  cg_piece(cg, 26);
  cg_byte(cg, 32); cg_byte(cg, 64);
  cg_byte(cg, 95); cg_byte(cg, 115); cg_byte(cg, 116); cg_byte(cg, 97); cg_byte(cg, 114); cg_byte(cg, 116);
  cg_piece(cg, 24); cg_piece(cg, 25);
  cg_byte(cg, 32); cg_byte(cg, 110); cg_byte(cg, 97); cg_byte(cg, 107); cg_byte(cg, 101); cg_byte(cg, 100);
  cg_byte(cg, 32); cg_piece(cg, 22);
  cg_piece(cg, 20);

  if (has_args) {
    rsp_op := gen_read_rsp(cg);
    argv_op := gen_inttoptr_i64(cg, gen_i64_binop(cg, 85, false, rsp_op, i64_imm(8)));
    argc_op := gen_trunc_i64_to_i16(cg, gen_load_i64(cg, gen_inttoptr_i64(cg, rsp_op)));
  }

  ret_ty := (*main_decl).data_type;
  if (is_void_type(ret_ty)) {
    cg_piece(cg, 1); cg_piece(cg, 16); cg_piece(cg, 26);
    cg_byte(cg, 32); cg_byte(cg, 64);
    cg_byte(cg, 109); cg_byte(cg, 97); cg_byte(cg, 105); cg_byte(cg, 110);
    cg_piece(cg, 24);
    if (has_args) {
      cg_piece(cg, 51); cg_byte(cg, 32); cg_operand(cg, argv_op);
      cg_piece(cg, 3); cg_byte(cg, 105); cg_uint(cg, 16); cg_byte(cg, 32); cg_operand(cg, argc_op);
    }
    cg_piece(cg, 25); cg_piece(cg, 0);
    code_op := Operand { is_reg := false, reg := 0, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
  } else {
    a := new_reg(cg);
    cg_piece(cg, 1); cg_reg_ref(cg, a); cg_piece(cg, 2);
    cg_piece(cg, 16);
    cg_type(cg, s, file_idx, ret_ty);
    cg_byte(cg, 32); cg_byte(cg, 64);
    cg_byte(cg, 109); cg_byte(cg, 97); cg_byte(cg, 105); cg_byte(cg, 110);
    cg_piece(cg, 24);
    if (has_args) {
      cg_piece(cg, 51); cg_byte(cg, 32); cg_operand(cg, argv_op);
      cg_piece(cg, 3); cg_byte(cg, 105); cg_uint(cg, 16); cg_byte(cg, 32); cg_operand(cg, argc_op);
    }
    cg_piece(cg, 25); cg_piece(cg, 0);
    call_op := Operand { is_reg := true, reg := a, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };

    if ((*ret_ty).kind == 121) {
      a := new_reg(cg);
      cg_piece(cg, 1); cg_reg_ref(cg, a); cg_piece(cg, 2);
      cg_piece(cg, 53); cg_piece(cg, 51); cg_byte(cg, 32); cg_operand(cg, call_op); cg_piece(cg, 54); cg_piece(cg, 0);
      code_op := Operand { is_reg := true, reg := a, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
    } else {
      if (llvm_int_width((*ret_ty).tok.kind) == 64) {
        code_op := call_op;
      } else {
        a := new_reg(cg);
        cg_piece(cg, 1); cg_reg_ref(cg, a); cg_piece(cg, 2);
        cg_piece(cg, 57);
        cg_type(cg, s, file_idx, ret_ty);
        cg_byte(cg, 32); cg_operand(cg, call_op);
        cg_piece(cg, 60); cg_byte(cg, 105); cg_uint(cg, 64);
        cg_piece(cg, 0);
        code_op := Operand { is_reg := true, reg := a, imm := 0, is_null := false, is_float_imm := false, float_bits := 0 };
      }
    }
  }

  args[0] := code_op;
  discard_op := gen_raw_syscall(cg, 231, &args, 1);
  cg_piece(cg, 1); cg_piece(cg, 21);
  cg_piece(cg, 23);
  return true;
}
