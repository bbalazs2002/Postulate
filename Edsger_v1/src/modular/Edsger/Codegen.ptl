namespace \Edsger\Codegen;
use \Edsger\Lexer;
use \Edsger\Parser;
use \Edsger\Sema;
use \Edsger\Dynamic;


// =======================================================================
// Module 4: Codegen (postulate_stage1_v1_0_6_edsger_design.md's own
// Module 4 section) -- emits LLVM IR text from the decorated tree.
// FIRST SLICE ONLY (this session's own agreed scope, mirroring how
// `v1.0.2` itself was scalar-only before `v1.0.3` added composites):
// functions/externs whose entire signature (every param, the return
// type) is a scalar type -- any of the 8 integer types, `bool`, or
// `char` -- with arithmetic/bitwise/comparison/logical expressions,
// `if`/`while`, `return`, and calls between two such user functions.
//
// Explicitly NOT attempted here, each its own later increment:
// structs, arrays, pointers (so no extern call either, since every
// extern this codebase's own source ever declares takes a pointer
// argument), `as` casts, `sizeof`/`lengthof`. A declaration whose
// signature isn't fully scalar is simply skipped (decl_is_scalar_
// only) rather than attempted and failed.
//
// One stack slot (`alloca`) per local, a `load` before every read and
// a `store` after every write, no manual SSA -- postulate_stage1_
// bootstrap_plan.md SS2's own "what `clang -O0` does," left for
// `opt`'s `mem2reg` (`v1.1.2`) to promote once optimization exists.
// Every value Module 3 already resolved a `data_type` for is read
// straight off that node here -- codegen never re-infers a type.
// =======================================================================

struct Codegen {
  out : *DynBytes;
  pos : uint64;
  reg : uint64;     // next unused %rN
  label : uint64;    // next unused LN
  had_error : bool;  // set (never fatal on its own) when something
                     // outside this slice's scope was reached anyway

  // v1.1.2: BREAK_STMT/CONTINUE_STMT jump targets for whatever WHILE_STMT
  // bodies currently enclose the statement being generated -- pushed/
  // popped around gen_stmt's own WHILE_STMT case, mirroring Sema's own
  // Scope.loop_depth (postulate_stage1_bootstrap_plan.md's Scope struct
  // comment) but kept here instead, since this is purely a codegen-time
  // jump-target stack, not a legality check (that's already Sema's job).
  // Reset to 0 at the start of every gen_function call; fixed depth-64
  // capacity matches every other small fixed-size stack used throughout
  // this file (e.g. gen_stmt's own pair_slots/pair_ops).
  loop_break : uint64[64];
  loop_continue : uint64[64];
  loop_top : uint64;
}

// A computed value: either a register already holding it, or (for a
// bare int/bool literal) its own immediate value, spelled directly as
// an operand wherever LLVM IR accepts one -- literals never need their
// own `alloca`/register at all, exactly like `clang` itself never
// bothers materializing a constant into a register before using it.
struct Operand {
  is_reg : bool;
  reg : uint64;
  imm : int64;

  // `null` (NULL_LIT) is neither a register nor a printable integer --
  // LLVM IR's own literal spelling for a null pointer constant is the
  // keyword `null`, never a numeric `0` (pointers and integers are
  // different types at the text-syntax level, no implicit conversion
  // between them). Checked before `is_reg` in cg_operand.
  is_null : bool;
}

// Every fixed IR text fragment used anywhere below, dispatched by
// number -- same shape as Stage1/src/codegen.ptl's own `emit_piece`,
// reused here for the same reason: v0 has no global/static data, so a
// script of small local `uint8[100]` constants declared fresh on each
// call (like lex_next's own small lookup tables) is the idiomatic way
// to give many call sites access to the same fixed strings without
// duplicating each one at every site that needs it.
