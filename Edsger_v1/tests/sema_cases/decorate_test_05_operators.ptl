namespace \Main;

function main() : int32 {
  mut x : int64 := 1;
  mut y : int64 := x + 5;
  mut p : *int32 := null;
  mut q : *int32 := p + 1;
  mut r : *int32 := 1 + p;
  mut t : *int32 := p - 1;
  mut p2 : *int32 := null;
  mut d : int64 := p - p2;
  mut pl : *int64 := null;
  mut cmp1 : bool := p == pl;
  mut c : char := 'a';
  mut cmp2 : bool := c == 97 as char;
