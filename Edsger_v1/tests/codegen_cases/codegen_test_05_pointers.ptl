namespace \Main;

function increment(p: *int32) : void {
  *p := *p + 1;
  return;
}

function addressOf() : int32 {
  mut x : int32 := 5;
  mut p : *int32 := &x;
  increment(p);
  return *p;
}

function ptrArith(base: *int32) : *int32 {
  mut q : *int32 := base + 3;
  q := q - 1;
  return q;
}

function ptrDiff(a: *int32, b: *int32) : int64 {
  return a - b;
}

function ptrCmp(a: *int32, b: *int32) : bool {
  return a < b;
}

function nullCheck(p: *int32) : bool {
  return p == null;
}

function main() : int32 {
  return addressOf();
}
