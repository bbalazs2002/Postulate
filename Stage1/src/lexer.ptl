// Postulate Stage 1 -- lexer, phase 1 of the self-hosting bootstrap
// compiler (see Stage1/README.md). Written in Postulate v0 itself,
// compiled by Hoare (Stage 0), and defines the exact same v0 lexical
// grammar Hoare's own hand-written src/lexer.asm defines -- see
// docs/postulate_stage0_lexer_spec.md, which this file follows chapter
// by chapter.
//
// I/O model matches Hoare's own lexer binary exactly (chapter 8 there):
// reads the whole source program from stdin, writes one line per token
// to stdout in the same dump format (chapter 9), and on a lexical error
// writes a diagnostic to stderr and exits with the matching exit code
// (chapter 7). This lets Hoare/tests/cases/*.ptl -- with their
// .expected.stdout/.expected.stderr/.expected.exit fixtures -- serve as
// this lexer's own test suite unchanged: both lexers must accept
// exactly the same language and print exactly the same token stream.
//
// Token-kind encoding matches tokens.inc exactly (not required for
// correctness -- only the printed dump format is observable -- but
// convenient, since the spec already tabulates it): 0-2 special,
// 10-33 keywords, 40-49 punctuation, 60-79 operators, 253-254 errors.
//
// Fixed buffer sizes: this lexer reads into a *stack-local* array
// (v0 has no static/global storage, see README.md), not the 1 MiB
// .bss buffer Hoare's own binary uses -- 64 KiB source / 128 KiB
// output, generous for a bootstrap-stage source file while keeping the
// stack frame modest. A source program that doesn't fit is reported as
// an I/O error (exit 2), matching Hoare's own "buffer too small"
// convention (chapter 8.2 there).

extern function sys_read(fd: int64, buf: *uint8, count: uint64) : int64;
extern function sys_write(fd: int64, buf: *uint8, count: uint64) : int64;
extern function sys_exit(code: int64) : void;
extern function sys_openat(dirfd: int64, path: *uint8, flags: int64, mode: int64) : int64;
extern function sys_close(fd: int64) : int64;

struct Token {
  kind : int32;
  offset : uint64;
  length : uint64;
  value : int64;
}

struct TriviaResult {
  cursor : uint64;
  had_error : bool;
  comment_start : uint64;
}

struct NumberResult {
  cursor : uint64;
  had_error : bool;
  error_at : uint64;
}

struct LexOutcome {
  tok : Token;
  cursor : uint64;
}

struct LineCol {
  line : uint64;
  col : uint64;
}

// ---------------------------------------------------------------------
// `#include` resolution (v1.0.1, docs/postulate_stage1_v1_0_1_include_
// design.md) -- runs before tokenization, replacing "read stdin into
// src_buf" with a three-phase (discover/order/emit) pass over a shared
// FileTable. Every array below is a flat, parallel-scalar-array shape
// (see the design doc's "Data structures") -- v0 has no struct-typed
// arrays and no composite values crossing a call boundary, so a
// FileTable "struct" is really thirteen pointer fields sharing an
// index, not an actual array of structs.
//
// The entry file (index 0) is the one exception to "every file is
// opened by path": there is no argv in v0 until v1.0.11, so main()
// still has no way to learn its own path. Its own #include targets
// therefore resolve relative to the process's cwd, not to wherever the
// entry file physically lives -- documented, deliberate, see the design
// doc's "Path resolution". Its own content still comes from stdin, as
// today; every other file is opened via sys_openat/sys_read/sys_close.
// ---------------------------------------------------------------------

struct FileTable {
  file_path_off : *(uint64[64]);
  file_path_len : *(uint64[64]);
  file_content_off : *(uint64[64]);
  file_content_len : *(uint64[64]);
  file_body_off : *(uint64[64]);
  file_body_line : *(uint64[64]);
  file_dep_start : *(uint64[64]);
  file_dep_count : *(uint64[64]);
  file_indegree : *(uint64[64]);
  file_emit_pos : *(uint64[64]);
  dep_pool : *(uint64[256]);
  order : *(uint64[64]);
  path_pool : *(uint8[16384]);
  source_pool : *(uint8[1048576]);
}

// err_kind: 0 none, 1 cannot-open, 2 io/too-big, 3 malformed directive,
// 4 preamble violation, 5 cycle, 6 path too long, 7 table/pool full,
// 8 unterminated block comment in a preamble.
struct ResolveState {
  file_count : uint64;
  dep_next : uint64;
  path_pool_next : uint64;
  source_pool_next : uint64;
  order_count : uint64;
  had_error : bool;
  err_kind : int32;
  err_file : uint64;
  err_off : uint64;
}

struct DirectiveResult {
  ok : bool;
  path_off : uint64;
  path_len : uint64;
  cursor : uint64;
}

struct ResolvedPath {
  len : uint64;
  too_long : bool;
}

struct FileLine {
  file : uint64;
  line : uint64;
  col : uint64;
  byte_off : uint64;
}

function is_hspace(b: uint8) : bool {
  return b == 32 || b == 9;
}

// path_pool[pool_off..pool_off+pool_len) == cand[0..cand_len)?
function path_matches(pool: *(uint8[16384]), pool_off: uint64, pool_len: uint64, cand: *(uint8[256]), cand_len: uint64) : bool {
  mut result : bool := true;
  mut i : uint64 := 0;
  if (pool_len != cand_len) {
    result := false;
  } else {
    while (i < cand_len) {
      if ((*pool)[pool_off + i] != (*cand)[i]) {
        result := false;
      }
      i := i + 1;
    }
  }
  return result;
}

// Linear scan over the known files' own resolved paths -- returns
// file_count (a value no real index ever equals) as the "not found"
// sentinel, exactly like list_pool-style code elsewhere in this
// session uses an out-of-range index for "no match".
function find_known_file(ft: FileTable, file_count: uint64, cand: *(uint8[256]), cand_len: uint64) : uint64 {
  mut i : uint64 := 0;
  mut result : uint64 := file_count;
  mut found : bool := false;
  while (i < file_count) {
    if (!found) {
      if (path_matches(ft.path_pool, (*ft.file_path_off)[i], (*ft.file_path_len)[i], cand, cand_len)) {
        result := i;
        found := true;
      }
    }
    i := i + 1;
  }
  return result;
}

// Copies pool[off..off+len)'s own directory prefix (everything up to
// and including its last '/', or nothing if it has none) into out.
// Returns the copied length.
function extract_dir(pool: *(uint8[16384]), off: uint64, len: uint64, out: *(uint8[256])) : uint64 {
  mut i : uint64 := 0;
  mut last_slash_rel : uint64 := 0;
  mut found : bool := false;
  mut j : uint64 := 0;
  mut result : uint64 := 0;

  while (i < len) {
    if ((*pool)[off + i] == 47) {
      last_slash_rel := i;
      found := true;
    }
    i := i + 1;
  }

  if (found) {
    j := 0;
    while (j <= last_slash_rel) {
      (*out)[j] := (*pool)[off + j];
      j := j + 1;
    }
    result := last_slash_rel + 1;
  }

  return result;
}

function append_source_to_scratch(out: *(uint8[256]), pos: uint64, src: *(uint8[1048576]), off: uint64, ln: uint64) : uint64 {
  mut i : uint64 := 0;
  mut new_pos : uint64 := pos;
  while (i < ln) {
    (*out)[new_pos] := (*src)[off + i];
    new_pos := new_pos + 1;
    i := i + 1;
  }
  return new_pos;
}

function copy_scratch_to_pool(pool: *(uint8[16384]), pos: uint64, s: *(uint8[256]), s_len: uint64) : void {
  mut i : uint64 := 0;
  while (i < s_len) {
    (*pool)[pos + i] := (*s)[i];
    i := i + 1;
  }
  return;
}

// Collapses "./" and "dir/../" segments out of raw[0..raw_len) into
// out, by keeping a stack of (start,len) spans for the segments seen
// so far and popping one on "..". Never grows the input, so out's own
// 256-byte capacity is already guaranteed by raw's.
function normalize_path(raw: *(uint8[256]), raw_len: uint64, out: *(uint8[256])) : uint64 {
  mut seg_start : uint64[64] := 0;
  mut seg_len : uint64[64] := 0;
  mut seg_count : uint64 := 0;
  mut i : uint64 := 0;
  mut seg_from : uint64 := 0;
  mut this_len : uint64 := 0;
  mut is_dot : bool := false;
  mut is_dotdot : bool := false;
  mut out_pos : uint64 := 0;
  mut k : uint64 := 0;
  mut s : uint64 := 0;

  while (i <= raw_len) {
    if (i == raw_len || (*raw)[i] == 47) {
      this_len := i - seg_from;
      if (this_len > 0) {
        is_dot := this_len == 1 && (*raw)[seg_from] == 46;
        is_dotdot := this_len == 2 && (*raw)[seg_from] == 46 && (*raw)[seg_from + 1] == 46;
        if (is_dotdot) {
          if (seg_count > 0) {
            seg_count := seg_count - 1;
          }
        } else {
          if (!is_dot) {
            seg_start[seg_count] := seg_from;
            seg_len[seg_count] := this_len;
            seg_count := seg_count + 1;
          }
        }
      }
      seg_from := i + 1;
    }
    i := i + 1;
  }

  k := 0;
  while (k < seg_count) {
    if (k > 0) {
      (*out)[out_pos] := 47;
      out_pos := out_pos + 1;
    }
    s := 0;
    while (s < seg_len[k]) {
      (*out)[out_pos] := (*raw)[seg_start[k] + s];
      out_pos := out_pos + 1;
      s := s + 1;
    }
    k := k + 1;
  }

  return out_pos;
}

// Resolves a directive's raw path_text (a span in source_pool) against
// base_file's own directory, lexically -- see "Path resolution" in the
// design doc. Capped so the result always leaves room for a NUL
// terminator in the 256-byte scratch buffers callers pass around.
function resolve_include_path(ft: FileTable, base_file: uint64, rel_off: uint64, rel_len: uint64, out: *(uint8[256])) : ResolvedPath {
  mut raw : uint8[256] := 0;
  mut dir_len : uint64 := 0;
  mut raw_len : uint64 := 0;
  mut result : ResolvedPath := ResolvedPath { len := 0, too_long := false };

  dir_len := extract_dir(ft.path_pool, (*ft.file_path_off)[base_file], (*ft.file_path_len)[base_file], &raw);
  if (dir_len + rel_len >= 256) {
    result := ResolvedPath { len := 0, too_long := true };
  } else {
    raw_len := append_source_to_scratch(&raw, dir_len, ft.source_pool, rel_off, rel_len);
    result := ResolvedPath { len := normalize_path(&raw, raw_len, out), too_long := false };
  }
  return result;
}

function matches_include_kw(src: *(uint8[1048576]), off: uint64, end: uint64) : bool {
  mut result : bool := false;
  if (off + 7 <= end) {
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 99 && (*src)[off + 3] == 108 && (*src)[off + 4] == 117 && (*src)[off + 5] == 100 && (*src)[off + 6] == 101) {
      result := true;
    }
  }
  return result;
}

// Parses everything after "#include" itself: mandatory space(s), a
// quoted path, optional space(s)/tab(s), and a mandatory ';' -- see
// "Comment-awareness and the preamble boundary"'s IN_DIRECTIVE bullet.
// `start` is the position right after the 'e' of "include".
function parse_directive_body(src: *(uint8[1048576]), start: uint64, len: uint64) : DirectiveResult {
  mut cursor : uint64 := start;
  mut saw_space : bool := false;
  mut path_off : uint64 := 0;
  mut path_len : uint64 := 0;
  mut failed : bool := false;
  mut result : DirectiveResult := DirectiveResult { ok := false, path_off := 0, path_len := 0, cursor := start };

  while (cursor < len && is_hspace((*src)[cursor])) {
    saw_space := true;
    cursor := cursor + 1;
  }
  if (!saw_space) {
    failed := true;
  }

  if (!failed) {
    if (cursor < len && (*src)[cursor] == 34) {
      cursor := cursor + 1;
      path_off := cursor;
      while (cursor < len && (*src)[cursor] != 34) {
        cursor := cursor + 1;
      }
      if (cursor >= len) {
        failed := true;
      } else {
        path_len := cursor - path_off;
        cursor := cursor + 1;
      }
    } else {
      failed := true;
    }
  }

  if (!failed) {
    while (cursor < len && is_hspace((*src)[cursor])) {
      cursor := cursor + 1;
    }
    if (cursor < len && (*src)[cursor] == 59) {
      cursor := cursor + 1;
    } else {
      failed := true;
    }
  }

  if (!failed) {
    result := DirectiveResult { ok := true, path_off := path_off, path_len := path_len, cursor := cursor };
  } else {
    result := DirectiveResult { ok := false, path_off := 0, path_len := 0, cursor := cursor };
  }
  return result;
}

// Scans file i's own content span once (comment-aware, four states:
// NORMAL folded into the outer dispatch below, LINE_COMMENT=1,
// BLOCK_COMMENT=2; IN_DIRECTIVE is parse_directive_body's own
// sequential sub-parse rather than a per-byte state, see its header).
// Registers every #include target it finds (resolving + look-up/
// allocate against the file table) and, on a clean finish, records
// file_body_off/line/dep_start/dep_count/indegree for file i.
function scan_file(ft: FileTable, rs: ResolveState, i: uint64) : ResolveState {
  mut content_off : uint64 := (*ft.file_content_off)[i];
  mut content_len : uint64 := (*ft.file_content_len)[i];
  mut cursor : uint64 := content_off;
  mut end : uint64 := content_off + content_len;
  mut state : int32 := 0;
  mut seen_body : bool := false;
  mut body_off : uint64 := end;
  mut body_line : uint64 := 1;
  mut line : uint64 := 1;
  mut looping : bool := true;
  mut b : uint8 := 0;
  mut dr : DirectiveResult := DirectiveResult { ok := false, path_off := 0, path_len := 0, cursor := 0 };
  mut rp : ResolvedPath := ResolvedPath { len := 0, too_long := false };
  mut resolved : uint8[256] := 0;
  mut found_idx : uint64 := 0;
  mut new_state : ResolveState := rs;
  mut dep_start_here : uint64 := rs.dep_next;
  mut block_comment_start : uint64 := 0;

  while (looping) {
    if (cursor >= end) {
      if (state == 2 && !seen_body) {
        // Only a genuine preamble comment is this pass's problem to
        // report -- an unterminated comment that starts after the body
        // began is left for the tokenizer's own skip_trivia to catch
        // natively (same message it always used), since that whole
        // span is copied into the body verbatim either way.
        new_state.had_error := true;
        new_state.err_kind := 8;
        new_state.err_file := i;
        new_state.err_off := block_comment_start;
      }
      looping := false;
    } else {
      b := (*ft.source_pool)[cursor];
      if (state == 1) {
        if (b == 10) {
          line := line + 1;
          state := 0;
        }
        cursor := cursor + 1;
      } else {
        if (state == 2) {
          if (b == 10) {
            line := line + 1;
          }
          if (b == 42 && cursor + 1 < end && (*ft.source_pool)[cursor + 1] == 47) {
            cursor := cursor + 2;
            state := 0;
          } else {
            cursor := cursor + 1;
          }
        } else {
          if (b == 47 && cursor + 1 < end && (*ft.source_pool)[cursor + 1] == 47) {
            state := 1;
            cursor := cursor + 2;
          } else {
            if (b == 47 && cursor + 1 < end && (*ft.source_pool)[cursor + 1] == 42) {
              block_comment_start := cursor;
              state := 2;
              cursor := cursor + 2;
            } else {
              if (b == 35) {
                if (seen_body) {
                  new_state.had_error := true;
                  new_state.err_kind := 4;
                  new_state.err_file := i;
                  new_state.err_off := cursor;
                  looping := false;
                } else {
                  if (!matches_include_kw(ft.source_pool, cursor + 1, end)) {
                    new_state.had_error := true;
                    new_state.err_kind := 3;
                    new_state.err_file := i;
                    new_state.err_off := cursor;
                    looping := false;
                  } else {
                    dr := parse_directive_body(ft.source_pool, cursor + 8, end);
                    if (!dr.ok) {
                      new_state.had_error := true;
                      new_state.err_kind := 3;
                      new_state.err_file := i;
                      new_state.err_off := cursor;
                      looping := false;
                    } else {
                      rp := resolve_include_path(ft, i, dr.path_off, dr.path_len, &resolved);
                      if (rp.too_long) {
                        new_state.had_error := true;
                        new_state.err_kind := 6;
                        new_state.err_file := i;
                        new_state.err_off := cursor;
                        looping := false;
                      } else {
                        found_idx := find_known_file(ft, new_state.file_count, &resolved, rp.len);
                        if (found_idx == new_state.file_count) {
                          if (new_state.file_count >= 64 || new_state.path_pool_next + rp.len >= 16384) {
                            new_state.had_error := true;
                            new_state.err_kind := 7;
                            new_state.err_file := i;
                            new_state.err_off := cursor;
                            looping := false;
                          } else {
                            copy_scratch_to_pool(ft.path_pool, new_state.path_pool_next, &resolved, rp.len);
                            (*ft.file_path_off)[found_idx] := new_state.path_pool_next;
                            (*ft.file_path_len)[found_idx] := rp.len;
                            new_state.path_pool_next := new_state.path_pool_next + rp.len;
                            new_state.file_count := new_state.file_count + 1;
                          }
                        }
                        if (!new_state.had_error) {
                          if (new_state.dep_next >= 256) {
                            new_state.had_error := true;
                            new_state.err_kind := 7;
                            new_state.err_file := i;
                            new_state.err_off := cursor;
                            looping := false;
                          } else {
                            (*ft.dep_pool)[new_state.dep_next] := found_idx;
                            new_state.dep_next := new_state.dep_next + 1;
                            cursor := dr.cursor;
                          }
                        }
                      }
                    }
                  }
                }
              } else {
                if (is_ws(b)) {
                  if (b == 10) {
                    line := line + 1;
                  }
                  cursor := cursor + 1;
                } else {
                  if (!seen_body) {
                    body_off := cursor;
                    body_line := line;
                    seen_body := true;
                  }
                  cursor := cursor + 1;
                }
              }
            }
          }
        }
      }
    }
  }

  if (!new_state.had_error) {
    (*ft.file_body_off)[i] := body_off;
    (*ft.file_body_line)[i] := body_line;
    (*ft.file_dep_start)[i] := dep_start_here;
    (*ft.file_dep_count)[i] := new_state.dep_next - dep_start_here;
    (*ft.file_indegree)[i] := new_state.dep_next - dep_start_here;
  }

  return new_state;
}

// Phase 1 (Discover), "queue of file-indices" realized as a plain
// growing-bound loop: new files are only ever appended at file_count
// (never inserted), and are processed in that same ascending order, so
// `while (i < file_count) { ...; i := i + 1; }` already gives FIFO
// order without a separate queue array -- see the design doc's own
// aside on this in "Resolution algorithm".
function run_discover(ft: FileTable, rs: ResolveState) : ResolveState {
  mut new_state : ResolveState := rs;
  mut i : uint64 := 0;
  mut fd : int64 := 0;
  mut n : int64 := 0;
  mut reading : bool := true;
  mut open_buf : uint8[256] := 0;
  mut path_len : uint64 := 0;
  mut j : uint64 := 0;
  mut off : uint64 := 0;

  while (i < new_state.file_count && !new_state.had_error) {
    off := new_state.source_pool_next;
    reading := true;

    if (i == 0) {
      while (reading) {
        if (new_state.source_pool_next >= 1048576) {
          new_state.had_error := true;
          new_state.err_kind := 2;
          new_state.err_file := i;
          reading := false;
        } else {
          n := sys_read(0, &(*ft.source_pool)[new_state.source_pool_next], 1048576 - new_state.source_pool_next);
          if (n < 0) {
            new_state.had_error := true;
            new_state.err_kind := 2;
            new_state.err_file := i;
            reading := false;
          } else {
            if (n == 0) {
              reading := false;
            } else {
              new_state.source_pool_next := new_state.source_pool_next + int64_to_uint64(n);
            }
          }
        }
      }
      (*ft.file_content_off)[i] := off;
      (*ft.file_content_len)[i] := new_state.source_pool_next - off;
    } else {
      path_len := (*ft.file_path_len)[i];
      j := 0;
      while (j < path_len) {
        open_buf[j] := (*ft.path_pool)[(*ft.file_path_off)[i] + j];
        j := j + 1;
      }
      open_buf[path_len] := 0;
      fd := sys_openat(-100, &open_buf[0], 0, 0);
      if (fd < 0) {
        new_state.had_error := true;
        new_state.err_kind := 1;
        new_state.err_file := i;
      } else {
        while (reading) {
          if (new_state.source_pool_next >= 1048576) {
            new_state.had_error := true;
            new_state.err_kind := 2;
            new_state.err_file := i;
            reading := false;
          } else {
            n := sys_read(fd, &(*ft.source_pool)[new_state.source_pool_next], 1048576 - new_state.source_pool_next);
            if (n < 0) {
              new_state.had_error := true;
              new_state.err_kind := 2;
              new_state.err_file := i;
              reading := false;
            } else {
              if (n == 0) {
                reading := false;
              } else {
                new_state.source_pool_next := new_state.source_pool_next + int64_to_uint64(n);
              }
            }
          }
        }
        sys_close(fd);
        (*ft.file_content_off)[i] := off;
        (*ft.file_content_len)[i] := new_state.source_pool_next - off;
      }
    }

    if (!new_state.had_error) {
      new_state := scan_file(ft, new_state, i);
    }

    i := i + 1;
  }

  return new_state;
}

// Phase 2 (Order): Kahn's algorithm, with `order` itself doubling as
// the queue -- seeding it with every indegree-0 file is "enqueue",
// and walking it with a separate `processed` cursor is "dequeue",
// so no second array is needed (mirrors run_discover's own trick).
function run_order(ft: FileTable, rs: ResolveState) : ResolveState {
  mut new_state : ResolveState := rs;
  mut i : uint64 := 0;
  mut processed : uint64 := 0;
  mut cur : uint64 := 0;
  mut j : uint64 := 0;
  mut k : uint64 := 0;
  mut dep : uint64 := 0;
  mut start : uint64 := 0;
  mut count : uint64 := 0;
  mut named : bool := false;

  i := 0;
  while (i < new_state.file_count) {
    if ((*ft.file_indegree)[i] == 0) {
      (*ft.order)[new_state.order_count] := i;
      new_state.order_count := new_state.order_count + 1;
    }
    i := i + 1;
  }

  processed := 0;
  while (processed < new_state.order_count) {
    cur := (*ft.order)[processed];
    j := 0;
    while (j < new_state.file_count) {
      start := (*ft.file_dep_start)[j];
      count := (*ft.file_dep_count)[j];
      k := 0;
      while (k < count) {
        dep := (*ft.dep_pool)[start + k];
        if (dep == cur) {
          (*ft.file_indegree)[j] := (*ft.file_indegree)[j] - 1;
          if ((*ft.file_indegree)[j] == 0) {
            (*ft.order)[new_state.order_count] := j;
            new_state.order_count := new_state.order_count + 1;
          }
        }
        k := k + 1;
      }
      j := j + 1;
    }
    processed := processed + 1;
  }

  if (new_state.order_count < new_state.file_count) {
    i := 0;
    while (i < new_state.file_count) {
      if (!named) {
        if ((*ft.file_indegree)[i] > 0) {
          new_state.err_file := i;
          named := true;
        }
      }
      i := i + 1;
    }
    new_state.had_error := true;
    new_state.err_kind := 5;
  }

  return new_state;
}

// Phase 3 (Emit): walk `order`, appending each file's own body span
// (verbatim) to `merged`, recording where it landed for diagnostics.
function run_emit(ft: FileTable, rs: ResolveState, merged: *(uint8[1048576])) : uint64 {
  mut out_pos : uint64 := 0;
  mut k : uint64 := 0;
  mut fi : uint64 := 0;
  mut body_off : uint64 := 0;
  mut body_end : uint64 := 0;
  mut span_len : uint64 := 0;
  mut s : uint64 := 0;

  k := 0;
  while (k < rs.order_count) {
    fi := (*ft.order)[k];
    (*ft.file_emit_pos)[fi] := out_pos;
    body_off := (*ft.file_body_off)[fi];
    body_end := (*ft.file_content_off)[fi] + (*ft.file_content_len)[fi];
    span_len := body_end - body_off;
    s := 0;
    while (s < span_len) {
      (*merged)[out_pos] := (*ft.source_pool)[body_off + s];
      out_pos := out_pos + 1;
      s := s + 1;
    }
    k := k + 1;
  }

  return out_pos;
}

// 1-based line/col of `target` (an absolute source_pool offset) within
// one file's own content span, counting newlines from that file's own
// `base` (its file_content_off) -- used only for diagnostics raised
// during resolve_includes itself (phases 1/2, before a merged buffer
// exists), as opposed to offset_to_file_line below (phase 3 onward).
function pool_line_col(pool: *(uint8[1048576]), base: uint64, target: uint64) : LineCol {
  mut i : uint64 := base;
  mut line : uint64 := 1;
  mut last_line_start : uint64 := base;
  mut col : uint64 := 0;
  while (i < target) {
    if ((*pool)[i] == 10) {
      line := line + 1;
      last_line_start := i + 1;
    }
    i := i + 1;
  }
  col := (target - last_line_start) + 1;
  return LineCol { line := line, col := col };
}

// Maps a merged-buffer offset back to (file, local line, local col,
// original byte offset within that file) -- see "Diagnostics under
// this model". Correct even when file_count == 1 and that one file had
// its own leading preamble stripped (body_off > content_off): the
// byte_off correction below adds back exactly the stripped preamble's
// length, so a plain single-file program's diagnostics stay identical
// to what they were before this pass existed, preamble or not.
function offset_to_file_line(ft: FileTable, rs: ResolveState, target: uint64) : FileLine {
  mut best_file : uint64 := 0;
  mut best_pos : uint64 := 0;
  mut found : bool := false;
  mut k : uint64 := 0;
  mut fi : uint64 := 0;
  mut pos : uint64 := 0;
  mut local_off : uint64 := 0;
  mut body_off : uint64 := 0;
  mut i : uint64 := 0;
  mut line : uint64 := 1;
  mut last_line_start : uint64 := 0;
  mut col : uint64 := 0;
  mut byte_off : uint64 := 0;

  k := 0;
  while (k < rs.order_count) {
    fi := (*ft.order)[k];
    pos := (*ft.file_emit_pos)[fi];
    if (pos <= target) {
      if (!found) {
        best_file := fi;
        best_pos := pos;
        found := true;
      } else {
        if (pos > best_pos) {
          best_file := fi;
          best_pos := pos;
        }
      }
    }
    k := k + 1;
  }

  local_off := target - best_pos;
  body_off := (*ft.file_body_off)[best_file];
  i := 0;
  while (i < local_off) {
    if ((*ft.source_pool)[body_off + i] == 10) {
      line := line + 1;
      last_line_start := i + 1;
    }
    i := i + 1;
  }
  col := (local_off - last_line_start) + 1;
  byte_off := local_off + (body_off - (*ft.file_content_off)[best_file]);

  return FileLine { file := best_file, line := (*ft.file_body_line)[best_file] + (line - 1), col := col, byte_off := byte_off };
}

// ---------------------------------------------------------------------
// Byte classification (chapter 6.1/6.4 of the lexer spec)
// ---------------------------------------------------------------------

function is_digit(b: uint8) : bool {
  return b >= 48 && b <= 57;
}

function is_hex_digit(b: uint8) : bool {
  return (b >= 48 && b <= 57) || (b >= 97 && b <= 102) || (b >= 65 && b <= 70);
}

function is_alpha(b: uint8) : bool {
  return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95;
}

function is_alnum(b: uint8) : bool {
  return is_alpha(b) || is_digit(b);
}

function is_ws(b: uint8) : bool {
  return b == 32 || b == 9 || b == 13 || b == 10;
}

// ---------------------------------------------------------------------
// Trivia: whitespace + line/block comments (chapter 6.3)
// ---------------------------------------------------------------------

function skip_trivia(src: *(uint8[1048576]), start: uint64, len: uint64) : TriviaResult {
  mut cursor : uint64 := start;
  mut looping : bool := true;
  mut had_error : bool := false;
  mut comment_start : uint64 := 0;
  mut b : uint8 := 0;
  mut b2 : uint8 := 0;
  mut inner_looping : bool := true;
  mut terminated : bool := false;

  while (looping) {
    if (cursor >= len) {
      looping := false;
    } else {
      b := (*src)[cursor];
      if (is_ws(b)) {
        cursor := cursor + 1;
      } else {
        if (b == 47) {
          if (cursor + 1 >= len) {
            looping := false;
          } else {
            b2 := (*src)[cursor + 1];
            if (b2 == 47) {
              cursor := cursor + 2;
              inner_looping := true;
              while (inner_looping) {
                if (cursor >= len) {
                  inner_looping := false;
                } else {
                  if ((*src)[cursor] == 10) {
                    cursor := cursor + 1;
                    inner_looping := false;
                  } else {
                    cursor := cursor + 1;
                  }
                }
              }
            } else {
              if (b2 == 42) {
                comment_start := cursor;
                cursor := cursor + 2;
                terminated := false;
                inner_looping := true;
                while (inner_looping) {
                  if (cursor + 1 >= len) {
                    inner_looping := false;
                  } else {
                    if ((*src)[cursor] == 42 && (*src)[cursor + 1] == 47) {
                      cursor := cursor + 2;
                      terminated := true;
                      inner_looping := false;
                    } else {
                      cursor := cursor + 1;
                    }
                  }
                }
                if (!terminated) {
                  had_error := true;
                  looping := false;
                }
              } else {
                looping := false;
              }
            }
          }
        } else {
          looping := false;
        }
      }
    }
  }

  return TriviaResult { cursor := cursor, had_error := had_error, comment_start := comment_start };
}

// ---------------------------------------------------------------------
// Identifier / keyword span scanning (chapter 6.4)
// ---------------------------------------------------------------------

function scan_ident_end(src: *(uint8[1048576]), start: uint64, len: uint64) : uint64 {
  mut cursor : uint64 := start;
  mut looping : bool := true;

  while (looping) {
    if (cursor >= len) {
      looping := false;
    } else {
      if (is_alnum((*src)[cursor])) {
        cursor := cursor + 1;
      } else {
        looping := false;
      }
    }
  }

  return cursor;
}

// The 24 v0 keywords, matched by direct byte comparison against the
// identifier span -- deliberately a flat, unconditional check per
// keyword (not length-bucketed dispatch like lexer.asm's) rather than
// a hand-rolled trie: clarity over micro-optimization at this stage,
// matching the project's own "Stage 0 has no optimization pass, by
// design" precedent (see project memory) applied here to Stage 1.
function classify_word(src: *(uint8[1048576]), off: uint64, len: uint64) : int32 {
  mut result : int32 := 1;

  if (len == 2) {
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 102) { result := 15; }
  }
  if (len == 3) {
    if ((*src)[off + 0] == 109 && (*src)[off + 1] == 117 && (*src)[off + 2] == 116) { result := 13; }
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 116) { result := 24; }
  }
  if (len == 4) {
    if ((*src)[off + 0] == 101 && (*src)[off + 1] == 108 && (*src)[off + 2] == 115 && (*src)[off + 3] == 101) { result := 16; }
    if ((*src)[off + 0] == 116 && (*src)[off + 1] == 114 && (*src)[off + 2] == 117 && (*src)[off + 3] == 101) { result := 19; }
    if ((*src)[off + 0] == 110 && (*src)[off + 1] == 117 && (*src)[off + 2] == 108 && (*src)[off + 3] == 108) { result := 21; }
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 116 && (*src)[off + 3] == 56) { result := 22; }
    if ((*src)[off + 0] == 98 && (*src)[off + 1] == 111 && (*src)[off + 2] == 111 && (*src)[off + 3] == 108) { result := 32; }
    if ((*src)[off + 0] == 118 && (*src)[off + 1] == 111 && (*src)[off + 2] == 105 && (*src)[off + 3] == 100) { result := 33; }
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 105 && (*src)[off + 2] == 110 && (*src)[off + 3] == 116) { result := 29; }
  }
  if (len == 5) {
    if ((*src)[off + 0] == 99 && (*src)[off + 1] == 111 && (*src)[off + 2] == 110 && (*src)[off + 3] == 115 && (*src)[off + 4] == 116) { result := 14; }
    if ((*src)[off + 0] == 119 && (*src)[off + 1] == 104 && (*src)[off + 2] == 105 && (*src)[off + 3] == 108 && (*src)[off + 4] == 101) { result := 17; }
    if ((*src)[off + 0] == 102 && (*src)[off + 1] == 97 && (*src)[off + 2] == 108 && (*src)[off + 3] == 115 && (*src)[off + 4] == 101) { result := 20; }
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 116 && (*src)[off + 3] == 49 && (*src)[off + 4] == 54) { result := 23; }
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 116 && (*src)[off + 3] == 51 && (*src)[off + 4] == 50) { result := 25; }
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 116 && (*src)[off + 3] == 54 && (*src)[off + 4] == 52) { result := 26; }
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 105 && (*src)[off + 2] == 110 && (*src)[off + 3] == 116 && (*src)[off + 4] == 56) { result := 27; }
  }
  if (len == 6) {
    if ((*src)[off + 0] == 115 && (*src)[off + 1] == 116 && (*src)[off + 2] == 114 && (*src)[off + 3] == 117 && (*src)[off + 4] == 99 && (*src)[off + 5] == 116) { result := 11; }
    if ((*src)[off + 0] == 101 && (*src)[off + 1] == 120 && (*src)[off + 2] == 116 && (*src)[off + 3] == 101 && (*src)[off + 4] == 114 && (*src)[off + 5] == 110) { result := 12; }
    if ((*src)[off + 0] == 114 && (*src)[off + 1] == 101 && (*src)[off + 2] == 116 && (*src)[off + 3] == 117 && (*src)[off + 4] == 114 && (*src)[off + 5] == 110) { result := 18; }
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 105 && (*src)[off + 2] == 110 && (*src)[off + 3] == 116 && (*src)[off + 4] == 49 && (*src)[off + 5] == 54) { result := 28; }
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 105 && (*src)[off + 2] == 110 && (*src)[off + 3] == 116 && (*src)[off + 4] == 51 && (*src)[off + 5] == 50) { result := 30; }
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 105 && (*src)[off + 2] == 110 && (*src)[off + 3] == 116 && (*src)[off + 4] == 54 && (*src)[off + 5] == 52) { result := 31; }
  }
  if (len == 8) {
    if ((*src)[off + 0] == 102 && (*src)[off + 1] == 117 && (*src)[off + 2] == 110 && (*src)[off + 3] == 99 && (*src)[off + 4] == 116 && (*src)[off + 5] == 105 && (*src)[off + 6] == 111 && (*src)[off + 7] == 110) { result := 10; }
  }

  return result;
}

// ---------------------------------------------------------------------
// Number literal span scanning (chapter 4.3 / grammar's decimal_form,
// based_form) -- span only, no value computation: the dump format
// (chapter 9) prints raw source text for TOK_INT, never the computed
// value, so phase 1 doesn't need it (a future parser phase will).
// ---------------------------------------------------------------------

function scan_number(src: *(uint8[1048576]), start: uint64, len: uint64) : NumberResult {
  mut cursor : uint64 := start;
  mut looping : bool := true;
  mut had_error : bool := false;
  mut error_at : uint64 := 0;
  mut n_pos : uint64 := 0;
  mut has_value_digit : bool := false;

  while (looping) {
    if (cursor >= len) {
      looping := false;
    } else {
      if (is_digit((*src)[cursor])) {
        cursor := cursor + 1;
      } else {
        looping := false;
      }
    }
  }

  if (cursor < len) {
    if ((*src)[cursor] == 110) {
      n_pos := cursor;
      cursor := cursor + 1;
      has_value_digit := false;
      looping := true;
      while (looping) {
        if (cursor >= len) {
          looping := false;
        } else {
          if (is_hex_digit((*src)[cursor])) {
            has_value_digit := true;
            cursor := cursor + 1;
          } else {
            looping := false;
          }
        }
      }
      if (!has_value_digit) {
        had_error := true;
        error_at := n_pos + 1;
      }
    }
  }

  return NumberResult { cursor := cursor, had_error := had_error, error_at := error_at };
}

// ---------------------------------------------------------------------
// lex_next -- one token, matching lexer.asm's own signature in spirit
// (chapter 5): takes a cursor, returns the token and the new cursor,
// as a value (v0 already permits struct returns, unlike the asm
// version's caller-allocated-struct convention -- no hidden state
// either way).
// ---------------------------------------------------------------------

function lex_next(src: *(uint8[1048576]), start: uint64, len: uint64) : LexOutcome {
  mut trivia : TriviaResult := skip_trivia(src, start, len);
  mut cursor : uint64 := trivia.cursor;
  mut kind : int32 := 0;
  mut tok_offset : uint64 := cursor;
  mut tok_length : uint64 := 0;
  mut b : uint8 := 0;
  mut b2 : uint8 := 0;
  mut end_pos : uint64 := 0;
  mut num : NumberResult := NumberResult { cursor := 0, had_error := false, error_at := 0 };

  if (trivia.had_error) {
    kind := 253;
    tok_offset := trivia.comment_start;
    tok_length := 0;
  } else {
    if (cursor >= len) {
      kind := 0;
      tok_offset := len;
      tok_length := 0;
    } else {
      b := (*src)[cursor];

      if (is_alpha(b)) {
        end_pos := scan_ident_end(src, cursor, len);
        tok_offset := cursor;
        tok_length := end_pos - cursor;
        kind := classify_word(src, cursor, tok_length);
        cursor := end_pos;
      } else {
        if (is_digit(b)) {
          num := scan_number(src, cursor, len);
          if (num.had_error) {
            kind := 254;
            tok_offset := num.error_at;
            tok_length := 0;
            cursor := num.cursor;
          } else {
            tok_offset := cursor;
            tok_length := num.cursor - cursor;
            kind := 2;
            cursor := num.cursor;
          }
        } else {
          if (b == 58) {
            if (cursor + 1 < len && (*src)[cursor + 1] == 61) {
              kind := 60; tok_length := 2; cursor := cursor + 2;
            } else {
              kind := 40; tok_length := 1; cursor := cursor + 1;
            }
          } else {
            if (b == 61) {
              if (cursor + 1 < len && (*src)[cursor + 1] == 61) {
                kind := 61; tok_length := 2; cursor := cursor + 2;
              } else {
                kind := 254; tok_length := 1; cursor := cursor + 1;
              }
            } else {
              if (b == 33) {
                if (cursor + 1 < len && (*src)[cursor + 1] == 61) {
                  kind := 62; tok_length := 2; cursor := cursor + 2;
                } else {
                  kind := 69; tok_length := 1; cursor := cursor + 1;
                }
              } else {
                if (b == 60) {
                  if (cursor + 1 < len && (*src)[cursor + 1] == 61) {
                    kind := 63; tok_length := 2; cursor := cursor + 2;
                  } else {
                    if (cursor + 1 < len && (*src)[cursor + 1] == 60) {
                      kind := 65; tok_length := 2; cursor := cursor + 2;
                    } else {
                      kind := 76; tok_length := 1; cursor := cursor + 1;
                    }
                  }
                } else {
                  if (b == 62) {
                    if (cursor + 1 < len && (*src)[cursor + 1] == 61) {
                      kind := 64; tok_length := 2; cursor := cursor + 2;
                    } else {
                      if (cursor + 1 < len && (*src)[cursor + 1] == 62) {
                        kind := 66; tok_length := 2; cursor := cursor + 2;
                      } else {
                        kind := 77; tok_length := 1; cursor := cursor + 1;
                      }
                    }
                  } else {
                    if (b == 38) {
                      if (cursor + 1 < len && (*src)[cursor + 1] == 38) {
                        kind := 67; tok_length := 2; cursor := cursor + 2;
                      } else {
                        kind := 72; tok_length := 1; cursor := cursor + 1;
                      }
                    } else {
                      if (b == 124) {
                        if (cursor + 1 < len && (*src)[cursor + 1] == 124) {
                          kind := 68; tok_length := 2; cursor := cursor + 2;
                        } else {
                          kind := 79; tok_length := 1; cursor := cursor + 1;
                        }
                      } else {
                        if (b == 59) { kind := 41; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 44) { kind := 42; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 46) { kind := 43; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 40) { kind := 44; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 41) { kind := 45; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 123) { kind := 46; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 125) { kind := 47; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 91) { kind := 48; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 93) { kind := 49; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 45) { kind := 70; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 42) { kind := 71; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 47) { kind := 73; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 37) { kind := 74; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 43) { kind := 75; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 94) { kind := 78; tok_length := 1; cursor := cursor + 1; }
                        else {
                          kind := 254; tok_length := 1; cursor := cursor + 1;
                        }}}}}}}}}}}}}}}
                      }
                    }
                  }
                }
              }
              tok_offset := cursor - tok_length;
            }
          }
        }
      }
    }
  }

  return LexOutcome { tok := Token { kind := kind, offset := tok_offset, length := tok_length, value := 0 }, cursor := cursor };
}

// ---------------------------------------------------------------------
// I/O and formatting helpers used only by main() below. Kept as small,
// separately testable functions rather than inlined, even though v0
// has no way to unit-test them in isolation yet -- once Stage 1 has a
// parser and checker, they read straightforwardly as ordinary v0 code.
// ---------------------------------------------------------------------

// Bridges an int64 syscall return value into the uint64 space this
// file otherwise stays in throughout (buffer positions, lengths) --
// v0 has no cast operator (deferred to a future version, see the v0
// language reference's own deferred-features list), so a value that's
// already known to be small and non-negative (checked by the caller)
// is moved across the int64/uint64 type boundary by unary counting
// instead. Bounded by the caller's own buffer size in every use here,
// so this never loops more than a few tens of thousands of times.
function int64_to_uint64(n: int64) : uint64 {
  mut result : uint64 := 0;
  mut steps : int64 := n;
  while (steps > 0) {
    result := result + 1;
    steps := steps - 1;
  }
  return result;
}

function digit_to_ascii(d: uint64) : uint8 {
  mut result : uint8 := 48;
  if (d == 1) { result := 49; }
  if (d == 2) { result := 50; }
  if (d == 3) { result := 51; }
  if (d == 4) { result := 52; }
  if (d == 5) { result := 53; }
  if (d == 6) { result := 54; }
  if (d == 7) { result := 55; }
  if (d == 8) { result := 56; }
  if (d == 9) { result := 57; }
  return result;
}

function nibble_to_hex(n: uint8) : uint8 {
  mut result : uint8 := 48;
  if (n == 1) { result := 49; }
  if (n == 2) { result := 50; }
  if (n == 3) { result := 51; }
  if (n == 4) { result := 52; }
  if (n == 5) { result := 53; }
  if (n == 6) { result := 54; }
  if (n == 7) { result := 55; }
  if (n == 8) { result := 56; }
  if (n == 9) { result := 57; }
  if (n == 10) { result := 97; }
  if (n == 11) { result := 98; }
  if (n == 12) { result := 99; }
  if (n == 13) { result := 100; }
  if (n == 14) { result := 101; }
  if (n == 15) { result := 102; }
  return result;
}

// Copies s_len bytes of a fixed, caller-supplied 80-byte label (see
// main()'s own const-ish label locals) into out at pos.
function append_str(out: *(uint8[131072]), pos: uint64, s: *(uint8[80]), s_len: uint64) : uint64 {
  mut i : uint64 := 0;
  mut new_pos : uint64 := pos;
  while (i < s_len) {
    (*out)[new_pos] := (*s)[i];
    new_pos := new_pos + 1;
    i := i + 1;
  }
  return new_pos;
}

// Copies a raw source slice (a token's own span) into out at pos.
function append_slice(out: *(uint8[131072]), pos: uint64, src: *(uint8[1048576]), off: uint64, ln: uint64) : uint64 {
  mut i : uint64 := 0;
  mut new_pos : uint64 := pos;
  while (i < ln) {
    (*out)[new_pos] := (*src)[off + i];
    new_pos := new_pos + 1;
    i := i + 1;
  }
  return new_pos;
}

// Appends one raw byte.
function append_byte(out: *(uint8[131072]), pos: uint64, b: uint8) : uint64 {
  (*out)[pos] := b;
  return pos + 1;
}

// Appends value's decimal representation. Digits are produced
// least-significant-first into a small local scratch array, then
// copied out in reverse -- v0 has no string-building convenience
// beyond raw array indexing, so this is the direct way to do it.
function append_uint(out: *(uint8[131072]), pos: uint64, value: uint64) : uint64 {
  mut digits : uint8[24] := 0;
  mut count : uint64 := 0;
  mut v : uint64 := value;
  mut new_pos : uint64 := pos;
  mut d : uint64 := 0;
  mut i : uint64 := 0;

  if (v == 0) {
    digits[0] := 48;
    count := 1;
  } else {
    while (v > 0) {
      d := v % 10;
      digits[count] := digit_to_ascii(d);
      count := count + 1;
      v := v / 10;
    }
  }

  i := 0;
  while (i < count) {
    new_pos := append_byte(out, new_pos, digits[(count - 1) - i]);
    i := i + 1;
  }
  return new_pos;
}

// Appends the two-hex-digit form of a byte (e.g. 0x40 -> "40").
function append_hex_byte(out: *(uint8[131072]), pos: uint64, b: uint8) : uint64 {
  mut hi : uint8 := b / 16;
  mut lo : uint8 := b % 16;
  mut new_pos : uint64 := pos;
  new_pos := append_byte(out, new_pos, nibble_to_hex(hi));
  new_pos := append_byte(out, new_pos, nibble_to_hex(lo));
  return new_pos;
}

// 1-based line and column of a byte offset, by counting newlines from
// the start of the buffer -- deliberately not on lex_next's own hot
// path (mirrors lexer_spec.md chapter 7's own reasoning for Hoare's
// hand-written lexer): it runs once, only when a program is about to
// report an error and exit anyway.
function compute_line_col(src: *(uint8[1048576]), src_len: uint64, target: uint64) : LineCol {
  mut i : uint64 := 0;
  mut line : uint64 := 1;
  mut last_line_start : uint64 := 0;
  mut limit : uint64 := target;
  mut col : uint64 := 0;

  if (limit > src_len) {
    limit := src_len;
  }
  while (i < limit) {
    if ((*src)[i] == 10) {
      line := line + 1;
      last_line_start := i + 1;
    }
    i := i + 1;
  }
  col := (target - last_line_start) + 1;

  return LineCol { line := line, col := col };
}

// Retries sys_write until `total` bytes are sent or an error occurs --
// POSIX write may send fewer bytes than requested even before any
// error, so a single call is never assumed to finish the job (same
// discipline lexer_spec.md chapter 8.3 documents for Hoare's own
// write_all). Two copies -- one per buffer size -- because a pointer
// parameter's array element count is part of its type (§2.5 of the v0
// reference); there is no way to write this generically over "any
// fixed-size uint8 array" in v0.
function write_all(fd: int64, buf: *(uint8[131072]), total: uint64) : bool {
  mut pos : uint64 := 0;
  mut n : int64 := 0;
  mut ok : bool := true;
  mut looping : bool := true;

  while (looping) {
    if (pos >= total) {
      looping := false;
    } else {
      n := sys_write(fd, &(*buf)[pos], total - pos);
      if (n < 0) {
        ok := false;
        looping := false;
      } else {
        pos := pos + int64_to_uint64(n);
      }
    }
  }
  return ok;
}

// Same shape as append_str/append_byte/append_uint/append_hex_byte
// above, retargeted at the 256-byte diagnostic buffer -- see
// write_all/write_all_small's own comment for why v0 needs two copies
// of each rather than one generic version.
function append_str_e(out: *(uint8[256]), pos: uint64, s: *(uint8[80]), s_len: uint64) : uint64 {
  mut i : uint64 := 0;
  mut new_pos : uint64 := pos;
  while (i < s_len) {
    (*out)[new_pos] := (*s)[i];
    new_pos := new_pos + 1;
    i := i + 1;
  }
  return new_pos;
}

function append_byte_e(out: *(uint8[256]), pos: uint64, b: uint8) : uint64 {
  (*out)[pos] := b;
  return pos + 1;
}

function append_uint_e(out: *(uint8[256]), pos: uint64, value: uint64) : uint64 {
  mut digits : uint8[24] := 0;
  mut count : uint64 := 0;
  mut v : uint64 := value;
  mut new_pos : uint64 := pos;
  mut d : uint64 := 0;
  mut i : uint64 := 0;

  if (v == 0) {
    digits[0] := 48;
    count := 1;
  } else {
    while (v > 0) {
      d := v % 10;
      digits[count] := digit_to_ascii(d);
      count := count + 1;
      v := v / 10;
    }
  }

  i := 0;
  while (i < count) {
    new_pos := append_byte_e(out, new_pos, digits[(count - 1) - i]);
    i := i + 1;
  }
  return new_pos;
}

function append_hex_byte_e(out: *(uint8[256]), pos: uint64, b: uint8) : uint64 {
  mut hi : uint8 := b / 16;
  mut lo : uint8 := b % 16;
  mut new_pos : uint64 := pos;
  new_pos := append_byte_e(out, new_pos, nibble_to_hex(hi));
  new_pos := append_byte_e(out, new_pos, nibble_to_hex(lo));
  return new_pos;
}

// Copies pool[off..off+ln) (a resolved filename, from path_pool) into
// the 256-byte diagnostic buffer -- same shape as append_slice, just
// retargeted at path_pool's own size (see write_all/write_all_small's
// comment for why this codebase keeps one copy per exact array size).
function append_pool_e(out: *(uint8[256]), pos: uint64, pool: *(uint8[16384]), off: uint64, ln: uint64) : uint64 {
  mut i : uint64 := 0;
  mut new_pos : uint64 := pos;
  while (i < ln) {
    (*out)[new_pos] := (*pool)[off + i];
    new_pos := new_pos + 1;
    i := i + 1;
  }
  return new_pos;
}

function write_all_small(fd: int64, buf: *(uint8[256]), total: uint64) : bool {
  mut pos : uint64 := 0;
  mut n : int64 := 0;
  mut ok : bool := true;
  mut looping : bool := true;

  while (looping) {
    if (pos >= total) {
      looping := false;
    } else {
      n := sys_write(fd, &(*buf)[pos], total - pos);
      if (n < 0) {
        ok := false;
        looping := false;
      } else {
        pos := pos + int64_to_uint64(n);
      }
    }
  }
  return ok;
}

