  // ---- 0. register the entry file (index 0) with a synthetic,
  // slash-free path -- its own directory is therefore empty, so its
  // OWN #include targets resolve relative to the process's cwd (there
  // is no argv until v1.0.11, so its real path can never be known) ----
  path_pool[0] := 60;
  path_pool[1] := 115;
  path_pool[2] := 116;
  path_pool[3] := 100;
  path_pool[4] := 105;
  path_pool[5] := 110;
  path_pool[6] := 62;
  file_path_off[0] := 0;
  file_path_len[0] := 7;

  // ---- 1. resolve_includes: discover -> order -> emit (v1.0.1) ----
  rs := run_discover(ft, rs);
  if (!rs.had_error) {
    rs := run_order(ft, rs);
  }
  if (!rs.had_error) {
    merged_len := run_emit(ft, rs, &merged_src);
  }

  if (rs.had_error) {
    if (rs.err_kind == 1) {
      err_pos := append_str_e(&err_buf, err_pos, &lbl_cannot_open, 38);
      err_pos := append_pool_e(&err_buf, err_pos, &path_pool, file_path_off[rs.err_file], file_path_len[rs.err_file]);
      err_pos := append_str_e(&err_buf, err_pos, &lbl_close_quote_nl, 2);
      exit_code := 1;
    } else {
      if (rs.err_kind == 2) {
        err_pos := append_str_e(&err_buf, err_pos, &lbl_io_error_reading, 36);
        err_pos := append_pool_e(&err_buf, err_pos, &path_pool, file_path_off[rs.err_file], file_path_len[rs.err_file]);
        err_pos := append_str_e(&err_buf, err_pos, &lbl_close_quote_nl, 2);
        exit_code := 2;
      } else {
        if (rs.err_kind == 5) {
          err_pos := append_str_e(&err_buf, err_pos, &lbl_cycle, 54);
          err_pos := append_pool_e(&err_buf, err_pos, &path_pool, file_path_off[rs.err_file], file_path_len[rs.err_file]);
          err_pos := append_str_e(&err_buf, err_pos, &lbl_close_quote_nl, 2);
          exit_code := 1;
        } else {
          lc := pool_line_col(&source_pool, file_content_off[rs.err_file], rs.err_off);
          if (rs.err_kind == 3) {
            err_pos := append_str_e(&err_buf, err_pos, &lbl_malformed_directive, 39);
          } else {
            if (rs.err_kind == 4) {
              err_pos := append_str_e(&err_buf, err_pos, &lbl_preamble_violation, 73);
            } else {
              if (rs.err_kind == 6) {
                err_pos := append_str_e(&err_buf, err_pos, &lbl_path_too_long, 59);
              } else {
                if (rs.err_kind == 7) {
                  err_pos := append_str_e(&err_buf, err_pos, &lbl_too_many_files, 59);
                } else {
                  err_pos := append_str_e(&err_buf, err_pos, &lbl_unterm_block_preamble, 46);
                }
              }
            }
          }
          err_pos := append_str_e(&err_buf, err_pos, &lbl_in_file_q, 10);
          err_pos := append_pool_e(&err_buf, err_pos, &path_pool, file_path_off[rs.err_file], file_path_len[rs.err_file]);
          err_pos := append_str_e(&err_buf, err_pos, &lbl_q_at_line, 10);
          err_pos := append_uint_e(&err_buf, err_pos, lc.line);
          err_pos := append_str_e(&err_buf, err_pos, &err_col, 6);
          err_pos := append_uint_e(&err_buf, err_pos, lc.col);
          err_pos := append_str_e(&err_buf, err_pos, &lbl_nl, 1);
          exit_code := 1;
        }
      }
    }
    wrote_ok := write_all_small(2, &err_buf, err_pos);
  } else {
    // ---- 2. tokenize, formatting the dump as we go (chapter 9) ----
    while (lexing) {
      lo := lex_next(&merged_src, cursor, merged_len);
      cursor := lo.cursor;

      if (lo.tok.kind == 0) {
        out_pos := append_str(&out_buf, out_pos, &lbl_eof, 4);
        lexing := false;
      } else {
        if (lo.tok.kind == 253 || lo.tok.kind == 254) {
          got_error := true;
          if (lo.tok.kind == 254 && lo.tok.length == 1 && lo.tok.offset < merged_len) {
            err_byte := merged_src[lo.tok.offset];
          }
          lexing := false;
        } else {
          if (lo.tok.kind == 1) {
            out_pos := append_str(&out_buf, out_pos, &lbl_ident_sp, 6);
            out_pos := append_slice(&out_buf, out_pos, &merged_src, lo.tok.offset, lo.tok.length);
            out_pos := append_str(&out_buf, out_pos, &lbl_nl, 1);
          } else {
            if (lo.tok.kind == 2) {
              out_pos := append_str(&out_buf, out_pos, &lbl_int_sp, 4);
              out_pos := append_slice(&out_buf, out_pos, &merged_src, lo.tok.offset, lo.tok.length);
              out_pos := append_str(&out_buf, out_pos, &lbl_nl, 1);
            } else {
              if (lo.tok.kind >= 10 && lo.tok.kind <= 33) {
                out_pos := append_str(&out_buf, out_pos, &lbl_kw_sp, 3);
                out_pos := append_slice(&out_buf, out_pos, &merged_src, lo.tok.offset, lo.tok.length);
                out_pos := append_str(&out_buf, out_pos, &lbl_nl, 1);
              } else {
                if (lo.tok.kind >= 60 && lo.tok.kind <= 79) {
                  out_pos := append_str(&out_buf, out_pos, &lbl_op_sp, 3);
                  if (lo.tok.kind == 60) { out_pos := append_str(&out_buf, out_pos, &op_assign, 2); }
                  if (lo.tok.kind == 61) { out_pos := append_str(&out_buf, out_pos, &op_eq, 2); }
                  if (lo.tok.kind == 62) { out_pos := append_str(&out_buf, out_pos, &op_ne, 2); }
                  if (lo.tok.kind == 63) { out_pos := append_str(&out_buf, out_pos, &op_le, 2); }
                  if (lo.tok.kind == 64) { out_pos := append_str(&out_buf, out_pos, &op_ge, 2); }
                  if (lo.tok.kind == 65) { out_pos := append_str(&out_buf, out_pos, &op_shl, 2); }
                  if (lo.tok.kind == 66) { out_pos := append_str(&out_buf, out_pos, &op_shr, 2); }
                  if (lo.tok.kind == 67) { out_pos := append_str(&out_buf, out_pos, &op_andand, 2); }
                  if (lo.tok.kind == 68) { out_pos := append_str(&out_buf, out_pos, &op_oror, 2); }
                  if (lo.tok.kind == 69) { out_pos := append_str(&out_buf, out_pos, &op_bang, 1); }
                  if (lo.tok.kind == 70) { out_pos := append_str(&out_buf, out_pos, &op_minus, 1); }
                  if (lo.tok.kind == 71) { out_pos := append_str(&out_buf, out_pos, &op_star, 1); }
                  if (lo.tok.kind == 72) { out_pos := append_str(&out_buf, out_pos, &op_amp, 1); }
                  if (lo.tok.kind == 73) { out_pos := append_str(&out_buf, out_pos, &op_slash, 1); }
                  if (lo.tok.kind == 74) { out_pos := append_str(&out_buf, out_pos, &op_percent, 1); }
                  if (lo.tok.kind == 75) { out_pos := append_str(&out_buf, out_pos, &op_plus, 1); }
                  if (lo.tok.kind == 76) { out_pos := append_str(&out_buf, out_pos, &op_lt, 1); }
                  if (lo.tok.kind == 77) { out_pos := append_str(&out_buf, out_pos, &op_gt, 1); }
                  if (lo.tok.kind == 78) { out_pos := append_str(&out_buf, out_pos, &op_caret, 1); }
                  if (lo.tok.kind == 79) { out_pos := append_str(&out_buf, out_pos, &op_pipe, 1); }
                  out_pos := append_str(&out_buf, out_pos, &lbl_nl, 1);
                } else {
                  if (lo.tok.kind == 40) { out_pos := append_str(&out_buf, out_pos, &lbl_colon, 6); }
                  if (lo.tok.kind == 41) { out_pos := append_str(&out_buf, out_pos, &lbl_semi, 5); }
                  if (lo.tok.kind == 42) { out_pos := append_str(&out_buf, out_pos, &lbl_comma, 6); }
                  if (lo.tok.kind == 43) { out_pos := append_str(&out_buf, out_pos, &lbl_dot, 4); }
                  if (lo.tok.kind == 44) { out_pos := append_str(&out_buf, out_pos, &lbl_lparen, 7); }
                  if (lo.tok.kind == 45) { out_pos := append_str(&out_buf, out_pos, &lbl_rparen, 7); }
                  if (lo.tok.kind == 46) { out_pos := append_str(&out_buf, out_pos, &lbl_lbrace, 7); }
                  if (lo.tok.kind == 47) { out_pos := append_str(&out_buf, out_pos, &lbl_rbrace, 7); }
                  if (lo.tok.kind == 48) { out_pos := append_str(&out_buf, out_pos, &lbl_lbracket, 9); }
                  if (lo.tok.kind == 49) { out_pos := append_str(&out_buf, out_pos, &lbl_rbracket, 9); }
                }
              }
            }
          }
        }
      }
    }

    // ---- 3. flush whatever was correctly recognized, error or not
    // (chapter 7: "the prefix before the error is not lost") ----
    wrote_ok := write_all(1, &out_buf, out_pos);
    if (!wrote_ok) {
      exit_code := 2;
    } else {
      if (got_error) {
        exit_code := 1;
        fl := offset_to_file_line(ft, rs, lo.tok.offset);
        if (lo.tok.kind == 253) {
          err_pos := append_str_e(&err_buf, err_pos, &err3_a, 46);
          if (rs.file_count > 1) {
            err_pos := append_str_e(&err_buf, err_pos, &lbl_in_file_q, 10);
            err_pos := append_pool_e(&err_buf, err_pos, &path_pool, file_path_off[fl.file], file_path_len[fl.file]);
            err_pos := append_str_e(&err_buf, err_pos, &lbl_q_at_line, 10);
          } else {
            err_pos := append_str_e(&err_buf, err_pos, &err_at_line_bare, 9);
          }
          err_pos := append_uint_e(&err_buf, err_pos, fl.line);
          err_pos := append_str_e(&err_buf, err_pos, &err_col, 6);
          err_pos := append_uint_e(&err_buf, err_pos, fl.col);
          err_pos := append_str_e(&err_buf, err_pos, &err_byteoff, 14);
          err_pos := append_uint_e(&err_buf, err_pos, fl.byte_off);
          err_pos := append_str_e(&err_buf, err_pos, &err_close_nl, 2);
        } else {
          if (lo.tok.length == 0) {
            err_pos := append_str_e(&err_buf, err_pos, &err2_a, 61);
            if (rs.file_count > 1) {
              err_pos := append_str_e(&err_buf, err_pos, &lbl_in_file_q, 10);
              err_pos := append_pool_e(&err_buf, err_pos, &path_pool, file_path_off[fl.file], file_path_len[fl.file]);
              err_pos := append_str_e(&err_buf, err_pos, &lbl_q_at_line, 10);
            } else {
              err_pos := append_str_e(&err_buf, err_pos, &err_at_line_bare, 9);
            }
            err_pos := append_uint_e(&err_buf, err_pos, fl.line);
            err_pos := append_str_e(&err_buf, err_pos, &err_col, 6);
            err_pos := append_uint_e(&err_buf, err_pos, fl.col);
            err_pos := append_str_e(&err_buf, err_pos, &err_byteoff, 14);
            err_pos := append_uint_e(&err_buf, err_pos, fl.byte_off);
            err_pos := append_str_e(&err_buf, err_pos, &err_close_nl, 2);
          } else {
            err_pos := append_str_e(&err_buf, err_pos, &err1_a, 33);
            err_pos := append_byte_e(&err_buf, err_pos, err_byte);
            err_pos := append_str_e(&err_buf, err_pos, &err1_c, 5);
            err_pos := append_hex_byte_e(&err_buf, err_pos, err_byte);
            if (rs.file_count > 1) {
              err_pos := append_str_e(&err_buf, err_pos, &lbl_close_paren, 1);
              err_pos := append_str_e(&err_buf, err_pos, &lbl_in_file_q, 10);
              err_pos := append_pool_e(&err_buf, err_pos, &path_pool, file_path_off[fl.file], file_path_len[fl.file]);
              err_pos := append_str_e(&err_buf, err_pos, &lbl_q_at_line, 10);
            } else {
              err_pos := append_str_e(&err_buf, err_pos, &err_at_line, 10);
            }
            err_pos := append_uint_e(&err_buf, err_pos, fl.line);
            err_pos := append_str_e(&err_buf, err_pos, &err_col, 6);
            err_pos := append_uint_e(&err_buf, err_pos, fl.col);
            err_pos := append_str_e(&err_buf, err_pos, &err_byteoff, 14);
            err_pos := append_uint_e(&err_buf, err_pos, fl.byte_off);
            err_pos := append_str_e(&err_buf, err_pos, &err_close_nl, 2);
          }
        }
        wrote_ok := write_all_small(2, &err_buf, err_pos);
      }
    }
  }

  sys_exit(exit_code);
  return 0;
}
