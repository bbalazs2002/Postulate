// Postulate Stage 1 -- lexer, phase 1 of the self-hosting bootstrap
// compiler (see Stage1/README.md). Written in Postulate v0 itself,
// compiled by Hoare (Stage 0), and defines the exact same v0 lexical
// grammar Hoare's own hand-written src/lexer.asm defines -- see
// docs/postulate_stage0_lexer_spec.md, which this file follows chapter
// by chapter.
//
// I/O model matches Hoare's own lexer binary exactly (chapter 8 there):
// reads the whole source program from stdin, writes one line per token
// to stdout in the same dump format (chapter 9), and on a lexical error
// writes a diagnostic to stderr and exits with the matching exit code
// (chapter 7). This lets Hoare/tests/cases/*.ptl -- with their
// .expected.stdout/.expected.stderr/.expected.exit fixtures -- serve as
// this lexer's own test suite unchanged: both lexers must accept
// exactly the same language and print exactly the same token stream.
//
// Token-kind encoding matches tokens.inc exactly (not required for
// correctness -- only the printed dump format is observable -- but
// convenient, since the spec already tabulates it): 0-2 special,
// 10-33 keywords, 40-49 punctuation, 60-79 operators, 253-254 errors.
//
// Fixed buffer sizes: this lexer reads into a *stack-local* array
// (v0 has no static/global storage, see README.md), not the 1 MiB
// .bss buffer Hoare's own binary uses -- 64 KiB source / 128 KiB
// output, generous for a bootstrap-stage source file while keeping the
// stack frame modest. A source program that doesn't fit is reported as
// an I/O error (exit 2), matching Hoare's own "buffer too small"
// convention (chapter 8.2 there).

extern function sys_read(fd: int64, buf: *uint8, count: uint64) : int64;
extern function sys_write(fd: int64, buf: *uint8, count: uint64) : int64;
extern function sys_exit(code: int64) : void;

struct Token {
  kind : int32;
  offset : uint64;
  length : uint64;
  value : int64;
}

struct TriviaResult {
  cursor : uint64;
  had_error : bool;
  comment_start : uint64;
}

struct NumberResult {
  cursor : uint64;
  had_error : bool;
  error_at : uint64;
}

struct LexOutcome {
  tok : Token;
  cursor : uint64;
}

struct LineCol {
  line : uint64;
  col : uint64;
}

// ---------------------------------------------------------------------
// Byte classification (chapter 6.1/6.4 of the lexer spec)
// ---------------------------------------------------------------------

function is_digit(b: uint8) : bool {
  return b >= 48 && b <= 57;
}

function is_hex_digit(b: uint8) : bool {
  return (b >= 48 && b <= 57) || (b >= 97 && b <= 102) || (b >= 65 && b <= 70);
}

function is_alpha(b: uint8) : bool {
  return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95;
}

function is_alnum(b: uint8) : bool {
  return is_alpha(b) || is_digit(b);
}

function is_ws(b: uint8) : bool {
  return b == 32 || b == 9 || b == 13 || b == 10;
}

// ---------------------------------------------------------------------
// Trivia: whitespace + line/block comments (chapter 6.3)
// ---------------------------------------------------------------------

function skip_trivia(src: *(uint8[65536]), start: uint64, len: uint64) : TriviaResult {
  mut cursor : uint64 := start;
  mut looping : bool := true;
  mut had_error : bool := false;
  mut comment_start : uint64 := 0;
  mut b : uint8 := 0;
  mut b2 : uint8 := 0;
  mut inner_looping : bool := true;
  mut terminated : bool := false;

  while (looping) {
    if (cursor >= len) {
      looping := false;
    } else {
      b := (*src)[cursor];
      if (is_ws(b)) {
        cursor := cursor + 1;
      } else {
        if (b == 47) {
          if (cursor + 1 >= len) {
            looping := false;
          } else {
            b2 := (*src)[cursor + 1];
            if (b2 == 47) {
              cursor := cursor + 2;
              inner_looping := true;
              while (inner_looping) {
                if (cursor >= len) {
                  inner_looping := false;
                } else {
                  if ((*src)[cursor] == 10) {
                    cursor := cursor + 1;
                    inner_looping := false;
                  } else {
                    cursor := cursor + 1;
                  }
                }
              }
            } else {
              if (b2 == 42) {
                comment_start := cursor;
                cursor := cursor + 2;
                terminated := false;
                inner_looping := true;
                while (inner_looping) {
                  if (cursor + 1 >= len) {
                    inner_looping := false;
                  } else {
                    if ((*src)[cursor] == 42 && (*src)[cursor + 1] == 47) {
                      cursor := cursor + 2;
                      terminated := true;
                      inner_looping := false;
                    } else {
                      cursor := cursor + 1;
                    }
                  }
                }
                if (!terminated) {
                  had_error := true;
                  looping := false;
                }
              } else {
                looping := false;
              }
            }
          }
        } else {
          looping := false;
        }
      }
    }
  }

  return TriviaResult { cursor := cursor, had_error := had_error, comment_start := comment_start };
}

// ---------------------------------------------------------------------
// Identifier / keyword span scanning (chapter 6.4)
// ---------------------------------------------------------------------

function scan_ident_end(src: *(uint8[65536]), start: uint64, len: uint64) : uint64 {
  mut cursor : uint64 := start;
  mut looping : bool := true;

  while (looping) {
    if (cursor >= len) {
      looping := false;
    } else {
      if (is_alnum((*src)[cursor])) {
        cursor := cursor + 1;
      } else {
        looping := false;
      }
    }
  }

  return cursor;
}

// The 24 v0 keywords, matched by direct byte comparison against the
// identifier span -- deliberately a flat, unconditional check per
// keyword (not length-bucketed dispatch like lexer.asm's) rather than
// a hand-rolled trie: clarity over micro-optimization at this stage,
// matching the project's own "Stage 0 has no optimization pass, by
// design" precedent (see project memory) applied here to Stage 1.
function classify_word(src: *(uint8[65536]), off: uint64, len: uint64) : int32 {
  mut result : int32 := 1;

  if (len == 2) {
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 102) { result := 15; }
  }
  if (len == 3) {
    if ((*src)[off + 0] == 109 && (*src)[off + 1] == 117 && (*src)[off + 2] == 116) { result := 13; }
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 116) { result := 24; }
  }
  if (len == 4) {
    if ((*src)[off + 0] == 101 && (*src)[off + 1] == 108 && (*src)[off + 2] == 115 && (*src)[off + 3] == 101) { result := 16; }
    if ((*src)[off + 0] == 116 && (*src)[off + 1] == 114 && (*src)[off + 2] == 117 && (*src)[off + 3] == 101) { result := 19; }
    if ((*src)[off + 0] == 110 && (*src)[off + 1] == 117 && (*src)[off + 2] == 108 && (*src)[off + 3] == 108) { result := 21; }
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 116 && (*src)[off + 3] == 56) { result := 22; }
    if ((*src)[off + 0] == 98 && (*src)[off + 1] == 111 && (*src)[off + 2] == 111 && (*src)[off + 3] == 108) { result := 32; }
    if ((*src)[off + 0] == 118 && (*src)[off + 1] == 111 && (*src)[off + 2] == 105 && (*src)[off + 3] == 100) { result := 33; }
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 105 && (*src)[off + 2] == 110 && (*src)[off + 3] == 116) { result := 29; }
  }
  if (len == 5) {
    if ((*src)[off + 0] == 99 && (*src)[off + 1] == 111 && (*src)[off + 2] == 110 && (*src)[off + 3] == 115 && (*src)[off + 4] == 116) { result := 14; }
    if ((*src)[off + 0] == 119 && (*src)[off + 1] == 104 && (*src)[off + 2] == 105 && (*src)[off + 3] == 108 && (*src)[off + 4] == 101) { result := 17; }
    if ((*src)[off + 0] == 102 && (*src)[off + 1] == 97 && (*src)[off + 2] == 108 && (*src)[off + 3] == 115 && (*src)[off + 4] == 101) { result := 20; }
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 116 && (*src)[off + 3] == 49 && (*src)[off + 4] == 54) { result := 23; }
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 116 && (*src)[off + 3] == 51 && (*src)[off + 4] == 50) { result := 25; }
    if ((*src)[off + 0] == 105 && (*src)[off + 1] == 110 && (*src)[off + 2] == 116 && (*src)[off + 3] == 54 && (*src)[off + 4] == 52) { result := 26; }
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 105 && (*src)[off + 2] == 110 && (*src)[off + 3] == 116 && (*src)[off + 4] == 56) { result := 27; }
  }
  if (len == 6) {
    if ((*src)[off + 0] == 115 && (*src)[off + 1] == 116 && (*src)[off + 2] == 114 && (*src)[off + 3] == 117 && (*src)[off + 4] == 99 && (*src)[off + 5] == 116) { result := 11; }
    if ((*src)[off + 0] == 101 && (*src)[off + 1] == 120 && (*src)[off + 2] == 116 && (*src)[off + 3] == 101 && (*src)[off + 4] == 114 && (*src)[off + 5] == 110) { result := 12; }
    if ((*src)[off + 0] == 114 && (*src)[off + 1] == 101 && (*src)[off + 2] == 116 && (*src)[off + 3] == 117 && (*src)[off + 4] == 114 && (*src)[off + 5] == 110) { result := 18; }
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 105 && (*src)[off + 2] == 110 && (*src)[off + 3] == 116 && (*src)[off + 4] == 49 && (*src)[off + 5] == 54) { result := 28; }
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 105 && (*src)[off + 2] == 110 && (*src)[off + 3] == 116 && (*src)[off + 4] == 51 && (*src)[off + 5] == 50) { result := 30; }
    if ((*src)[off + 0] == 117 && (*src)[off + 1] == 105 && (*src)[off + 2] == 110 && (*src)[off + 3] == 116 && (*src)[off + 4] == 54 && (*src)[off + 5] == 52) { result := 31; }
  }
  if (len == 8) {
    if ((*src)[off + 0] == 102 && (*src)[off + 1] == 117 && (*src)[off + 2] == 110 && (*src)[off + 3] == 99 && (*src)[off + 4] == 116 && (*src)[off + 5] == 105 && (*src)[off + 6] == 111 && (*src)[off + 7] == 110) { result := 10; }
  }

  return result;
}

// ---------------------------------------------------------------------
// Number literal span scanning (chapter 4.3 / grammar's decimal_form,
// based_form) -- span only, no value computation: the dump format
// (chapter 9) prints raw source text for TOK_INT, never the computed
// value, so phase 1 doesn't need it (a future parser phase will).
// ---------------------------------------------------------------------

function scan_number(src: *(uint8[65536]), start: uint64, len: uint64) : NumberResult {
  mut cursor : uint64 := start;
  mut looping : bool := true;
  mut had_error : bool := false;
  mut error_at : uint64 := 0;
  mut n_pos : uint64 := 0;
  mut has_value_digit : bool := false;

  while (looping) {
    if (cursor >= len) {
      looping := false;
    } else {
      if (is_digit((*src)[cursor])) {
        cursor := cursor + 1;
      } else {
        looping := false;
      }
    }
  }

  if (cursor < len) {
    if ((*src)[cursor] == 110) {
      n_pos := cursor;
      cursor := cursor + 1;
      has_value_digit := false;
      looping := true;
      while (looping) {
        if (cursor >= len) {
          looping := false;
        } else {
          if (is_hex_digit((*src)[cursor])) {
            has_value_digit := true;
            cursor := cursor + 1;
          } else {
            looping := false;
          }
        }
      }
      if (!has_value_digit) {
        had_error := true;
        error_at := n_pos + 1;
      }
    }
  }

  return NumberResult { cursor := cursor, had_error := had_error, error_at := error_at };
}

// ---------------------------------------------------------------------
// lex_next -- one token, matching lexer.asm's own signature in spirit
// (chapter 5): takes a cursor, returns the token and the new cursor,
// as a value (v0 already permits struct returns, unlike the asm
// version's caller-allocated-struct convention -- no hidden state
// either way).
// ---------------------------------------------------------------------

function lex_next(src: *(uint8[65536]), start: uint64, len: uint64) : LexOutcome {
  mut trivia : TriviaResult := skip_trivia(src, start, len);
  mut cursor : uint64 := trivia.cursor;
  mut kind : int32 := 0;
  mut tok_offset : uint64 := cursor;
  mut tok_length : uint64 := 0;
  mut b : uint8 := 0;
  mut b2 : uint8 := 0;
  mut end_pos : uint64 := 0;
  mut num : NumberResult := NumberResult { cursor := 0, had_error := false, error_at := 0 };

  if (trivia.had_error) {
    kind := 253;
    tok_offset := trivia.comment_start;
    tok_length := 0;
  } else {
    if (cursor >= len) {
      kind := 0;
      tok_offset := len;
      tok_length := 0;
    } else {
      b := (*src)[cursor];

      if (is_alpha(b)) {
        end_pos := scan_ident_end(src, cursor, len);
        tok_offset := cursor;
        tok_length := end_pos - cursor;
        kind := classify_word(src, cursor, tok_length);
        cursor := end_pos;
      } else {
        if (is_digit(b)) {
          num := scan_number(src, cursor, len);
          if (num.had_error) {
            kind := 254;
            tok_offset := num.error_at;
            tok_length := 0;
            cursor := num.cursor;
          } else {
            tok_offset := cursor;
            tok_length := num.cursor - cursor;
            kind := 2;
            cursor := num.cursor;
          }
        } else {
          if (b == 58) {
            if (cursor + 1 < len && (*src)[cursor + 1] == 61) {
              kind := 60; tok_length := 2; cursor := cursor + 2;
            } else {
              kind := 40; tok_length := 1; cursor := cursor + 1;
            }
          } else {
            if (b == 61) {
              if (cursor + 1 < len && (*src)[cursor + 1] == 61) {
                kind := 61; tok_length := 2; cursor := cursor + 2;
              } else {
                kind := 254; tok_length := 1; cursor := cursor + 1;
              }
            } else {
              if (b == 33) {
                if (cursor + 1 < len && (*src)[cursor + 1] == 61) {
                  kind := 62; tok_length := 2; cursor := cursor + 2;
                } else {
                  kind := 69; tok_length := 1; cursor := cursor + 1;
                }
              } else {
                if (b == 60) {
                  if (cursor + 1 < len && (*src)[cursor + 1] == 61) {
                    kind := 63; tok_length := 2; cursor := cursor + 2;
                  } else {
                    if (cursor + 1 < len && (*src)[cursor + 1] == 60) {
                      kind := 65; tok_length := 2; cursor := cursor + 2;
                    } else {
                      kind := 76; tok_length := 1; cursor := cursor + 1;
                    }
                  }
                } else {
                  if (b == 62) {
                    if (cursor + 1 < len && (*src)[cursor + 1] == 61) {
                      kind := 64; tok_length := 2; cursor := cursor + 2;
                    } else {
                      if (cursor + 1 < len && (*src)[cursor + 1] == 62) {
                        kind := 66; tok_length := 2; cursor := cursor + 2;
                      } else {
                        kind := 77; tok_length := 1; cursor := cursor + 1;
                      }
                    }
                  } else {
                    if (b == 38) {
                      if (cursor + 1 < len && (*src)[cursor + 1] == 38) {
                        kind := 67; tok_length := 2; cursor := cursor + 2;
                      } else {
                        kind := 72; tok_length := 1; cursor := cursor + 1;
                      }
                    } else {
                      if (b == 124) {
                        if (cursor + 1 < len && (*src)[cursor + 1] == 124) {
                          kind := 68; tok_length := 2; cursor := cursor + 2;
                        } else {
                          kind := 79; tok_length := 1; cursor := cursor + 1;
                        }
                      } else {
                        if (b == 59) { kind := 41; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 44) { kind := 42; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 46) { kind := 43; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 40) { kind := 44; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 41) { kind := 45; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 123) { kind := 46; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 125) { kind := 47; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 91) { kind := 48; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 93) { kind := 49; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 45) { kind := 70; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 42) { kind := 71; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 47) { kind := 73; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 37) { kind := 74; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 43) { kind := 75; tok_length := 1; cursor := cursor + 1; }
                        else {
                        if (b == 94) { kind := 78; tok_length := 1; cursor := cursor + 1; }
                        else {
                          kind := 254; tok_length := 1; cursor := cursor + 1;
                        }}}}}}}}}}}}}}}
                      }
                    }
                  }
                }
              }
              tok_offset := cursor - tok_length;
            }
          }
        }
      }
    }
  }

  return LexOutcome { tok := Token { kind := kind, offset := tok_offset, length := tok_length, value := 0 }, cursor := cursor };
}

// ---------------------------------------------------------------------
// I/O and formatting helpers used only by main() below. Kept as small,
// separately testable functions rather than inlined, even though v0
// has no way to unit-test them in isolation yet -- once Stage 1 has a
// parser and checker, they read straightforwardly as ordinary v0 code.
// ---------------------------------------------------------------------

// Bridges an int64 syscall return value into the uint64 space this
// file otherwise stays in throughout (buffer positions, lengths) --
// v0 has no cast operator (deferred to a future version, see the v0
// language reference's own deferred-features list), so a value that's
// already known to be small and non-negative (checked by the caller)
// is moved across the int64/uint64 type boundary by unary counting
// instead. Bounded by the caller's own buffer size in every use here,
// so this never loops more than a few tens of thousands of times.
function int64_to_uint64(n: int64) : uint64 {
  mut result : uint64 := 0;
  mut steps : int64 := n;
  while (steps > 0) {
    result := result + 1;
    steps := steps - 1;
  }
  return result;
}

function digit_to_ascii(d: uint64) : uint8 {
  mut result : uint8 := 48;
  if (d == 1) { result := 49; }
  if (d == 2) { result := 50; }
  if (d == 3) { result := 51; }
  if (d == 4) { result := 52; }
  if (d == 5) { result := 53; }
  if (d == 6) { result := 54; }
  if (d == 7) { result := 55; }
  if (d == 8) { result := 56; }
  if (d == 9) { result := 57; }
  return result;
}

function nibble_to_hex(n: uint8) : uint8 {
  mut result : uint8 := 48;
  if (n == 1) { result := 49; }
  if (n == 2) { result := 50; }
  if (n == 3) { result := 51; }
  if (n == 4) { result := 52; }
  if (n == 5) { result := 53; }
  if (n == 6) { result := 54; }
  if (n == 7) { result := 55; }
  if (n == 8) { result := 56; }
  if (n == 9) { result := 57; }
  if (n == 10) { result := 97; }
  if (n == 11) { result := 98; }
  if (n == 12) { result := 99; }
  if (n == 13) { result := 100; }
  if (n == 14) { result := 101; }
  if (n == 15) { result := 102; }
  return result;
}

// Copies s_len bytes of a fixed, caller-supplied 80-byte label (see
// main()'s own const-ish label locals) into out at pos.
function append_str(out: *(uint8[131072]), pos: uint64, s: *(uint8[80]), s_len: uint64) : uint64 {
  mut i : uint64 := 0;
  mut new_pos : uint64 := pos;
  while (i < s_len) {
    (*out)[new_pos] := (*s)[i];
    new_pos := new_pos + 1;
    i := i + 1;
  }
  return new_pos;
}

// Copies a raw source slice (a token's own span) into out at pos.
function append_slice(out: *(uint8[131072]), pos: uint64, src: *(uint8[65536]), off: uint64, ln: uint64) : uint64 {
  mut i : uint64 := 0;
  mut new_pos : uint64 := pos;
  while (i < ln) {
    (*out)[new_pos] := (*src)[off + i];
    new_pos := new_pos + 1;
    i := i + 1;
  }
  return new_pos;
}

// Appends one raw byte.
function append_byte(out: *(uint8[131072]), pos: uint64, b: uint8) : uint64 {
  (*out)[pos] := b;
  return pos + 1;
}

// Appends value's decimal representation. Digits are produced
// least-significant-first into a small local scratch array, then
// copied out in reverse -- v0 has no string-building convenience
// beyond raw array indexing, so this is the direct way to do it.
function append_uint(out: *(uint8[131072]), pos: uint64, value: uint64) : uint64 {
  mut digits : uint8[24] := 0;
  mut count : uint64 := 0;
  mut v : uint64 := value;
  mut new_pos : uint64 := pos;
  mut d : uint64 := 0;
  mut i : uint64 := 0;

  if (v == 0) {
    digits[0] := 48;
    count := 1;
  } else {
    while (v > 0) {
      d := v % 10;
      digits[count] := digit_to_ascii(d);
      count := count + 1;
      v := v / 10;
    }
  }

  i := 0;
  while (i < count) {
    new_pos := append_byte(out, new_pos, digits[(count - 1) - i]);
    i := i + 1;
  }
  return new_pos;
}

// Appends the two-hex-digit form of a byte (e.g. 0x40 -> "40").
function append_hex_byte(out: *(uint8[131072]), pos: uint64, b: uint8) : uint64 {
  mut hi : uint8 := b / 16;
  mut lo : uint8 := b % 16;
  mut new_pos : uint64 := pos;
  new_pos := append_byte(out, new_pos, nibble_to_hex(hi));
  new_pos := append_byte(out, new_pos, nibble_to_hex(lo));
  return new_pos;
}

// 1-based line and column of a byte offset, by counting newlines from
// the start of the buffer -- deliberately not on lex_next's own hot
// path (mirrors lexer_spec.md chapter 7's own reasoning for Hoare's
// hand-written lexer): it runs once, only when a program is about to
// report an error and exit anyway.
function compute_line_col(src: *(uint8[65536]), src_len: uint64, target: uint64) : LineCol {
  mut i : uint64 := 0;
  mut line : uint64 := 1;
  mut last_line_start : uint64 := 0;
  mut limit : uint64 := target;
  mut col : uint64 := 0;

  if (limit > src_len) {
    limit := src_len;
  }
  while (i < limit) {
    if ((*src)[i] == 10) {
      line := line + 1;
      last_line_start := i + 1;
    }
    i := i + 1;
  }
  col := (target - last_line_start) + 1;

  return LineCol { line := line, col := col };
}

// Retries sys_write until `total` bytes are sent or an error occurs --
// POSIX write may send fewer bytes than requested even before any
// error, so a single call is never assumed to finish the job (same
// discipline lexer_spec.md chapter 8.3 documents for Hoare's own
// write_all). Two copies -- one per buffer size -- because a pointer
// parameter's array element count is part of its type (§2.5 of the v0
// reference); there is no way to write this generically over "any
// fixed-size uint8 array" in v0.
function write_all(fd: int64, buf: *(uint8[131072]), total: uint64) : bool {
  mut pos : uint64 := 0;
  mut n : int64 := 0;
  mut ok : bool := true;
  mut looping : bool := true;

  while (looping) {
    if (pos >= total) {
      looping := false;
    } else {
      n := sys_write(fd, &(*buf)[pos], total - pos);
      if (n < 0) {
        ok := false;
        looping := false;
      } else {
        pos := pos + int64_to_uint64(n);
      }
    }
  }
  return ok;
}

// Same shape as append_str/append_byte/append_uint/append_hex_byte
// above, retargeted at the 256-byte diagnostic buffer -- see
// write_all/write_all_small's own comment for why v0 needs two copies
// of each rather than one generic version.
function append_str_e(out: *(uint8[256]), pos: uint64, s: *(uint8[80]), s_len: uint64) : uint64 {
  mut i : uint64 := 0;
  mut new_pos : uint64 := pos;
  while (i < s_len) {
    (*out)[new_pos] := (*s)[i];
    new_pos := new_pos + 1;
    i := i + 1;
  }
  return new_pos;
}

function append_byte_e(out: *(uint8[256]), pos: uint64, b: uint8) : uint64 {
  (*out)[pos] := b;
  return pos + 1;
}

function append_uint_e(out: *(uint8[256]), pos: uint64, value: uint64) : uint64 {
  mut digits : uint8[24] := 0;
  mut count : uint64 := 0;
  mut v : uint64 := value;
  mut new_pos : uint64 := pos;
  mut d : uint64 := 0;
  mut i : uint64 := 0;

  if (v == 0) {
    digits[0] := 48;
    count := 1;
  } else {
    while (v > 0) {
      d := v % 10;
      digits[count] := digit_to_ascii(d);
      count := count + 1;
      v := v / 10;
    }
  }

  i := 0;
  while (i < count) {
    new_pos := append_byte_e(out, new_pos, digits[(count - 1) - i]);
    i := i + 1;
  }
  return new_pos;
}

function append_hex_byte_e(out: *(uint8[256]), pos: uint64, b: uint8) : uint64 {
  mut hi : uint8 := b / 16;
  mut lo : uint8 := b % 16;
  mut new_pos : uint64 := pos;
  new_pos := append_byte_e(out, new_pos, nibble_to_hex(hi));
  new_pos := append_byte_e(out, new_pos, nibble_to_hex(lo));
  return new_pos;
}

function write_all_small(fd: int64, buf: *(uint8[256]), total: uint64) : bool {
  mut pos : uint64 := 0;
  mut n : int64 := 0;
  mut ok : bool := true;
  mut looping : bool := true;

  while (looping) {
    if (pos >= total) {
      looping := false;
    } else {
      n := sys_write(fd, &(*buf)[pos], total - pos);
      if (n < 0) {
        ok := false;
        looping := false;
      } else {
        pos := pos + int64_to_uint64(n);
      }
    }
  }
  return ok;
}

