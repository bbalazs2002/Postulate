  mut rs : ResolveState := ResolveState { file_count := 1, dep_next := 0, path_pool_next := 7, source_pool_next := 0, order_count := 0, had_error := false, err_kind := 0, err_file := 0, err_off := 0 };
  mut fl : FileLine := FileLine { file := 0, line := 0, col := 0, byte_off := 0 };
  mut tok_kind : int32[8192] := 0;
