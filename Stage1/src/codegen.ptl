        gst := gen_program(gbufs, gst, prog.node);
        if (gst.had_error) {
          exit_code := 1;
          err_pos := append_str_e(&err_buf, err_pos, &err_codegen, 65);
          wrote_ok := write_all_e(2, &err_buf, err_pos);
        } else {
          wrote_ok := write_all(1, &out_buf, gst.out_pos);
          if (!wrote_ok) {
            exit_code := 2;
          }
        }
      }
    }
  }

  sys_exit(exit_code);
  return 0;
}
