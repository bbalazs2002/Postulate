struct Point {
  x: int32;
  y: int32;
}

function make_point(x: int32, y: int32) : Point {
  return Point { x := x, y := y };
}

function shift(p: Point) : Point {
  p.x := p.x + 100;
  return p;
}

function double_first(a: int32[3]) : int32[3] {
  a[0] := a[0] * 2;
  return a;
}

function main() : int32 {
  const p1 : Point := make_point(3, 4);
  const p2 : Point := shift(p1);
  const p3 : Point := shift(make_point(5, 6));
  mut arr : int32[3] := {1, 2, 3};
  mut arr2 : int32[3] := double_first(arr);

  return p1.x + p1.y + p2.x + p2.y + p3.x + p3.y + arr[0] + arr[1] + arr[2] + arr2[0] + arr2[1] + arr2[2];
}
