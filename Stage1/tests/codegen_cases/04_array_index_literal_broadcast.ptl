// Proves v1.0.3's array sub-pass: array-typed locals, array literals
// (including an array-of-struct literal, each element itself a
// nested struct literal), index read/write via GEP, array broadcast-
// init (a single scalar source filling every element), array-to-array
// copy independence, and a chained index+field lvalue (`pts[1].x`) --
// see docs/postulate_stage1_v1_0_3_composites_design.md.

struct Point {
  x: int32;
  y: int32;
}

function main() : int32 {
  mut a: int32[5] := {10, 20, 30, 40, 50};
  mut b: int32[5] := a;
  mut i: int32 := 0;
  mut sum: int32 := 0;
  mut pts: Point[3] := {
    Point { x := 1, y := 2 },
    Point { x := 3, y := 4 },
    Point { x := 5, y := 6 }
  };
  mut grid: int32[4] := 7;

  a[2] := 999;
  b[0] := 111;

  while (i < 5) {
    sum := sum + a[i] + b[i];
    i := i + 1;
  }

  pts[1].x := 100;

  // 10+20+999+40+50 (a) + 111+20+30+40+50 (b) = 1370, plus 146 from the
  // struct/broadcast half = 1516; the exit code is always truncated
  // mod 256 by the OS regardless (see 02_narrow_type_wraparound.ptl's
  // own note on this) -- checked by running it, not hand-computed.
  return sum + pts[0].x + pts[0].y + pts[1].x + pts[1].y + pts[2].x + pts[2].y
       + grid[0] + grid[1] + grid[2] + grid[3];
}
