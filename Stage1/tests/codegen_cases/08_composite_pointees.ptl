struct Point {
  x: int32;
  y: int32;
}

struct Node {
  value: int32;
  next: *Node;
}

function sum_list(n: *Node) : int32 {
  mut total : int32 := 0;
  mut cur : *Node := n;
  mut looping : bool := true;

  while (looping) {
    if (cur == null) {
      looping := false;
    } else {
      total := total + (*cur).value;
      cur := (*cur).next;
    }
  }
  return total;
}

function main() : int32 {
  mut pt : Point := Point { x := 1, y := 2 };
  mut pp : *Point := &pt;

  mut n3 : Node := Node { value := 3, next := null };
  mut n2 : Node := Node { value := 2, next := &n3 };
  mut n1 : Node := Node { value := 1, next := &n2 };
  mut list_sum : int32 := 0;

  mut a : int32 := 10;
  mut b : int32 := 20;
  mut c : int32 := 30;
  mut ptrs : *int32[3] := {&a, &b, &c};

  mut arr : int32[3] := {1, 2, 3};
  mut parr : *(int32[3]) := &arr;

  (*pp).x := 100;
  list_sum := sum_list(&n1);
  *ptrs[1] := 999;
  (*parr)[1] := 777;

  return (pt.x + pt.y) + list_sum + (a + b + c) + (arr[0] + arr[1] + arr[2]);
}
